.tab-wrap { position: fixed; left: 0; bottom: 0; right: 0; background: #FFFDF8; z-index: 99; border-top: 1rpx solid #E5E5EA; }
.tab-bar { height: 112rpx; display: flex; padding: 10rpx 20rpx 8rpx; }
.tab-item { flex: 1; display: flex; position: relative; flex-direction: column; align-items: center; justify-content: center; color: #7A8772; line-height: 1.6; border-radius: 16rpx; margin: 0 4rpx; }
.tab-item.active { background: transparent; }
.tab-label { font-size: calc(21rpx * var(--fs-scale, 1)); line-height: 1.6; color: #7A8772; }
.tab-item.active .tab-label { color: #234B3C; font-weight: 600; }
.tab-icon { height: 39rpx; width: 39rpx; margin-bottom: 5rpx; }
.tab-dot { display: none; position: absolute; top: 8rpx; right: calc(50% - 27rpx); height: 7rpx; width: 7rpx; background: #B96D50; border-radius: 50%; }
.safe-bottom { height: env(safe-area-inset-bottom); }
