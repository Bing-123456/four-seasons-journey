<cover-view class="tab-wrap"><cover-view class="tab-bar"><cover-view wx:for="{{tabs}}" wx:key="path" class="tab-item {{selected === index ? 'active' : ''}}" data-index="{{index}}" bindtap="switchTab"><cover-image class="tab-icon" src="/assets/{{item.icon}}{{selected === index ? '-active' : ''}}.png" /><cover-view class="tab-label">{{item.label}}</cover-view><cover-view wx:if="{{selected === index}}" class="tab-dot" /></cover-view></cover-view><cover-view class="safe-bottom" /></cover-view>
