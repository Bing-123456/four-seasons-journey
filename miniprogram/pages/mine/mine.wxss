.fav-place-row{display:flex;align-items:center;gap:16rpx;padding:12rpx 0;border-bottom: 1rpx dashed #E9EEE3;font-size: calc(23rpx * var(--fs-scale, 1));color: #47634B}
.fav-thumb{width:64rpx;height:64rpx;border-radius:10rpx;flex-shrink:0}
.fav-monogram{display:flex;align-items:center;justify-content:center;background: #EAF0E0;color: #47634B;font-size: calc(28rpx * var(--fs-scale, 1))}
.fav-place-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fav-place-name .muted{margin-left:10rpx;font-size: calc(19rpx * var(--fs-scale, 1))}
.fav-arrow{color: #87917B;flex-shrink:0}

.nickname-edit{display:flex;gap:12rpx;align-items:center;margin-top:12rpx}.nickname-input{flex:0 0 240rpx;height:56rpx;line-height:56rpx;background: #FFFDF8;border: 1rpx solid #DCE5D0;border-radius:10rpx;padding:0 16rpx;font-size: calc(21rpx * var(--fs-scale, 1));box-sizing:border-box}.nickname-save{margin:0;background: #234B3C;color: #FFFDF8;font-size: calc(21rpx * var(--fs-scale, 1));height:56rpx;line-height:56rpx;padding:0 24rpx;border-radius:10rpx;border:none}

/* 头像：用户相册照片，与打招呼小水果分开 */
.profile-avatar-wrap{position:relative;width:140rpx;height:140rpx;flex-shrink:0}
.profile-avatar-photo{display:block;width:140rpx;height:140rpx;box-sizing:border-box;border-radius:50%;border: 2rpx solid #FFFDF8;background: #F7F5ED}
.profile-avatar-edit{position:absolute;left:50%;bottom:-16rpx;transform:translateX(-50%);font-size: calc(19rpx * var(--fs-scale, 1));background: #234B3C;color: #FFF9DF;border-radius:999rpx;padding:5rpx 16rpx;white-space:nowrap}
/* 农场：用所选水果形象，左侧图画跟随选择变化 */
.farm-plant-view{position:absolute;left:44rpx;bottom:60rpx;width:132rpx;height:132rpx}
/* 浇水日历：浇水日深色，未浇水浅灰 */
.farm-calendar{margin-top:18rpx;background: #F7F5ED;border-radius:14rpx;padding:18rpx 20rpx}
.farm-calendar-title{font-size: calc(21rpx * var(--fs-scale, 1));color: #47634B;font-weight:600;margin-bottom:10rpx}
.farm-calendar-weeks{display:grid;grid-template-columns:repeat(7,1fr);font-size: calc(19rpx * var(--fs-scale, 1));color: #87917B;text-align:center;margin-bottom:6rpx}
.farm-calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6rpx}
.farm-calendar-cell{height:52rpx;line-height:52rpx;text-align:center;font-size: calc(21rpx * var(--fs-scale, 1));border-radius:10rpx;color: #87917B;background: #EAF0E0}
.farm-calendar-cell.is-out{opacity:.4}
.farm-calendar-cell.is-watered{background: #234B3C;color: #87917B;font-weight:600}
.farm-calendar-cell.is-today{border: 2rpx solid #47634B;box-sizing:border-box}
.farm-calendar-legend{display:flex;align-items:center;gap:8rpx;font-size: calc(19rpx * var(--fs-scale, 1));color: #87917B;margin-top:10rpx}
.legend-dot{display:inline-block;width:18rpx;height:18rpx;border-radius:6rpx;margin-left:14rpx}
.legend-watered{background: #234B3C;margin-left:0}
.legend-plain{background: #EAF0E0;border: 1rpx solid #DCE5D0}

/* Give the profile and seven-column farm calendar their own breathing room. */
.mine-page { padding-top: 30rpx; }
.profile-header { gap: 24rpx; margin: 12rpx 0 40rpx; align-items: flex-start; }
.profile-header > view:last-child { flex: 1; min-width: 0; }
.profile-header .page-title { font-size: calc(38rpx * var(--fs-scale, 1)); line-height: 1.5; }
.profile-avatar-wrap, .profile-avatar-photo { width: 112rpx; height: 112rpx; }
.profile-avatar-edit { font-size: calc(19rpx * var(--fs-scale, 1)); padding: 5rpx 14rpx; }
.nickname-edit { gap: 10rpx; margin-top: 16rpx; }
.nickname-input { flex: 1; min-width: 0; height: 64rpx; line-height: 64rpx; font-size: calc(23rpx * var(--fs-scale, 1)); }
.nickname-save { flex-shrink: 0; height: 64rpx; line-height: 64rpx; padding: 0 22rpx; font-size: calc(21rpx * var(--fs-scale, 1)); }
.farm-card { display: block; padding: 0; border-radius: 28rpx; overflow: hidden; margin: 24rpx 0 28rpx; }
.farm-scene { width: 100%; height: 188rpx; border-radius: 0; background: linear-gradient(180deg,#E9EEE3 0%,#EAF0E0 76%,#DCE5D0 76%,#DCE5D0 100%); }
.farm-ground { height: 20rpx; background: #DCE5D0; }
.farm-plant-view { left: calc(50% - 66rpx); bottom: 30rpx; }
.farm-can { right: calc(50% - 122rpx); bottom: 85rpx; }
.farm-stream { right: calc(50% - 92rpx); top: 30rpx; }
.farm-drop-1 { right: calc(50% - 60rpx); }
.farm-drop-2 { right: calc(50% - 75rpx); }
.farm-drop-3 { right: calc(50% - 46rpx); }
.farm-info { padding: 28rpx; }
.farm-head { gap: 16rpx; }
.farm-title { font-size: calc(32rpx * var(--fs-scale, 1)); font-weight: 600; }
.farm-stage-pill { flex-shrink: 0; font-size: calc(21rpx * var(--fs-scale, 1)); padding: 6rpx 14rpx; border-radius: 8rpx; }
.farm-meta { font-size: calc(23rpx * var(--fs-scale, 1)); color: #47634B; line-height: 1.75; }
.farm-next { font-size: calc(21rpx * var(--fs-scale, 1)); color: #47634B; }
.farm-calendar { margin-top: 22rpx; padding: 22rpx; border-radius: 18rpx; background: #F7F5ED; }
.farm-calendar-title { font-size: calc(23rpx * var(--fs-scale, 1)); margin-bottom: 18rpx; }
.farm-calendar-weeks { font-size: calc(21rpx * var(--fs-scale, 1)); color: #47634B; margin-bottom: 10rpx; }
.farm-calendar-grid { gap: 8rpx; }
.farm-calendar-cell { height: 58rpx; line-height: 58rpx; font-size: calc(23rpx * var(--fs-scale, 1)); color: #47634B; background: #E9EEE3; }
.farm-calendar-cell.is-today { line-height: 54rpx; }
.farm-calendar-legend { flex-wrap: wrap; font-size: calc(21rpx * var(--fs-scale, 1)); color: #47634B; gap: 8rpx; margin-top: 16rpx; }
.farm-button { font-size: calc(26rpx * var(--fs-scale, 1)); line-height: 1.5; padding: 22rpx 24rpx; border-radius: 18rpx; margin-top: 22rpx; }
.farm-crop { padding: 10rpx 20rpx; font-size: calc(23rpx * var(--fs-scale, 1)); }
.stats { background: #FFFDF8; border: 1rpx solid #E1E5D9; border-radius: 28rpx; padding: 24rpx 0; margin-bottom: 28rpx; }
.stats > view { flex: 1; font-size: calc(23rpx * var(--fs-scale, 1)); }
.stats > view + view { border-left: 1rpx solid #E1E5D9; }
.stats text { font-size: calc(48rpx * var(--fs-scale, 1)); }
.companion-card { padding: 22rpx; border-radius: 28rpx; background: #E9EEE3; }
.companion-label { font-size: calc(21rpx * var(--fs-scale, 1)); letter-spacing: 2rpx; color: #47634B; }
.companion-name { font-size: calc(32rpx * var(--fs-scale, 1)); margin: 6rpx 0; }
.local-identity { background: #FFFDF8; border: 1rpx solid #E1E5D9; border-radius: 28rpx; padding: 4rpx 28rpx 28rpx; }
.role-switch-row { gap: 12rpx; }
.role-chip { flex: 1; text-align: center; border-radius: 12rpx; padding: 14rpx; font-size: calc(23rpx * var(--fs-scale, 1)); }
.setting-row { gap: 20rpx; }
.setting-row > view { flex: 1; min-width: 0; }
.setting-row switch { flex-shrink: 0; }
.cloud-disclosure, .setting-hint { font-size: calc(21rpx * var(--fs-scale, 1)); color: #47634B; }
.api-input { background: #F7F5ED; border: 1rpx solid #E1E5D9; font-size: calc(23rpx * var(--fs-scale, 1)); }
.setting-buttons button { font-size: calc(23rpx * var(--fs-scale, 1)); }
.health-line { background: #EBEEE5; padding: 14rpx 18rpx; border-radius: 10rpx; font-size: calc(21rpx * var(--fs-scale, 1)); overflow-wrap: anywhere; }
.health-ok { background: #EAF0E0; }
.footer-note { color: #47634B; }
.hosted-service-button { width: auto; background: #E9EEE3; color: #47634B; font-size: calc(23rpx * var(--fs-scale, 1)); line-height: 1.5; padding: 16rpx 22rpx; border-radius: 12rpx; margin-top: 16rpx; text-align: left; }

/* tab bar 底部安全距离 */
.page { padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }

/* A small orchard scene frames the living, user-selected fruit. */
.mine-page { padding-top: 28rpx; }
.profile-header { align-items: center; margin: 12rpx 0 36rpx; gap: 24rpx; }
.profile-header .page-title { font-size: calc(38rpx * var(--fs-scale, 1)); margin-bottom: 10rpx; }
.profile-header .muted { line-height: 1.75; color: #47634B; }
.profile-avatar-photo { box-shadow: 0 4rpx 20rpx rgba(29,37,32,.06); }
.profile-avatar-edit { font-size: calc(19rpx * var(--fs-scale, 1)); border-radius: 10rpx; padding: 6rpx 15rpx; }
.farm-card { border-color: #DCE5D0; border-radius: 28rpx; }
.farm-scene { height: 250rpx; background: #F0ECDE; }
.farm-landscape { position: absolute; inset: 0; width: 100%; height: 100%; }
.farm-ground { height: 30rpx; background: linear-gradient(to top,rgba(209,199,162,.7),rgba(230,225,196,0)); }
.farm-plant-view { bottom: 32rpx; z-index: 1; }
.farm-can, .farm-stream, .farm-drop { z-index: 2; }
.farm-can { bottom: 90rpx; }
.farm-stream { top: 78rpx; }
.farm-calendar { background: #F7F5ED; }
.farm-calendar-cell { background: #E9EEE3; }
.farm-calendar-cell.is-watered { background: #47634B; }
.farm-button { width: 100%; }
.farm-button[disabled]:not([type]) { background: #E1E5D9; color: #47634B; opacity: 1; }
.demo-entry { border: 1rpx solid #DCE5D0; border-radius: 28rpx; background: #EAF0E0; }
.demo-entry button { flex-shrink: 0; border-radius: 12rpx; padding: 14rpx 18rpx; font-size: calc(23rpx * var(--fs-scale, 1)); }
.stats { border-color: #E1E5D9; padding: 28rpx 0; }
.companion-card { background: #F0ECDE; border-color: #DCE5D0; padding: 25rpx 20rpx; }
.companion-label { color: #826B4B; }
.companion-name { color: #47634B; }
.companion-copy .link { font-size: calc(23rpx * var(--fs-scale, 1)); text-decoration: none; margin-top: 15rpx; }
.local-identity { border-color: #E1E5D9; padding: 7rpx 28rpx 28rpx; }
.role-chip { font-size: calc(23rpx * var(--fs-scale, 1)); padding: 16rpx 12rpx; }
.footer-note { margin-top: 30rpx; font-size: calc(21rpx * var(--fs-scale, 1)); line-height: 1.85; }

.farm-plant-view{width:300rpx;height:280rpx;left:50%;margin-left:-150rpx;bottom:0;transform:none}.farm-source{margin-top:12rpx;color: #87917B;font-size: calc(21rpx * var(--fs-scale, 1));line-height:1.6}

/* 字体大小设置（评审 P05①）：提示行；三档 class 规则统一放在 app.wxss。 */
.font-scale-hint { margin-top: 10rpx; line-height: 1.6; }
.font-slider-row{margin-top:16rpx;padding:0 8rpx}
.font-slider-ticks{display:flex;justify-content:space-between;margin-top:-6rpx;color: #87917B;font-size: calc(21rpx * var(--fs-scale, 1))}

.farm-hint{margin-top:8rpx;font-size: calc(21rpx * var(--fs-scale, 1));color: #87917B;line-height:1.7}

/* 我的节气手账入口已于 2026-10-06 改版中移除（用户拍板删除），样式随之清理。 */

/* ===== 「我的」页 5 组分组改版（2026-10-06，用户拍板）=====
   现状 8 坨堆叠 → 5 组：我的果园 / 我的收获 / 我的伙伴 / 偏好设置（+ 底部演示条）
   配色：淡绿底 #F1F4E4 + 米白卡 #FDFDF8（仅本页，覆盖此前「暂不动配色」约定）。 */
.mine-page { background: #F5F5F7; }
.group { margin-bottom: 30rpx; }
.group-title {
  font-size: calc(23rpx * var(--fs-scale, 1));
  color: #47634B; font-weight: 700; letter-spacing: 2rpx;
  margin: 0 0 14rpx 6rpx;
}
/* 组内卡片统一米白 + 细边，替代原先糊成一片的灰白底 */
.group .farm-card,
.group .stats,
.group .companion-card,
.prefs-card {
  background: #FFFDF8; border: 1rpx solid #DCE5D0; border-radius: 28rpx;
}
.group .farm-card { border-color: #DCE5D0; }
.group .stats { border-color: #E1E5D9; }
/* 果灵卡改米白底（原先偏黄绿），保持与其它组一致 */
.group .companion-card { background: #FFFDF8; border-color: #DCE5D0; }
.companion-label { color: #87917B; }
.companion-name { color: #47634B; }

/* 偏好设置：把语言/身份/字号/云端AI 收进一张卡，行间用细线分隔 */
.prefs-card { padding: 6rpx 28rpx 20rpx; margin-bottom: 0; }
.pref-row { padding: 22rpx 0; }
.pref-row .field-label { margin-bottom: 12rpx; }
.pref-row-slider { padding-bottom: 8rpx; }
.pref-row .setting-row { padding: 0; }
.pref-row .cloud-disclosure { margin-top: 14rpx; }
.pref-divider { height: 1rpx; background: #E9EEE3; }

/* 浇水月历默认收起，点链接就地展开 */
.farm-calendar-toggle {
  margin-top: 18rpx; padding: 14rpx 0 2rpx;
  font-size: calc(23rpx * var(--fs-scale, 1)); color: #47634B;
  display: flex; align-items: center; gap: 8rpx;
}
.farm-calendar-caret { font-size: calc(21rpx * var(--fs-scale, 1)); color: #87917B; }

/* 演示条：贴在偏好设置之后、清除数据之前，不再独占半屏 */
.demo-panel { margin: 30rpx 0 24rpx; }
.demo-entry { margin-bottom: 24rpx; }
