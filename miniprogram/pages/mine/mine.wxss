/* ===== 我的小农场：打卡浇水 ===== */
.farm-card{display:flex;gap:18rpx;background: #FFFDF8;border: 1rpx solid #E1E5D9;border-radius: 28rpx;padding:20rpx;margin:24rpx 0}
.farm-scene{position:relative;width:230rpx;height:230rpx;background: linear-gradient(180deg,#EAF0E0 0%,#F0ECDE 68%,#F3E3C8 68%,#DCE5D0 100%);border-radius: 18rpx;overflow:hidden;flex-shrink:0}
.farm-ground{position:absolute;left:0;right:0;bottom:0;height:46rpx;background: #DCE5D0}
.farm-plant{position:absolute;left:50%;bottom:36rpx;width:0;transform-origin:50% 100%}
.farm-plant.is-shaking{animation:plantShake 1.6s ease}
.farm-stem{position:absolute;left:-3rpx;bottom:0;width:6rpx;background: #47634B;border-radius:3rpx;transition:height .6s ease}
.farm-stage-0 .farm-stem{height:26rpx}
.farm-stage-1 .farm-stem{height:44rpx}
.farm-stage-2 .farm-stem{height:64rpx}
.farm-stage-3 .farm-stem{height:84rpx}
.farm-stage-4 .farm-stem{height:100rpx}
.farm-stage-5 .farm-stem{height:112rpx}
.farm-leaf{position:absolute;width:30rpx;height:16rpx;background: #47634B;border-radius:0 100% 0 100%;transition:all .6s ease}
.farm-leaf-l{left:-32rpx}
.farm-leaf-r{right:-32rpx;transform:scaleX(-1)}
.farm-stage-0 .farm-leaf{opacity:0}
.farm-stage-1 .farm-leaf{top:-40rpx}
.farm-stage-2 .farm-leaf{top:-58rpx;width:38rpx}
.farm-stage-3 .farm-leaf{top:-74rpx;width:44rpx}
.farm-stage-4 .farm-leaf{top:-88rpx;width:50rpx}
.farm-stage-5 .farm-leaf{top:-96rpx;width:54rpx}
.farm-vine{position:absolute;left:-1rpx;bottom:60rpx;width:2rpx;height:52rpx;background: #47634B;transform:rotate(18deg)}
.farm-flower{position:absolute;left:-9rpx;top:-104rpx;width:18rpx;height:18rpx;background: #F3E3C8;border-radius:50%;box-shadow:0 0 0 5rpx #F3E3C8 inset}
.farm-fruit{position:absolute;left:-14rpx;top:-88rpx;width:26rpx;height:26rpx;background: #F3E3C8;border-radius:50%;box-shadow:20rpx 14rpx 0 -4rpx #B96D50}
.farm-gardener{position:absolute;left:16rpx;bottom:30rpx;transition:transform .5s ease;transform-origin:50% 100%}
.farm-gardener.is-watering{animation:gardenerSway 1.6s ease}
.farm-can{position:absolute;right:26rpx;bottom:96rpx;width:44rpx;height:30rpx;background: #47634B;border-radius:6rpx 6rpx 10rpx 10rpx;opacity:0;transform-origin:100% 100%;transition:opacity .3s}
.farm-can::after{content:'';position:absolute;right:-16rpx;top:8rpx;width:18rpx;height:6rpx;background: #47634B;border-radius:0 4rpx 4rpx 0}
.farm-can.is-tilting{opacity:1;animation:canTilt 1.6s ease}
.farm-stream{position:absolute;right:52rpx;top:60rpx;width:10rpx;height:110rpx;background: repeating-linear-gradient(180deg,#DCE5D0 0 10rpx,#DCE5D0 10rpx 20rpx);border-radius:0 0 8rpx 8rpx;transform:rotate(24deg);transform-origin:0 0;opacity:0;animation:streamFlow 1.6s linear}
.farm-drop{position:absolute;width:10rpx;height:14rpx;background: #DCE5D0;border-radius:50% 50% 60% 60%;opacity:0}
.farm-drop-1{right:78rpx;top:96rpx;animation:dropFall 1.5s ease-in .2s 2}
.farm-drop-2{right:64rpx;top:88rpx;animation:dropFall 1.5s ease-in .45s 2}
.farm-drop-3{right:92rpx;top:92rpx;animation:dropFall 1.5s ease-in .7s 2}
@keyframes canTilt{0%{transform:rotate(0)}18%{transform:rotate(-42deg)}82%{transform:rotate(-42deg)}100%{transform:rotate(0)}}
@keyframes streamFlow{0%,12%{opacity:0}20%{opacity:1}80%{opacity:1}90%,100%{opacity:0}}
@keyframes dropFall{0%{opacity:0;top:88rpx}15%{opacity:1}100%{opacity:0;top:196rpx}}
@keyframes plantShake{0%{transform:rotate(0)}25%{transform:rotate(-3deg)}50%{transform:rotate(3deg)}75%{transform:rotate(-2deg)}100%{transform:rotate(0)}}
@keyframes gardenerSway{0%{transform:rotate(0)}30%{transform:rotate(-4deg)}70%{transform:rotate(-4deg)}100%{transform:rotate(0)}}
.farm-info{flex:1;min-width:0;display:flex;flex-direction:column}
.farm-head{display:flex;align-items:center;justify-content:space-between}
.farm-title{font-size: calc(28rpx * var(--fs-scale, 1));color: #2E4A38}
.farm-stage-pill{font-size: calc(19rpx * var(--fs-scale, 1));background: #EAF0E0;color: #47634B;padding:5rpx 14rpx;border-radius:999rpx}
.farm-meta{font-size: calc(21rpx * var(--fs-scale, 1));color: #47634B;margin-top:8rpx;line-height:1.6}
.farm-done{color: #826B4B}
.farm-progress{height:10rpx;background: #EBEEE5;border-radius:999rpx;margin-top:12rpx;overflow:hidden}
.farm-progress-fill{height:100%;background: #47634B;border-radius:999rpx;transition:width .6s ease}
.farm-next{font-size: calc(19rpx * var(--fs-scale, 1));color: #87917B;margin-top:8rpx}
.farm-crops{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:12rpx}
.farm-crop{font-size: calc(21rpx * var(--fs-scale, 1));color: #47634B;background: #F7F5ED;border: 1rpx solid #DCE5D0;border-radius:999rpx;padding:8rpx 20rpx}
.farm-crop.chosen{background: #234B3C;color: #87917B;border-color: #234B3C}
.farm-button{margin-top:16rpx;background: #234B3C;color: #87917B;font-size: calc(23rpx * var(--fs-scale, 1));line-height:2.4;border-radius:14rpx;padding:0}
.farm-button.is-disabled{background: #DCE5D0;color: #87917B}
.farm-button-close{margin-top:24rpx}
.farm-overlay{position:fixed;inset:0;background:rgba(14,26,17,.62);z-index:120;display:flex;align-items:center;justify-content:center}
.farm-proverb-card{width:560rpx;box-sizing:border-box;background: #F0ECDE;border-radius: 28rpx;padding:44rpx 40rpx 36rpx;text-align:center;box-shadow: 0 4rpx 20rpx rgba(29,37,32,.06)}
.farm-proverb-kicker{font-size: calc(19rpx * var(--fs-scale, 1));color: #826B4B;letter-spacing:3rpx}
.farm-proverb-text{font-family:inherit;font-size: calc(38rpx * var(--fs-scale, 1));color: #826B4B;line-height:1.7;margin:26rpx 0 20rpx}
.farm-proverb-note{font-size: calc(21rpx * var(--fs-scale, 1));color: #826B4B;line-height:1.8;text-align:left}
.farm-proverb-growth{font-size: calc(21rpx * var(--fs-scale, 1));color: #826B4B;margin-top:22rpx;line-height:1.6}

.role-switch-row{display:flex;gap:14rpx}
.role-chip{font-size: calc(23rpx * var(--fs-scale, 1));color: #47634B;background: #F7F5ED;border: 1rpx solid #DCE5D0;border-radius:999rpx;padding:12rpx 28rpx}
.role-chip.chosen{background: #234B3C;color: #87917B;border-color: #234B3C}

.nickname-inline{display:flex;align-items:center;gap:12rpx;margin-top:12rpx}
.nickname-inline input{flex:1;min-width:0;height:64rpx;line-height:64rpx;background: #FFFDF8;border: 1rpx solid #DCE5D0;border-radius:12rpx;padding:0 18rpx;font-size: calc(23rpx * var(--fs-scale, 1));box-sizing:border-box}
.nickname-inline button{margin:0;background: #234B3C;color: #FFFDF8;height:64rpx;line-height:64rpx;padding:0 26rpx;font-size: calc(21rpx * var(--fs-scale, 1));border-radius:12rpx;border:none}
.role-switch-row{display:flex;gap:12rpx;margin-top:12rpx}
.role-chip{font-size: calc(21rpx * var(--fs-scale, 1));color: #47634B;background: #F7F5ED;border: 1rpx solid #DCE5D0;border-radius:999rpx;padding:10rpx 24rpx}
.role-chip.chosen{background: #234B3C;color: #87917B;border-color: #234B3C}
.fav-compact{background: #FFFDF8;border: 1rpx solid #E1E5D9;border-radius: 28rpx;padding:24rpx;margin:24rpx 0}
.fav-head{display:flex;justify-content:space-between;align-items:center}
.fav-head .section-title{margin:0;font-size: calc(28rpx * var(--fs-scale, 1))}
.fav-toggle{font-size: calc(21rpx * var(--fs-scale, 1));color: #47634B}
.kf-list{margin-top:14rpx}
.kf-row{display:flex;justify-content:space-between;align-items:center;padding:12rpx 0;border-bottom: 1rpx dashed #E9EEE3;font-size: calc(23rpx * var(--fs-scale, 1));color: #47634B}
.kf-remove{font-size: calc(21rpx * var(--fs-scale, 1));color: #B96D50}
