/* ===== 我的小农场：打卡浇水 ===== */
.farm-card{display:flex;gap:18rpx;background:#FFFDF8;border:1rpx solid #E0E5D5;border-radius:22rpx;padding:20rpx;margin:24rpx 0}
.farm-scene{position:relative;width:230rpx;height:230rpx;background:linear-gradient(180deg,#EAF2E0 0%,#F5EFDC 68%,#E4D9BC 68%,#DCCFA9 100%);border-radius:16rpx;overflow:hidden;flex-shrink:0}
.farm-ground{position:absolute;left:0;right:0;bottom:0;height:46rpx;background:#C9B88C}
.farm-plant{position:absolute;left:50%;bottom:36rpx;width:0;transform-origin:50% 100%}
.farm-plant.is-shaking{animation:plantShake 1.6s ease}
.farm-stem{position:absolute;left:-3rpx;bottom:0;width:6rpx;background:#5F7C48;border-radius:3rpx;transition:height .6s ease}
.farm-stage-0 .farm-stem{height:26rpx}
.farm-stage-1 .farm-stem{height:44rpx}
.farm-stage-2 .farm-stem{height:64rpx}
.farm-stage-3 .farm-stem{height:84rpx}
.farm-stage-4 .farm-stem{height:100rpx}
.farm-stage-5 .farm-stem{height:112rpx}
.farm-leaf{position:absolute;width:30rpx;height:16rpx;background:#6E8C55;border-radius:0 100% 0 100%;transition:all .6s ease}
.farm-leaf-l{left:-32rpx}
.farm-leaf-r{right:-32rpx;transform:scaleX(-1)}
.farm-stage-0 .farm-leaf{opacity:0}
.farm-stage-1 .farm-leaf{top:-40rpx}
.farm-stage-2 .farm-leaf{top:-58rpx;width:38rpx}
.farm-stage-3 .farm-leaf{top:-74rpx;width:44rpx}
.farm-stage-4 .farm-leaf{top:-88rpx;width:50rpx}
.farm-stage-5 .farm-leaf{top:-96rpx;width:54rpx}
.farm-vine{position:absolute;left:-1rpx;bottom:60rpx;width:2rpx;height:52rpx;background:#7A925C;transform:rotate(18deg)}
.farm-flower{position:absolute;left:-9rpx;top:-104rpx;width:18rpx;height:18rpx;background:#F2C94C;border-radius:50%;box-shadow:0 0 0 5rpx #F8E3A0 inset}
.farm-fruit{position:absolute;left:-14rpx;top:-88rpx;width:26rpx;height:26rpx;background:#D56652;border-radius:50%;box-shadow:20rpx 14rpx 0 -4rpx #D56652}
.farm-gardener{position:absolute;left:16rpx;bottom:30rpx;transition:transform .5s ease;transform-origin:50% 100%}
.farm-gardener.is-watering{animation:gardenerSway 1.6s ease}
.farm-can{position:absolute;right:26rpx;bottom:96rpx;width:44rpx;height:30rpx;background:#8FA982;border-radius:6rpx 6rpx 10rpx 10rpx;opacity:0;transform-origin:100% 100%;transition:opacity .3s}
.farm-can::after{content:'';position:absolute;right:-16rpx;top:8rpx;width:18rpx;height:6rpx;background:#8FA982;border-radius:0 4rpx 4rpx 0}
.farm-can.is-tilting{opacity:1;animation:canTilt 1.6s ease}
.farm-stream{position:absolute;right:52rpx;top:60rpx;width:10rpx;height:110rpx;background:repeating-linear-gradient(180deg,#9CC7E8 0 10rpx,#C4E0F2 10rpx 20rpx);border-radius:0 0 8rpx 8rpx;transform:rotate(24deg);transform-origin:0 0;opacity:0;animation:streamFlow 1.6s linear}
.farm-drop{position:absolute;width:10rpx;height:14rpx;background:#9CC7E8;border-radius:50% 50% 60% 60%;opacity:0}
.farm-drop-1{right:78rpx;top:96rpx;animation:dropFall 1.5s ease-in .2s 2}
.farm-drop-2{right:64rpx;top:88rpx;animation:dropFall 1.5s ease-in .45s 2}
.farm-drop-3{right:92rpx;top:92rpx;animation:dropFall 1.5s ease-in .7s 2}
@keyframes canTilt{0%{transform:rotate(0)}18%{transform:rotate(-42deg)}82%{transform:rotate(-42deg)}100%{transform:rotate(0)}}
@keyframes streamFlow{0%,12%{opacity:0}20%{opacity:1}80%{opacity:1}90%,100%{opacity:0}}
@keyframes dropFall{0%{opacity:0;top:88rpx}15%{opacity:1}100%{opacity:0;top:196rpx}}
@keyframes plantShake{0%{transform:rotate(0)}25%{transform:rotate(-3deg)}50%{transform:rotate(3deg)}75%{transform:rotate(-2deg)}100%{transform:rotate(0)}}
@keyframes gardenerSway{0%{transform:rotate(0)}30%{transform:rotate(-4deg)}70%{transform:rotate(-4deg)}100%{transform:rotate(0)}}
.farm-info{flex:1;min-width:0;display:flex;flex-direction:column}
.farm-head{display:flex;align-items:center;justify-content:space-between}
.farm-title{font-size:calc(29rpx * var(--fs-scale, 1));color:#2E4A38}
.farm-stage-pill{font-size:calc(19rpx * var(--fs-scale, 1));background:#EAF2E0;color:#4E6B3F;padding:5rpx 14rpx;border-radius:999rpx}
.farm-meta{font-size:calc(21rpx * var(--fs-scale, 1));color:#798479;margin-top:8rpx;line-height:1.6}
.farm-done{color:#8a6d3b}
.farm-progress{height:10rpx;background:#EDEEE4;border-radius:999rpx;margin-top:12rpx;overflow:hidden}
.farm-progress-fill{height:100%;background:#6E8C55;border-radius:999rpx;transition:width .6s ease}
.farm-next{font-size:calc(19rpx * var(--fs-scale, 1));color:#98a587;margin-top:8rpx}
.farm-crops{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:12rpx}
.farm-crop{font-size:calc(21rpx * var(--fs-scale, 1));color:#5c6a52;background:#F2F4E9;border:1rpx solid #DDE2D3;border-radius:999rpx;padding:8rpx 20rpx}
.farm-crop.chosen{background:#234B3C;color:#F5F3E6;border-color:#234B3C}
.farm-button{margin-top:16rpx;background:#234B3C;color:#F5F3E6;font-size:calc(24rpx * var(--fs-scale, 1));line-height:2.4;border-radius:14rpx;padding:0}
.farm-button.is-disabled{background:#B9C2AC;color:#F0F2E8}
.farm-button-close{margin-top:24rpx}
.farm-overlay{position:fixed;inset:0;background:rgba(14,26,17,.62);z-index:120;display:flex;align-items:center;justify-content:center}
.farm-proverb-card{width:560rpx;box-sizing:border-box;background:#F7EDC9;border-radius:26rpx;padding:44rpx 40rpx 36rpx;text-align:center;box-shadow:0 18rpx 60rpx rgba(0,0,0,.35)}
.farm-proverb-kicker{font-size:calc(19rpx * var(--fs-scale, 1));color:#8a6d3b;letter-spacing:3rpx}
.farm-proverb-text{font-family:inherit;font-size:calc(38rpx * var(--fs-scale, 1));color:#3A3423;line-height:1.7;margin:26rpx 0 20rpx}
.farm-proverb-note{font-size:calc(22rpx * var(--fs-scale, 1));color:#6d6344;line-height:1.8;text-align:left}
.farm-proverb-growth{font-size:calc(20rpx * var(--fs-scale, 1));color:#987f3c;margin-top:22rpx;line-height:1.6}

.role-switch-row{display:flex;gap:14rpx}
.role-chip{font-size:calc(23rpx * var(--fs-scale, 1));color:#5c6a52;background:#F2F4E9;border:1rpx solid #DDE2D3;border-radius:999rpx;padding:12rpx 28rpx}
.role-chip.chosen{background:#234B3C;color:#F5F3E6;border-color:#234B3C}

.nickname-inline{display:flex;align-items:center;gap:12rpx;margin-top:12rpx}
.nickname-inline input{flex:1;min-width:0;height:64rpx;line-height:64rpx;background:#FFFDF8;border:1rpx solid #DDE2D3;border-radius:12rpx;padding:0 18rpx;font-size:calc(24rpx * var(--fs-scale, 1));box-sizing:border-box}
.nickname-inline button{margin:0;background:#234B3C;color:#FFFDF8;height:64rpx;line-height:64rpx;padding:0 26rpx;font-size:calc(22rpx * var(--fs-scale, 1));border-radius:12rpx;border:none}
.role-switch-row{display:flex;gap:12rpx;margin-top:12rpx}
.role-chip{font-size:calc(22rpx * var(--fs-scale, 1));color:#5c6a52;background:#F2F4E9;border:1rpx solid #DDE2D3;border-radius:999rpx;padding:10rpx 24rpx}
.role-chip.chosen{background:#234B3C;color:#F5F3E6;border-color:#234B3C}
.fav-compact{background:#FFFDF8;border:1rpx solid #E0E5D5;border-radius:22rpx;padding:24rpx;margin:24rpx 0}
.fav-head{display:flex;justify-content:space-between;align-items:center}
.fav-head .section-title{margin:0;font-size:calc(30rpx * var(--fs-scale, 1))}
.fav-toggle{font-size:calc(21rpx * var(--fs-scale, 1));color:#63795d}
.kf-list{margin-top:14rpx}
.kf-row{display:flex;justify-content:space-between;align-items:center;padding:12rpx 0;border-bottom:1rpx dashed #E7E9DE;font-size:calc(23rpx * var(--fs-scale, 1));color:#4a5c44}
.kf-remove{font-size:calc(20rpx * var(--fs-scale, 1));color:#ab4f3d}
.fav-place-row{padding:12rpx 0;font-size:calc(23rpx * var(--fs-scale, 1));color:#4a5c44;border-bottom:1rpx dashed #E7E9DE}

.fav-place-row{display:flex;align-items:center;gap:16rpx;padding:12rpx 0;border-bottom:1rpx dashed #E7E9DE;font-size:calc(23rpx * var(--fs-scale, 1));color:#4a5c44}
.fav-thumb{width:64rpx;height:64rpx;border-radius:10rpx;flex-shrink:0}
.fav-monogram{display:flex;align-items:center;justify-content:center;background:#EAF2E0;color:#658066;font-size:calc(30rpx * var(--fs-scale, 1))}
.fav-place-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fav-place-name .muted{margin-left:10rpx;font-size:calc(19rpx * var(--fs-scale, 1))}
.fav-arrow{color:#98a587;flex-shrink:0}

.nickname-edit{display:flex;gap:12rpx;align-items:center;margin-top:12rpx}.nickname-input{flex:0 0 240rpx;height:56rpx;line-height:56rpx;background:#FFFDF8;border:1rpx solid #DDE2D3;border-radius:10rpx;padding:0 16rpx;font-size:calc(22rpx * var(--fs-scale, 1));box-sizing:border-box}.nickname-save{margin:0;background:#234B3C;color:#FFFDF8;font-size:calc(22rpx * var(--fs-scale, 1));height:56rpx;line-height:56rpx;padding:0 24rpx;border-radius:10rpx;border:none}

/* 头像：用户相册照片，与打招呼小水果分开 */
.profile-avatar-wrap{position:relative;width:140rpx;height:140rpx;flex-shrink:0}
.profile-avatar-photo{display:block;width:140rpx;height:140rpx;box-sizing:border-box;border-radius:50%;border:2rpx solid #FFFDF8;background:#F4F0E7}
.profile-avatar-edit{position:absolute;left:50%;bottom:-16rpx;transform:translateX(-50%);font-size:calc(17rpx * var(--fs-scale, 1));background:#234B3C;color:#FFF9DF;border-radius:999rpx;padding:5rpx 16rpx;white-space:nowrap}
/* 农场：用所选水果形象，左侧图画跟随选择变化 */
.farm-plant-view{position:absolute;left:44rpx;bottom:60rpx;width:132rpx;height:132rpx}
/* 浇水日历：浇水日深色，未浇水浅灰 */
.farm-calendar{margin-top:18rpx;background:#F4F6EC;border-radius:14rpx;padding:18rpx 20rpx}
.farm-calendar-title{font-size:calc(22rpx * var(--fs-scale, 1));color:#4A5D42;font-weight:600;margin-bottom:10rpx}
.farm-calendar-weeks{display:grid;grid-template-columns:repeat(7,1fr);font-size:calc(18rpx * var(--fs-scale, 1));color:#98a587;text-align:center;margin-bottom:6rpx}
.farm-calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6rpx}
.farm-calendar-cell{height:52rpx;line-height:52rpx;text-align:center;font-size:calc(20rpx * var(--fs-scale, 1));border-radius:10rpx;color:#9aa294;background:#EDF0E2}
.farm-calendar-cell.is-out{opacity:.4}
.farm-calendar-cell.is-watered{background:#234B3C;color:#F5F3E6;font-weight:600}
.farm-calendar-cell.is-today{border:2rpx solid #8FAB7D;box-sizing:border-box}
.farm-calendar-legend{display:flex;align-items:center;gap:8rpx;font-size:calc(18rpx * var(--fs-scale, 1));color:#8b9484;margin-top:10rpx}
.legend-dot{display:inline-block;width:18rpx;height:18rpx;border-radius:6rpx;margin-left:14rpx}
.legend-watered{background:#234B3C;margin-left:0}
.legend-plain{background:#EDF0E2;border:1rpx solid #CBD2C2}

/* Give the profile and seven-column farm calendar their own breathing room. */
.mine-page { padding-top: 30rpx; }
.profile-header { gap: 24rpx; margin: 12rpx 0 40rpx; align-items: flex-start; }
.profile-header > view:last-child { flex: 1; min-width: 0; }
.profile-header .page-title { font-size: calc(36rpx * var(--fs-scale, 1)); line-height: 1.5; }
.profile-avatar-wrap, .profile-avatar-photo { width: 112rpx; height: 112rpx; }
.profile-avatar-edit { font-size: calc(18rpx * var(--fs-scale, 1)); padding: 5rpx 14rpx; }
.nickname-edit { gap: 10rpx; margin-top: 16rpx; }
.nickname-input { flex: 1; min-width: 0; height: 64rpx; line-height: 64rpx; font-size: calc(23rpx * var(--fs-scale, 1)); }
.nickname-save { flex-shrink: 0; height: 64rpx; line-height: 64rpx; padding: 0 22rpx; font-size: calc(22rpx * var(--fs-scale, 1)); }
.farm-card { display: block; padding: 0; border-radius: 26rpx; overflow: hidden; margin: 24rpx 0 28rpx; }
.farm-scene { width: 100%; height: 188rpx; border-radius: 0; background: linear-gradient(180deg,#E4EBDA 0%,#EDF0DD 76%,#DCCFA9 76%,#DCCFA9 100%); }
.farm-ground { height: 20rpx; background: #C8B78F; }
.farm-plant-view { left: calc(50% - 66rpx); bottom: 30rpx; }
.farm-can { right: calc(50% - 122rpx); bottom: 85rpx; }
.farm-stream { right: calc(50% - 92rpx); top: 30rpx; }
.farm-drop-1 { right: calc(50% - 60rpx); }
.farm-drop-2 { right: calc(50% - 75rpx); }
.farm-drop-3 { right: calc(50% - 46rpx); }
.farm-info { padding: 28rpx; }
.farm-head { gap: 16rpx; }
.farm-title { font-size: calc(32rpx * var(--fs-scale, 1)); font-weight: 600; }
.farm-stage-pill { flex-shrink: 0; font-size: calc(20rpx * var(--fs-scale, 1)); padding: 6rpx 14rpx; border-radius: 8rpx; }
.farm-meta { font-size: calc(23rpx * var(--fs-scale, 1)); color: #6B7964; line-height: 1.75; }
.farm-next { font-size: calc(21rpx * var(--fs-scale, 1)); color: #75816A; }
.farm-calendar { margin-top: 22rpx; padding: 22rpx; border-radius: 18rpx; background: #F1F3E9; }
.farm-calendar-title { font-size: calc(24rpx * var(--fs-scale, 1)); margin-bottom: 18rpx; }
.farm-calendar-weeks { font-size: calc(21rpx * var(--fs-scale, 1)); color: #718064; margin-bottom: 10rpx; }
.farm-calendar-grid { gap: 8rpx; }
.farm-calendar-cell { height: 58rpx; line-height: 58rpx; font-size: calc(23rpx * var(--fs-scale, 1)); color: #718064; background: #E8ECDF; }
.farm-calendar-cell.is-today { line-height: 54rpx; }
.farm-calendar-legend { flex-wrap: wrap; font-size: calc(20rpx * var(--fs-scale, 1)); color: #718064; gap: 8rpx; margin-top: 16rpx; }
.farm-button { font-size: calc(26rpx * var(--fs-scale, 1)); line-height: 1.5; padding: 22rpx 24rpx; border-radius: 16rpx; margin-top: 22rpx; }
.farm-crop { padding: 10rpx 20rpx; font-size: calc(23rpx * var(--fs-scale, 1)); }
.stats { background: #FFFDF8; border: 1rpx solid #E0E5D9; border-radius: 22rpx; padding: 24rpx 0; margin-bottom: 28rpx; }
.stats > view { flex: 1; font-size: calc(23rpx * var(--fs-scale, 1)); }
.stats > view + view { border-left: 1rpx solid #E3E7DB; }
.stats text { font-size: calc(46rpx * var(--fs-scale, 1)); }
.companion-card { padding: 22rpx; border-radius: 24rpx; background: #E8EDDD; }
.companion-label { font-size: calc(20rpx * var(--fs-scale, 1)); letter-spacing: 2rpx; color: #728264; }
.companion-name { font-size: calc(34rpx * var(--fs-scale, 1)); margin: 6rpx 0; }
.local-identity { background: #FFFDF8; border: 1rpx solid #E0E5D9; border-radius: 24rpx; padding: 4rpx 28rpx 28rpx; }
.role-switch-row { gap: 12rpx; }
.role-chip { flex: 1; text-align: center; border-radius: 12rpx; padding: 14rpx; font-size: calc(24rpx * var(--fs-scale, 1)); }
.setting-row { gap: 20rpx; }
.setting-row > view { flex: 1; min-width: 0; }
.setting-row switch { flex-shrink: 0; }
.cloud-disclosure, .setting-hint { font-size: calc(22rpx * var(--fs-scale, 1)); color: #6F7D64; }
.api-input { background: #F2F4EB; border: 1rpx solid #DFE5D6; font-size: calc(24rpx * var(--fs-scale, 1)); }
.setting-buttons button { font-size: calc(24rpx * var(--fs-scale, 1)); }
.health-line { background: #F2F0E6; padding: 14rpx 18rpx; border-radius: 10rpx; font-size: calc(22rpx * var(--fs-scale, 1)); overflow-wrap: anywhere; }
.health-ok { background: #EAF0E3; }
.footer-note { color: #7E8977; }
.hosted-service-button { width: auto; background: #E9EEE3; color: #345B43; font-size: calc(23rpx * var(--fs-scale, 1)); line-height: 1.5; padding: 16rpx 22rpx; border-radius: 12rpx; margin-top: 16rpx; text-align: left; }

/* tab bar 底部安全距离 */
.page { padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }

/* A small orchard scene frames the living, user-selected fruit. */
.mine-page { padding-top: 28rpx; }
.profile-header { align-items: center; margin: 12rpx 0 36rpx; gap: 24rpx; }
.profile-header .page-title { font-size: calc(36rpx * var(--fs-scale, 1)); margin-bottom: 10rpx; }
.profile-header .muted { line-height: 1.75; color: #77836D; }
.profile-avatar-photo { box-shadow: 0 3rpx 12rpx rgba(58,55,44,.05); }
.profile-avatar-edit { font-size: calc(19rpx * var(--fs-scale, 1)); border-radius: 10rpx; padding: 6rpx 15rpx; }
.farm-card { border-color: #DCDCC8; border-radius: 26rpx; }
.farm-scene { height: 250rpx; background: #EDECD8; }
.farm-landscape { position: absolute; inset: 0; width: 100%; height: 100%; }
.farm-ground { height: 30rpx; background: linear-gradient(to top,rgba(209,199,162,.7),rgba(230,225,196,0)); }
.farm-plant-view { bottom: 32rpx; z-index: 1; }
.farm-can, .farm-stream, .farm-drop { z-index: 2; }
.farm-can { bottom: 90rpx; }
.farm-stream { top: 78rpx; }
.farm-calendar { background: #F2F3E9; }
.farm-calendar-cell { background: #E8ECDF; }
.farm-calendar-cell.is-watered { background: #355A42; }
.farm-button { width: 100%; }
.farm-button[disabled]:not([type]) { background: #E4E9DA; color: #68775C; opacity: 1; }
.demo-entry { border: 1rpx solid #DDE3D0; border-radius: 20rpx; background: #EDF0E3; }
.demo-entry button { flex-shrink: 0; border-radius: 12rpx; padding: 14rpx 18rpx; font-size: calc(23rpx * var(--fs-scale, 1)); }
.stats { border-color: #E1E3D4; padding: 28rpx 0; }
.companion-card { background: #F0EBD9; border-color: #DFD7BE; padding: 25rpx 20rpx; }
.companion-label { color: #96805B; }
.companion-name { color: #40593E; }
.companion-copy .link { font-size: calc(24rpx * var(--fs-scale, 1)); text-decoration: none; margin-top: 15rpx; }
.local-identity { border-color: #E1E3D4; padding: 7rpx 28rpx 28rpx; }
.role-chip { font-size: calc(24rpx * var(--fs-scale, 1)); padding: 16rpx 12rpx; }
.footer-note { margin-top: 30rpx; font-size: calc(21rpx * var(--fs-scale, 1)); line-height: 1.85; }

.farm-plant-view{width:300rpx;height:280rpx;left:50%;margin-left:-150rpx;bottom:0;transform:none}.farm-source{margin-top:12rpx;color:#86868B;font-size:calc(21rpx * var(--fs-scale, 1));line-height:1.6}

/* 字体大小设置（评审 P05①）：提示行；三档 class 规则统一放在 app.wxss。 */
.font-scale-hint { margin-top: 10rpx; line-height: 1.6; }
.font-slider-row{margin-top:16rpx;padding:0 8rpx}
.font-slider-ticks{display:flex;justify-content:space-between;margin-top:-6rpx;color:#8E978B;font-size:calc(21rpx * var(--fs-scale, 1))}

.farm-hint{margin-top:8rpx;font-size:calc(20rpx * var(--fs-scale, 1));color:#9AA28F;line-height:1.7}

/* 我的节气手账入口已于 2026-10-06 改版中移除（用户拍板删除），样式随之清理。 */

/* ===== 「我的」页 5 组分组改版（2026-10-06，用户拍板）=====
   现状 8 坨堆叠 → 5 组：我的果园 / 我的收获 / 我的伙伴 / 偏好设置（+ 底部演示条）
   配色：淡绿底 #F1F4E4 + 米白卡 #FDFDF8（仅本页，覆盖此前「暂不动配色」约定）。 */
.mine-page { background: #F1F4E4; }
.group { margin-bottom: 30rpx; }
.group-title {
  font-size: calc(23rpx * var(--fs-scale, 1));
  color: #7C8870; font-weight: 700; letter-spacing: 2rpx;
  margin: 0 0 14rpx 6rpx;
}
/* 组内卡片统一米白 + 细边，替代原先糊成一片的灰白底 */
.group .farm-card,
.group .stats,
.group .companion-card,
.prefs-card {
  background: #FDFDF8; border: 1rpx solid #DFE4D0; border-radius: 24rpx;
}
.group .farm-card { border-color: #DCDCC8; }
.group .stats { border-color: #E1E3D4; }
/* 果灵卡改米白底（原先偏黄绿），保持与其它组一致 */
.group .companion-card { background: #FDFDF8; border-color: #DFE4D0; }
.companion-label { color: #8A9276; }
.companion-name { color: #40593E; }

/* 偏好设置：把语言/身份/字号/云端AI 收进一张卡，行间用细线分隔 */
.prefs-card { padding: 6rpx 28rpx 20rpx; margin-bottom: 0; }
.pref-row { padding: 22rpx 0; }
.pref-row .field-label { margin-bottom: 12rpx; }
.pref-row-slider { padding-bottom: 8rpx; }
.pref-row .setting-row { padding: 0; }
.pref-row .cloud-disclosure { margin-top: 14rpx; }
.pref-divider { height: 1rpx; background: #E7EADC; }

/* 浇水月历默认收起，点链接就地展开 */
.farm-calendar-toggle {
  margin-top: 18rpx; padding: 14rpx 0 2rpx;
  font-size: calc(23rpx * var(--fs-scale, 1)); color: #63795D;
  display: flex; align-items: center; gap: 8rpx;
}
.farm-calendar-caret { font-size: calc(20rpx * var(--fs-scale, 1)); color: #8FA982; }

/* 演示条：贴在偏好设置之后、清除数据之前，不再独占半屏 */
.demo-panel { margin: 30rpx 0 24rpx; }
.demo-entry { margin-bottom: 24rpx; }
