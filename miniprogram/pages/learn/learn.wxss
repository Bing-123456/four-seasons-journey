page { background: #F5F5F7; }
.learn-shell { height: 100vh; min-height: 1160rpx; display: flex; flex-direction: column; padding-bottom: calc(146rpx + env(safe-area-inset-bottom)); }
.learn-page { flex: 1; min-height: 0; display: flex; flex-direction: column; padding: 22rpx 32rpx 12rpx; }
.learn-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; flex-shrink: 0; margin-bottom: 16rpx; }
.learn-head-copy { flex: 1; min-width: 0; }
.learn-title { font-size: 42rpx; font-weight: 700; line-height: 1.25; letter-spacing: -1rpx; color: #1D2520; }
.learn-choices { display: flex; flex-direction: column; flex: 1; min-height: 0; gap: 16rpx; }
/* 插图约 1.9:1，与卡片比例匹配；整卡铺图，文字直接叠在图上。 */
.game-entry { position: relative; overflow: hidden; border-radius: 26rpx; background: #EDE6D3; box-shadow: 0 5rpx 20rpx rgba(29,37,32,.035); flex: 1 1 0; min-height: 364rpx; }
.featured-art { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
.featured-shade { position: absolute; inset: 0; background: linear-gradient(180deg,transparent 40%,rgba(19,38,26,.08) 56%,rgba(19,38,26,.66)); }
.featured-copy { position: absolute; left: 24rpx; right: 88rpx; bottom: 20rpx; color: #FFFFFF; }
.featured-title { font-size: 36rpx; font-weight: 700; line-height: 1.28; letter-spacing: -.5rpx; }
.featured-subtitle { margin-top: 8rpx; font-size: 22rpx; line-height: 1.5; color: rgba(255,255,255,.88); }
.entry-arrow { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; border-radius: 50%; font-size: 29rpx; line-height: 1; }
.featured-arrow { position: absolute; bottom: 24rpx; right: 24rpx; background: rgba(255,255,255,.9); color: #284C37; }
@media (max-height: 610px) {
  .learn-page { padding-top: 12rpx; }
  .learn-head { margin-bottom: 16rpx; }
  .learn-title { font-size: 36rpx; }
  .learn-choices { gap: 16rpx; }
  .featured-copy { bottom: 16rpx; }
  .featured-title { font-size: 32rpx; }
  .featured-subtitle { font-size: 20rpx; }
}
