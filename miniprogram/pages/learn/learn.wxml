<view class="learn-shell {{fontClass}}">
  <demo-notice id="demo-mode-notice"/>
  <view class="learn-page">
    <view class="learn-head">
      <view class="learn-head-copy"><view class="learn-title">{{copy.title}}</view></view>
      <me-entry/>
    </view>
    <view class="learn-choices">
      <view id="game-quiz" class="game-entry" data-game="quiz" bindtap="openGame" role="button" aria-label="{{L.game_quiz}}">
        <image wx:if="{{gameArt.quiz && !gameArtError.quiz}}" class="featured-art" src="{{gameArt.quiz}}" mode="aspectFill" binderror="onGameArtError" data-game="quiz"/>
        <view class="featured-shade"></view>
        <view class="featured-copy"><view class="featured-title">{{copy.quiz}}</view></view>
        <view class="entry-arrow featured-arrow" aria-hidden="true">↗</view>
      </view>
      <view id="game-challenge" class="game-entry" data-game="challenge" bindtap="openGame" role="button" aria-label="{{L.game_challenge}}">
        <image wx:if="{{gameArt.challenge && !gameArtError.challenge}}" class="featured-art" src="{{gameArt.challenge}}" mode="aspectFill" binderror="onGameArtError" data-game="challenge"/>
        <view class="featured-shade"></view>
        <view class="featured-copy"><view class="featured-title">{{copy.challenge}}</view></view>
        <view class="entry-arrow featured-arrow" aria-hidden="true">↗</view>
      </view>
      <view id="game-match" class="game-entry" data-game="match" bindtap="openGame" role="button" aria-label="{{L.game_match}}">
        <image wx:if="{{gameArt.match && !gameArtError.match}}" class="featured-art" src="{{gameArt.match}}" mode="aspectFill" binderror="onGameArtError" data-game="match"/>
        <view class="featured-shade"></view>
        <view class="featured-copy"><view class="featured-title">{{copy.match}}</view></view>
        <view class="entry-arrow featured-arrow" aria-hidden="true">↗</view>
      </view>
    </view>
  </view>
</view>
