page{height:100%;overflow:hidden;background:#F5F5F7}
.calendar-screen{height:100vh;box-sizing:border-box;display:flex;flex-direction:column;overflow:hidden;padding-bottom:calc(130rpx + env(safe-area-inset-bottom));background:#F5F5F7}
.calendar-content{flex:1;min-height:0;display:flex;flex-direction:column;padding:24rpx 32rpx 0;gap:20rpx}
.calendar-heading{display:flex;align-items:center;justify-content:space-between;gap:18rpx;flex-shrink:0}
.calendar-heading>view{flex:1;min-width:0}
.screen-title{font-size:calc(48rpx * var(--fs-scale, 1));font-weight:700;line-height:1.25;letter-spacing:-1rpx;color:#1D1D1F}
.screen-subtitle{font-size:calc(22rpx * var(--fs-scale, 1));color:#7A847C;line-height:1.5;margin-top:8rpx}
.calendar-tabs{display:flex;flex-shrink:0;gap:5rpx;border-radius:16rpx;padding:5rpx;background:#E7E9E7}
.calendar-tab{flex:1;min-width:0;display:flex;align-items:center;justify-content:center;min-height:58rpx;padding:10rpx 4rpx;font-size:calc(25rpx * var(--fs-scale, 1));font-weight:500;line-height:1.4;border-radius:12rpx;color:#788279;text-align:center}
.calendar-tab.selected{background:#FFFFFF;color:#244D3B;font-weight:600;box-shadow:0 2rpx 8rpx rgba(30,45,36,.08)}
.graph-panel{flex:1;min-height:0;display:flex;flex-direction:column;border-radius:30rpx;overflow:hidden;background:#F0F4EE;box-shadow:inset 0 0 0 1rpx rgba(42,69,52,.025)}
.graph-toolbar{display:flex;align-items:center;justify-content:center;gap:12rpx;padding:16rpx 20rpx 0;flex-shrink:0}
.graph-legend{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:8rpx 26rpx}
.graph-legend-item{display:flex;align-items:center;gap:10rpx;font-size:calc(21rpx * var(--fs-scale, 1));line-height:1.35;color:#77836F}
.graph-legend-ring{width:24rpx;height:24rpx;border-radius:50%;background:#F7F6F0;flex-shrink:0}
.graph-legend-ring.is-native{border:5rpx solid #C2493B}
.graph-legend-ring.is-introduced{border:5rpx solid #4E8A55}
.graph-stage{flex:1;min-height:0;height:0;width:100%}
.graph-canvas{position:relative;height:100%;width:100%;overflow:hidden}
.graph-line{position:absolute;height:0;border-top:1px solid rgba(89,126,97,.15);transform-origin:0 50%;pointer-events:none}
.graph-center{position:absolute;left:50%;top:47%;transform:translate(-50%,-50%);display:flex;align-items:center;justify-content:center;width:132rpx;height:132rpx;border-radius:50%;background:#E2EBDDF2;color:#537055;font-size:calc(27rpx * var(--fs-scale, 1));font-weight:600;line-height:1.3;text-align:center;white-space:normal;padding:0 4rpx;box-shadow:0 0 0 12rpx rgba(241,246,237,.7)}
.graph-center.en{font-size:calc(18rpx * var(--fs-scale, 1));line-height:1.25}
/* 评审 9.28：名字标签层级高于所有果图（z-index 全局比价），避免被相邻圆形果图压住；
   标签带浅底小圆角，压到连线也可读；果图多的季节（>12）整体缩小一圈。 */
.graph-fruit{position:absolute;transform:translate(-50%,-50%);width:116rpx;height:116rpx;min-width:44px;min-height:44px;color:#354238;text-align:center}
.graph-fruit-art{position:relative;width:100%;height:100%;overflow:hidden;border-radius:50%;background:#F7F6F0;box-shadow:0 6rpx 14rpx rgba(43,59,41,.035)}
.graph-fruit-art.native{border:6rpx solid #C2493B}
.graph-fruit-art.introduced{border:6rpx solid #4E8A55}
.graph-fruit-crop{position:absolute;inset:8%;overflow:hidden}
.graph-fruit-art image{position:absolute;display:block;max-width:none}
/* 10.2 / P02①：名字改由 node() 按角度定位到节点朝圆心的一侧（内圈），这里只管外观。
   限宽＋单行省略，保证内圈排布时名字之间、名字与水果都不互相压住。 */
.graph-fruit-art{z-index:1}.graph-fruit-name{position:absolute;max-width:92rpx;box-sizing:border-box;padding:2rpx 6rpx;border-radius:8rpx;background:rgba(253,251,244,.94);font-size:calc(21rpx * var(--fs-scale, 1));font-weight:500;line-height:1.22;letter-spacing:.2rpx;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none;z-index:2}
.graph-fruit.en .graph-fruit-name{max-width:96rpx;font-size:calc(20rpx * var(--fs-scale, 1));line-height:1.16;letter-spacing:0}
.is-dense .graph-fruit{width:100rpx;height:100rpx;min-width:40px;min-height:40px}
.is-dense .graph-fruit-name{font-size:calc(19rpx * var(--fs-scale, 1));max-width:84rpx}
.is-dense .graph-fruit-art.native,.is-dense .graph-fruit-art.introduced{border-width:5rpx}
.graph-fruit.is-locked{opacity:.5}
.season-summer{background:#FBF1EB}.season-summer .graph-center{background:#F3DFD2;color:#976F58;box-shadow:0 0 0 12rpx rgba(255,247,241,.8)}.season-summer .graph-line{border-color:rgba(164,123,92,.16)}
.season-autumn{background:#F7F0E5}.season-autumn .graph-center{background:#EDE0C8;color:#927648;box-shadow:0 0 0 12rpx rgba(252,248,240,.8)}.season-autumn .graph-line{border-color:rgba(146,113,66,.16)}
.season-winter{background:#EEF3F7}.season-winter .graph-center{background:#DFE8F0;color:#60798E;box-shadow:0 0 0 12rpx rgba(246,250,254,.8)}.season-winter .graph-line{border-color:rgba(99,127,152,.16)}
.calendar-bottom{display:flex;gap:14rpx;flex-shrink:0}
.bottom-entry{flex:1;min-width:0;display:flex;align-items:center;gap:10rpx;padding:16rpx 16rpx;background:#FFFFFF;border-radius:18rpx;color:#2C4E3A;font-size:calc(23rpx * var(--fs-scale, 1));font-weight:500;line-height:1.4;min-height:78rpx}
.bottom-entry>text:not(.entry-arrow):not(.entry-symbol){flex:1;min-width:0}
.guoling-face{width:44rpx;height:44rpx;flex-shrink:0;border-radius:50%;background:#EDF1E7;overflow:hidden}
.entry-arrow{font-size:calc(27rpx * var(--fs-scale, 1));color:#9BA69C;flex-shrink:0;margin-left:auto}
.entry-symbol{font-size:calc(32rpx * var(--fs-scale, 1));color:#8F9E8D;flex-shrink:0;width:38rpx;text-align:center}
@media (max-height: 660px){.calendar-content{gap:14rpx;padding-top:16rpx}.screen-title{font-size:calc(42rpx * var(--fs-scale, 1))}.screen-subtitle{font-size:calc(21rpx * var(--fs-scale, 1));margin-top:6rpx}.calendar-tab{min-height:52rpx;font-size:calc(23rpx * var(--fs-scale, 1));padding:8rpx 4rpx}.bottom-entry{min-height:70rpx;padding:12rpx 14rpx}.graph-toolbar{padding:12rpx 14rpx 0}.graph-legend{gap:6rpx 20rpx}.graph-legend-item{font-size:calc(19rpx * var(--fs-scale, 1))}.graph-legend-ring{width:20rpx;height:20rpx}.graph-fruit{width:88rpx;height:88rpx}.graph-fruit-name{font-size:calc(20rpx * var(--fs-scale, 1));max-width:78rpx}.graph-fruit.en .graph-fruit-name{font-size:calc(19rpx * var(--fs-scale, 1));max-width:82rpx}.graph-center{width:100rpx;height:100rpx;font-size:calc(22rpx * var(--fs-scale, 1));box-shadow:0 0 0 8rpx rgba(255,255,255,.48)}.graph-center.en{font-size:calc(16rpx * var(--fs-scale, 1))}}
.graph-fruit-art image{width:100%;height:100%}
