.companion-page{padding-top:38rpx;padding-bottom:220rpx}.page-title{font-size: calc(48rpx * var(--fs-scale, 1));line-height:1.45;margin-top:18rpx}.intro{font-size: calc(23rpx * var(--fs-scale, 1));color: #47634B;line-height:1.85;max-width:570rpx}.partition-label{display:inline-block;font-size: calc(19rpx * var(--fs-scale, 1));color:#687A5F;background:#E9EDDF;padding:8rpx 15rpx;margin:23rpx 0 18rpx;border-radius:6rpx}.section-heading{display:flex;justify-content:space-between;gap:16rpx;align-items:center;margin:30rpx 0 19rpx;font-size: calc(26rpx * var(--fs-scale, 1));color: #234B3C}.library-count{font-size: calc(19rpx * var(--fs-scale, 1));color: #87917B}.search-box{display:flex;align-items:center;background: #FFFDF8;border: 1rpx solid #DCE5D0;border-radius:14rpx;padding:15rpx 20rpx;margin-bottom:18rpx;gap:15rpx}.search-box input{flex:1;font-size: calc(23rpx * var(--fs-scale, 1));height:45rpx;min-width:0}.search-symbol{font-size: calc(32rpx * var(--fs-scale, 1));color: #47634B;line-height:1}.template-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13rpx}.template-option{display:flex;flex-direction:column;align-items:center;background: #FFFDF8;border: 2rpx solid #E1E5D9;border-radius: 18rpx;padding:5rpx 12rpx 15rpx;min-width:0}.template-option.selected{border-color: #47634B;background: #EAF0E0}.template-label{display:flex;justify-content:space-between;width:100%;padding:0 6rpx;color: #47634B;font-size: calc(21rpx * var(--fs-scale, 1))}.template-option.selected .template-label{color: #234B3C}.no-results{font-size: calc(23rpx * var(--fs-scale, 1));text-align:center;padding:45rpx 25rpx;color: #47634B;border: 1rpx dashed #DCE5D0;border-radius:15rpx}.canvas-heading{margin-top:37rpx}.canvas-paper{position:relative;background: #FFFDF8;border: 1rpx solid #DCE5D0;border-radius: 28rpx;padding:20rpx 18rpx 17rpx;box-shadow: 0 4rpx 20rpx rgba(29,37,32,.06)}.paper-mark{font-size: calc(19rpx * var(--fs-scale, 1));letter-spacing:3rpx;color: #87917B;padding:2rpx 8rpx}.editor-canvas{width:100%;height:calc(100vw - 110rpx);display:block;touch-action:none}.paper-footer{display:flex;justify-content:space-between;font-size: calc(21rpx * var(--fs-scale, 1));color: #47634B;padding:0 10rpx}.paper-footer>text:last-child{color: #87917B;font-size: calc(19rpx * var(--fs-scale, 1))}.canvas-error{position:absolute;inset:66rpx 20rpx 55rpx;background: #F7F5ED;display:flex;justify-content:center;align-items:center;flex-direction:column;padding:40rpx;text-align:center;font-size: calc(23rpx * var(--fs-scale, 1));color: #47634B;border-radius: 18rpx;line-height:1.9}.canvas-error button{background: #234B3C;color: #F7F5ED;padding:16rpx 26rpx;font-size: calc(23rpx * var(--fs-scale, 1));margin-top:25rpx}.tool-switch{display:flex;gap:8rpx;background: #E9EEE3;border-radius:12rpx;padding:7rpx;margin:20rpx 0}.tool-switch button{flex:1;padding:13rpx 8rpx;background:transparent;border-radius:9rpx;color: #47634B;font-size: calc(23rpx * var(--fs-scale, 1));line-height:1.5}.tool-switch button.active{background: #234B3C;color: #FFFDF8}.palette{display:grid;grid-template-columns:repeat(10,minmax(0,1fr));align-items:center;gap:8rpx;margin:24rpx 1rpx 26rpx}.swatch{aspect-ratio:1;border-radius:50%;border:1rpx solid rgba(35,75,60,.17);display:flex;justify-content:center;align-items:center;position:relative;min-height:36rpx}.swatch.active::after{content:"";position:absolute;inset:-5rpx;border: 2rpx solid #234B3C;border-radius:50%}.swatch-dot{width:8rpx;height:8rpx;border: 2rpx solid #F7F5ED;box-shadow:0 0 0 1rpx #234B3C;border-radius:50%;background: #234B3C}.brush-options{display:flex;align-items:center;gap:15rpx;font-size: calc(21rpx * var(--fs-scale, 1));color: #87917B;padding-bottom:18rpx}.brush-options>text{margin-right:auto}.brush-options button{font-size: calc(21rpx * var(--fs-scale, 1));color: #47634B;background: #EAF0E0;line-height:1.5;padding:8rpx 24rpx;border-radius:8rpx}.brush-options button.chosen{background: #234B3C;color: #FFFDF8}.transform-tools{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top: 1rpx solid #DCE5D0;border-bottom: 1rpx solid #DCE5D0}.transform-tools button{background:transparent;color: #47634B;font-size: calc(21rpx * var(--fs-scale, 1));line-height:1.5;border-radius:0;padding:19rpx 4rpx;display:flex;align-items:center;justify-content:center;gap:9rpx}.tool-icon{font-size: calc(32rpx * var(--fs-scale, 1));line-height:1}.subtle-hint{display:block;color: #87917B;font-size: calc(21rpx * var(--fs-scale, 1));line-height:1.9;margin-top:14rpx}.name-field{margin:28rpx 0}.name-field .field-label{font-size: calc(23rpx * var(--fs-scale, 1));font-weight:400}.name-field input{background: #FFFDF8;border: 1rpx solid #DCE5D0;border-radius:13rpx;height:80rpx;font-size: calc(26rpx * var(--fs-scale, 1));padding:14rpx 20rpx}.photo-section{border-top: 1rpx solid #DCE5D0;border-bottom: 1rpx solid #DCE5D0;margin-top:33rpx}.photo-heading{display:flex;align-items:center;justify-content:space-between;padding:25rpx 0;color: #47634B;font-size: calc(23rpx * var(--fs-scale, 1))}.photo-heading>text{font-size: calc(28rpx * var(--fs-scale, 1));padding:12rpx}.photo-heading .photo-subtitle{display:block;font-size: calc(19rpx * var(--fs-scale, 1));color: #87917B;margin-top:6rpx}.photo-body{padding:0 0 26rpx}.photo-placeholder{padding:25rpx 16rpx 35rpx;color: #87917B;font-size: calc(23rpx * var(--fs-scale, 1));line-height:1.8}.photo-preview{background: #E9EEE3;border-radius:15rpx;padding:20rpx;margin-bottom:20rpx}.photo-preview image{width:100%;height:320rpx}.photo-status{font-size: calc(21rpx * var(--fs-scale, 1));color:#667B59;text-align:center;margin:18rpx 0 10rpx}.clear-photo{background:transparent;color: #B96D50;font-size: calc(21rpx * var(--fs-scale, 1));padding:12rpx;line-height:1.6}.photo-body .button-secondary{font-size: calc(23rpx * var(--fs-scale, 1));padding:18rpx 20rpx}.original-note{color: #87917B;font-size: calc(19rpx * var(--fs-scale, 1));line-height:1.8;margin:28rpx 5rpx 4rpx}.leave-link{color: #47634B;background:transparent;font-size: calc(21rpx * var(--fs-scale, 1));padding:20rpx;line-height:1.8}.editor-bottom{position:fixed;left:0;right:0;bottom:0;z-index:5;display:flex;gap:15rpx;background: #F7F5ED;border-top: 1rpx solid #DCE5D0;padding:22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));box-sizing:border-box}.editor-bottom button{font-size: calc(26rpx * var(--fs-scale, 1));line-height:1.5;padding:23rpx 16rpx;border-radius:14rpx;min-width:0}.preview-button{background: #E9EEE3;color: #47634B;flex:1}.save-button{background: #234B3C;color: #FFFDF8;flex:2}.paper-preview{box-shadow: 0 4rpx 20rpx rgba(29,37,32,.06)}
.use-photo{margin:14rpx 0 4rpx;background: #234B3C;color: #87917B;font-size: calc(23rpx * var(--fs-scale, 1));line-height:2.4;border-radius:12rpx;padding:0}
.gen-button{background: #47634B}
.gen-error{color: #B96D50}

/* 工具栏：文字居中排布（原偏右问题修复），五个工具均分 */
.transform-tools{display:flex;justify-content:center;align-items:center;gap:6rpx;border-top: 1rpx solid #DCE5D0;border-bottom: 1rpx solid #DCE5D0}
.transform-tools button{flex:1;background:transparent;color: #47634B;font-size: calc(21rpx * var(--fs-scale, 1));line-height:1.5;border-radius:0;padding:19rpx 4rpx;display:flex;align-items:center;justify-content:center;gap:8rpx;text-align:center}
.transform-tools button[disabled]{color: #87917B}
/* 未解锁定制水果：置灰锁定 */
.template-option.is-locked{opacity:.85}
.template-option.is-locked .template-art{filter:grayscale(1);opacity:.55}
.template-art{width:100%;display:flex;justify-content:center}
.template-lock-hint{font-size: calc(19rpx * var(--fs-scale, 1));color: #B96D50;background: #F0ECDE;border-radius:999rpx;padding:4rpx 12rpx;margin-top:8rpx;text-align:center}
/* 照片区：不折叠 */
.photo-heading{cursor:default}

/* Separate the fruit library, drawing surface and photo studio. */
.companion-page { padding-top: 32rpx; }
.page-title { font-size: calc(48rpx * var(--fs-scale, 1)); margin-top: 10rpx; }
.intro { color: #47634B; font-size: calc(26rpx * var(--fs-scale, 1)); }
.partition-label { color: #7B694D; background: #EEE8D6; border-radius: 8rpx; padding: 9rpx 16rpx; font-size: calc(21rpx * var(--fs-scale, 1)); }
.section-heading { font-size: calc(28rpx * var(--fs-scale, 1)); font-weight: 600; margin: 28rpx 0 20rpx; }
.library-count { color: #47634B; font-size: calc(21rpx * var(--fs-scale, 1)); font-weight: 400; text-align: right; }
.search-box { border-radius: 18rpx; padding: 18rpx 20rpx; }
.search-box input { height: 48rpx; font-size: calc(26rpx * var(--fs-scale, 1)); }
.template-grid { gap: 16rpx; }
.template-option { border-radius: 28rpx; padding: 10rpx 10rpx 18rpx; }
.template-option.selected { border-color: #47634B; background: #EAF0E0; box-shadow: 0 4rpx 20rpx rgba(29,37,32,.06); }
.template-label { font-size: calc(23rpx * var(--fs-scale, 1)); gap: 6rpx; }
.template-lock-hint { font-size: calc(19rpx * var(--fs-scale, 1)); border-radius: 8rpx; color: #826B4B; }
.canvas-paper { border-radius: 28rpx; box-shadow: 0 4rpx 20rpx rgba(29,37,32,.06); }
.paper-footer { padding: 10rpx 10rpx 3rpx; font-size: calc(23rpx * var(--fs-scale, 1)); }
.paper-footer > text:last-child { color: #47634B; font-size: calc(21rpx * var(--fs-scale, 1)); }
.tool-switch { border-radius: 15rpx; padding: 8rpx; gap: 8rpx; }
.tool-switch button { border-radius: 10rpx; padding: 16rpx 10rpx; font-size: calc(26rpx * var(--fs-scale, 1)); }
.palette { gap: 10rpx; margin: 30rpx 2rpx; }
.transform-tools { background: #FFFDF8; border: 1rpx solid #E1E5D9; border-radius: 18rpx; gap: 0; overflow: hidden; }
.transform-tools button { flex-direction: column; font-size: calc(21rpx * var(--fs-scale, 1)); gap: 10rpx; padding: 20rpx 2rpx; }
.tool-icon { font-size: calc(32rpx * var(--fs-scale, 1)); }
.subtle-hint { font-size: calc(21rpx * var(--fs-scale, 1)); color: #47634B; line-height: 1.8; }
/* 评审 9.28②：03 区块太紧凑、第一行太靠上 —— 加大上边距与标题内边距。 */
.photo-section { border: 1rpx solid #E1E5D9; border-radius: 28rpx; background: #FFFDF8; padding: 0 28rpx; margin-top: 56rpx; }
.photo-heading { padding-top: 40rpx; padding-bottom: 6rpx; font-size: calc(28rpx * var(--fs-scale, 1)); color: #2E4A38; }
.photo-heading .photo-subtitle { color: #47634B; font-size: calc(21rpx * var(--fs-scale, 1)); line-height: 1.7; }
.photo-placeholder { padding: 8rpx 0 28rpx; font-size: calc(23rpx * var(--fs-scale, 1)); color: #47634B; }
.use-photo { padding: 18rpx 20rpx; line-height: 1.6; border-radius: 14rpx; }
.original-note { font-size: calc(21rpx * var(--fs-scale, 1)); color: #47634B; }
/* 10.2 / P23⑨：「预览」框已移除，保存伙伴独占一行并整体居中。 */
.editor-bottom { padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom)); box-shadow: 0 -8rpx 30rpx rgba(35,75,60,.04); display: flex; justify-content: center; }
.editor-bottom button { border-radius: 18rpx; }
.editor-bottom .save-button { width: 100%; max-width: 560rpx; margin: 0; }

/* 03 分节标题（果灵生成卡通形象）改挂 section-heading，与 01/02 的字号、字重、颜色完全一致（评审 P12②）。
   覆盖 .photo-heading 旧有的颜色/字号声明，margin 归零以保留照片卡片自身的内边距节奏。 */
.photo-heading.section-heading { margin: 0; color: #234B3C; font-size: calc(28rpx * var(--fs-scale, 1)); font-weight: 600; }

/* A drawing studio with a live preview, paper surface and measured controls. */
.companion-heading { display: flex; align-items: center; gap: 18rpx; padding-bottom: 18rpx; border-bottom: 1rpx solid #DCE5D0; }
.companion-heading-copy { flex: 1; min-width: 0; }
.companion-heading .page-title { font-size: calc(38rpx * var(--fs-scale, 1)); margin: 0 0 14rpx; }
.companion-heading .partition-label { margin: 0; font-size: calc(21rpx * var(--fs-scale, 1)); padding: 8rpx 13rpx; }
/* 评审 9.28①：图像与边框匹配 —— 方形框内统一 6rpx 衬边，120rpx 果灵正好撑满。 */
.companion-heading-preview { width: 132rpx; height: 132rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border: 1rpx solid #DCE5D0; border-radius: 28rpx; background: #F0ECDE; }
.section-heading { margin-top: 30rpx; font-size: calc(28rpx * var(--fs-scale, 1)); }
.template-grid { gap: 15rpx; }
.template-option { padding: 10rpx 10rpx 16rpx; background: #FFFDF8; border-color: #E1E5D9; }
.template-option.selected { border-color: #47634B; background: #EAF0E0; }
.template-lock-hint { padding: 5rpx 9rpx; border-radius: 8rpx; font-size: calc(19rpx * var(--fs-scale, 1)); line-height: 1.6; background: #F0ECDE; }
.canvas-paper { border-color: #DCE5D0; border-radius: 28rpx; background: #FFFDF8; box-shadow: 0 4rpx 20rpx rgba(29,37,32,.06); }
.paper-footer { border-top: 1rpx solid #F0ECDE; padding-top: 15rpx; margin-top: 8rpx; }
.tool-switch { background: #E9EEE3; margin-top: 24rpx; }
.photo-section { background: #F7F5ED; border-color: #DCE5D0; }
.photo-heading { color: #2E4A38; }
.photo-preview { background: #F0ECDE; }
.editor-bottom { background: #FFFDF8; border-top-color: #DCE5D0; }
.preview-button { background: #E9EEE3; }
.save-button { background: #47634B; }

.brush-options{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));align-items:center;gap:8rpx;font-size: calc(21rpx * var(--fs-scale, 1));color: #87917B;padding:4rpx 0 18rpx}
.brush-options>text{font-size: calc(21rpx * var(--fs-scale, 1));color: #87917B}
.brush-options button{width:100%;font-size: calc(21rpx * var(--fs-scale, 1));color: #47634B;background: #EAF0E0;line-height:1.5;padding:10rpx 0;border-radius:8rpx;text-align:center}
.brush-options button.chosen{background: #234B3C;color: #FFFDF8}
.photo-heading.section-heading{padding:0;font-size: calc(28rpx * var(--fs-scale, 1));font-weight: 600;color: #234B3C}
.photo-heading.section-heading>view>text{font-size: calc(28rpx * var(--fs-scale, 1));padding:0;color: #234B3C}
.photo-heading .photo-subtitle{display:block;font-size: calc(21rpx * var(--fs-scale, 1));color: #87917B;margin-top:6rpx;line-height:1.7}
.photo-heading.section-heading .photo-subtitle{font-size: calc(21rpx * var(--fs-scale, 1));color: #87917B;font-weight:400;margin-top:6rpx}
