.playground-page { padding: 30rpx 32rpx calc(60rpx + env(safe-area-inset-bottom)); background: #F5F5F7; min-height: 0; }
.game-card { background: #FFFFFF; border-radius: 26rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 18rpx rgba(29,37,32,.025); }
.game-head { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.game-num { font-family: inherit; font-size: 22rpx; color: #8B948C; font-weight: 600; }
.game-name { font-size: 30rpx; color: #263B2D; flex: 1; min-width: 0; font-weight: 600; line-height: 1.45; }
.game-pill { display: inline-block; font-size: 19rpx; line-height: 1.5; background: #EDF0E4; color: #637852; border-radius: 6rpx; padding: 6rpx 11rpx; }
.game-desc { font-size: 24rpx; color: #747E74; line-height: 1.85; margin-bottom: 18rpx; }
.playground-page .game-button { width: 100%; margin: 20rpx 0 0; background: #234B3C; color: #FFFCF3; font-size: 26rpx; line-height: 1.5; border-radius: 16rpx; padding: 21rpx 24rpx; }
.game-result { margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #E4E8DA; }
.result-line { font-size: 24rpx; color: #63745A; line-height: 1.8; }
.game-result.is-hit .result-line { color: #234B3C; font-size: 28rpx; }
.quiz-progress { font-size: 21rpx; color: #8C8066; margin: 4rpx 0 16rpx; letter-spacing: 1rpx; }
.quiz-question { font-size: 34rpx; line-height: 1.65; color: #344B36; padding: 22rpx 24rpx; background: #F2F5EF; border-radius: 14rpx; margin-bottom: 16rpx; font-weight: 600; }
.quiz-prompt { font-size: 22rpx; color: #808C75; line-height: 1.7; margin: 0 0 16rpx; }
.quiz-option { display: flex; justify-content: space-between; align-items: center; gap: 18rpx; background: #F7F8F5; border: 1rpx solid #E2E7D7; border-radius: 14rpx; padding: 23rpx; margin-bottom: 12rpx; font-size: 27rpx; line-height: 1.7; color: #52634E; border-color: #E9EDE5; }
.quiz-option.is-correct { background: #EAF2E3; border-color: #B5C9A4; color: #2E4A38; font-weight: 600; }
.quiz-mark { color: #4E6B3F; flex-shrink: 0; }
.quiz-feedback { font-size: 24rpx; line-height: 1.8; padding: 10rpx 0 0; color: #AA624D; }
.quiz-feedback.good { color: #4E6B3F; }
.quiz-done { font-size: 30rpx; color: #2E4A38; line-height: 1.8; }
.quiz-done text { display: block; margin-top: 10rpx; color: #6C7D5E; font-size: 25rpx; }
.paint-intro { display: flex; align-items: center; gap: 20rpx; margin-bottom: 24rpx; }
.paint-intro-copy { flex: 1; min-width: 0; }
.paint-intro .game-head { margin-bottom: 12rpx; }
.paint-intro .game-desc { margin-bottom: 12rpx; }
.paint-vignette { width: 158rpx; height: 178rpx; flex-shrink: 0; border-radius: 16rpx; background: #F5EAD4; }
.paint-examples { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 0 0 16rpx; }
.paint-example { font-size: 22rpx; line-height: 1.5; color: #566E4D; background: #EDF0E5; border-radius: 10rpx; padding: 11rpx 16rpx; }
.paint-input { box-sizing: border-box; width: 100%; height: 90rpx; line-height: 46rpx; background: #F5F6F3; border: 1rpx solid #DEDCCD; border-radius: 14rpx; padding: 20rpx 22rpx; font-size: 25rpx; margin-top: 20rpx; border-color: #E1E6DC; }
.paint-note { font-size: 23rpx; color: #79816D; line-height: 1.85; margin-top: 16rpx; }
.paint-result { margin-top: 24rpx; }
.paint-art { width: 100%; height: 560rpx; border-radius: 16rpx; background: #F5F5F2; margin-bottom: 14rpx; }
.playground-page .game-share,.playground-page .paint-setup { background: #EAEEDF; color: #31543F; }
.unlock-overlay { position: fixed; inset: 0; z-index: 200; background: rgba(14,26,17,.62); display: flex; align-items: center; justify-content: center; }
.unlock-card { width: 600rpx; max-height: 86vh; overflow-y: auto; box-sizing: border-box; background: #FFFFFF; border-radius: 28rpx; padding: 38rpx 36rpx 30rpx; text-align: center; }
.unlock-face { display: flex; justify-content: center; margin-bottom: 12rpx; }
.unlock-title { font-size: 40rpx; line-height: 1.5; color: #234B3C; margin: 6rpx 0 14rpx; font-weight: 700; }
.unlock-body { font-size: 24rpx; color: #68745F; line-height: 1.8; margin-bottom: 26rpx; }
.unlock-card .unlock-go { width: 100%; background: #234B3C; color: #FFF9DF; font-size: 26rpx; border-radius: 16rpx; padding: 20rpx; line-height: 1.6; margin: 0 0 14rpx; }
.unlock-card .unlock-continue { width: 100%; background: transparent; color: #4A6350; font-size: 24rpx; line-height: 1.6; padding: 14rpx; margin: 0; }
page { background: #F5F5F7; }
.playground-heading { margin: 4rpx 0 28rpx; }
.playground-kicker { display: block; color: #7B837C; font-size: 22rpx; font-weight: 600; margin-bottom: 8rpx; }
.playground-title { color: #1D2520; font-size: 46rpx; font-weight: 700; line-height: 1.25; letter-spacing: -1rpx; }

.quiz-kind { color: #6e6e73; font-size: 22rpx; margin-top: 24rpx; }
.quiz-source { color: #326c50; font-size: 22rpx; line-height: 1.6; margin: 20rpx 0; }
