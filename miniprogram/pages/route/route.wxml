<view class="route-screen {{fontClass}}">
  <demo-notice id="demo-mode-notice"/>
  <view class="route-head">
    <view class="route-title serif">{{L.rt_page_title}}</view>
    <view class="route-head-actions"><me-entry/></view>
  </view>

  <scroll-view scroll-y class="route-scroll">
    <!-- ① 下一张票：深绿票卡（设计稿第⑤屏） -->
    <view wx:if="{{next}}" class="ticket-next" id="ticket-{{next.id}}">
      <view class="tn-top" data-id="{{next.id}}" bindtap="toggleTicket" role="button">
        <view class="tn-k">{{L.rt_next_ticket}}</view>
        <view wx:if="{{next.countdown}}" class="tn-chip">{{next.countdown}}</view>
        <view class="tn-dest">{{next.destName}}</view>
        <view class="tn-rows">
          <view class="tn-row"><text class="tn-key">{{L.rt_when}}</text><text class="tn-val">{{next.whenLabel}}</text></view>
          <view class="tn-row"><text class="tn-key">{{L.rt_how}}</text><text class="tn-val">{{next.transportText}}</text></view>
        </view>
      </view>
      <view class="tn-perf"/>
      <view class="tn-bottom">
        <!-- ⑦ 展开区（2026-10 用户拍板）：只留「导航出发」「去过了·撕票盖章」两个动作。
             原先的「联系人 / 位置 / 备注」三段展示整块删除；i18n 键与票据字段、保存逻辑一个字没动。 -->
        <view class="ticket-actions"><view class="ticket-btn ticket-btn-primary" data-id="{{next.id}}" bindtap="navigateTicket">{{L.rt_navigate_go}}</view></view>
        <view class="ticket-actions"><view class="ticket-btn" data-id="{{next.id}}" bindtap="stampTicket">{{L.rt_stamp}}</view></view>
      </view>
    </view>
    <view wx:else class="ticket-empty">{{L.rt_no_ticket}}</view>

    <!-- ② 待用的票：紧凑单行，点开才展开（设计稿第⑤屏） -->
    <view class="seg-label">{{L.rt_pending_tickets}}</view>
    <block wx:if="{{pending.length}}">
      <view wx:for="{{pending}}" wx:key="id" class="row-ticket {{expandedId === item.id ? 'is-open' : ''}}" id="ticket-{{item.id}}">
        <view class="rt-main" data-id="{{item.id}}" bindtap="toggleTicket" role="button">
          <view class="rt-left">
            <view class="rt-name">{{item.destName}}</view>
            <view class="rt-sub">{{item.whenLabel}} ｜ {{item.transportText}}</view>
          </view>
          <view wx:if="{{item.countdown}}" class="rt-chip">{{item.countdown}}</view>
          <view class="rt-arrow">{{expandedId === item.id ? '⌃' : '›'}}</view>
        </view>
        <view wx:if="{{expandedId === item.id}}" class="tk-more">
          <!-- 展开区（2026-10 用户拍板）：联系人 / 位置 / 备注三段展示删除，
               只留动作按钮；待用票的删除（✕）是既有功能，保留。 -->
          <view class="ticket-actions">
            <view class="ticket-btn ticket-btn-primary" data-id="{{item.id}}" bindtap="navigateTicket">{{L.rt_navigate_go}}</view>
            <view class="ticket-btn" data-id="{{item.id}}" bindtap="stampTicket">{{L.rt_stamp}}</view>
            <view class="ticket-btn ticket-btn-quiet" data-id="{{item.id}}" bindtap="removeTicket">✕</view>
          </view>
        </view>
      </view>
    </block>
    <view wx:else class="ticket-empty">{{L.rt_no_pending}}</view>

    <!-- ③ ＋ 排一张票 -->
    <view class="add-ticket" bindtap="openDrawer" role="button">
      <view class="add-sign">＋</view><view class="add-text">{{L.rt_add_ticket}}</view>
    </view>

    <!-- ④ 存根：红章「已去过」+ 日期（设计稿第⑤屏） -->
    <view class="seg-label">{{L.rt_stubs}}</view>
    <block wx:if="{{stubs.length}}">
      <view wx:for="{{stubs}}" wx:key="id" class="stub" id="stub-{{item.id}}">
        <view class="stub-seal"><text class="seal-a">{{L.rt_visited}}</text><text class="seal-b">{{item.stampShort}}</text></view>
        <view class="stub-main">
          <view class="rt-name">{{item.destName}}</view>
          <view class="rt-sub">{{item.whenLabel}} ｜ {{item.transportText}}</view>
        </view>
      </view>
    </block>
    <view wx:else class="ticket-empty">{{L.rt_no_stub}}</view>

    <view wx:if="{{error}}" class="route-error">{{error}}</view>
  </scroll-view>

  <!-- ⑥ 排票抽屉：不跳页，背后仍是票夹原样；只问 去哪 / 什么时候去 / 怎么去 -->
  <!-- 2026-10-11：遮罩上原来挂着 catchtouchmove="noop"，它会把抽屉内列表的滑动一起吞掉（划不动）→ 去掉。
       背景是 scroll-view（只有直接触摸它才滚），所以去掉后不会出现"背景跟着滚"。 -->
  <view wx:if="{{drawerOpen}}" class="plan-mask" bindtap="closeDrawer">
    <view class="plan-sheet" catchtap="noop">
      <view class="plan-head">
        <view class="plan-title serif">{{L.rt_add_ticket}}</view>
        <view class="plan-head-actions">
          <view class="plan-save" bindtap="confirmTicket" role="button">{{L.rt_save}}</view>
          <view class="plan-close" bindtap="closeDrawer" role="button">✕</view>
        </view>
      </view>
      <scroll-view scroll-y class="plan-scroll">
        <view class="plan-label">{{L.rt_drawer_where}}</view>
        <block wx:if="{{poolPreview.length}}">
          <!-- 预览的第一张：整张果乡名片（2026-10-12 第12 轮 + 第13 轮补全）——名称/节气·水果/可去日期/
               体验标签/所在地区/具体位置/开关门日期/开关门时间/距离/果乡介绍/交通指引/微信号/手机号/联系方式，
               字段与快讯卡片一致；整行仍可点选，右侧仍是勾选圈。无值的行整行不显示（不出现「暂无」）。 -->
          <view wx:for="{{poolPreview}}" wx:key="id" class="pool-row {{draft.destId === item.id ? 'is-on' : ''}}" data-id="{{item.id}}" bindtap="pickDest" role="button">
            <view class="pool-main">
              <view class="pool-name">{{item.card.name}}</view>
              <view wx:if="{{item.card.termLabel}}" class="pool-term">{{item.card.termLabel}}</view>
              <!-- 可去日期（写法照 news.wxml 那条：news_activity_date + 值，不拼冒号） -->
              <view wx:if="{{item.card.activityDate}}" class="pool-line pool-date">{{L.news_activity_date}} {{item.card.activityDate}}</view>
              <view wx:if="{{item.expTags.length}}" class="pool-chips">
                <view wx:for="{{item.expTags}}" wx:for-item="tag" wx:key="*this" class="pool-chip">{{tag}}</view>
              </view>
              <view wx:if="{{item.card.region}}" class="pool-line">{{L.sl_region}}</view>
              <view wx:if="{{item.card.region}}" class="pool-line">{{item.card.region}}</view>
              <view wx:if="{{item.card.address}}" class="pool-line">{{L.sl_address}}</view>
              <view wx:if="{{item.card.address}}" class="pool-line">{{item.card.address}}</view>
              <!-- 开关门日期 / 时间：标签复用卖货台那套自带冒号的键（英文同款，不硬拼全角冒号） -->
              <view wx:if="{{item.card.openDateText}}" class="pool-line">{{L.sl_open_date_colon}}{{item.card.openDateText}}</view>
              <view wx:if="{{item.card.openTimeText}}" class="pool-line">{{L.sl_open_time_colon}}{{item.card.openTimeText}}</view>
              <!-- 距你多少公里：与快讯卡片同款写法（值自带「距你」/「km away」，无值整行不显示） -->
              <view wx:if="{{item.card.distance}}" class="pool-line pool-distance">{{item.card.distance}}</view>
              <view wx:if="{{item.card.intro}}" class="pool-line">{{L.sl_intro}}</view>
              <view wx:if="{{item.card.intro}}" class="pool-intro">{{item.card.intro}}</view>
              <view wx:if="{{item.card.transport}}" class="pool-line">{{L.sl_transport}}：{{item.card.transport}}</view>
              <view class="pool-line">{{L.sl_wechat_colon}}{{item.card.wechat || L.sl_none}}</view>
              <view class="pool-line">{{L.sl_phone_colon}}{{item.card.phone || L.sl_none}}</view>
              <!-- 「活动方案」（2026-10-13）：AI 生成的活动方案（方案名 + 编号的那几步），照「我的发布」卡片那块写。
                   数据来自 lib/town-info.js 的 cardFor（与快讯页共用同一套）；没有方案的名片整块不渲染。
                   标题复用既有键 plan_nav（词典里就是「活动方案」/「Activity plan」），不新造键。 -->
              <view wx:if="{{item.card.hasPlan}}" class="pool-plan">
                <view class="pool-line">{{L.plan_nav}}</view>
                <view class="pool-plan-title">{{item.card.planTitle}}</view>
                <view wx:for="{{item.card.planSteps}}" wx:for-item="step" wx:for-index="stepIndex" wx:key="*this" class="pool-plan-step">{{stepIndex + 1}}. {{step}}</view>
              </view>
              <!-- 联系方式：只作一行文字，不做按钮（整行本身已经是点选区）；有值才显示 -->
              <view wx:if="{{item.card.contact}}" class="pool-line">{{L.rt_contact_prefix}}{{item.card.contact}}</view>
            </view>
            <view class="pool-check">{{draft.destId === item.id ? '✓' : ''}}</view>
          </view>
          <block wx:if="{{poolExpanded}}">
            <!-- 其余果园：与第一张同一套内容，点「查看更多果园」才出现（展开逻辑未改） -->
            <view wx:for="{{poolRest}}" wx:key="id" class="pool-row {{draft.destId === item.id ? 'is-on' : ''}}" data-id="{{item.id}}" bindtap="pickDest" role="button">
              <view class="pool-main">
                <view class="pool-name">{{item.card.name}}</view>
                <view wx:if="{{item.card.termLabel}}" class="pool-term">{{item.card.termLabel}}</view>
                <!-- 与预览那一条逐项相同：可去日期 / 开关门日期 / 开关门时间 / 距离 / 联系方式，有值才显示 -->
                <view wx:if="{{item.card.activityDate}}" class="pool-line pool-date">{{L.news_activity_date}} {{item.card.activityDate}}</view>
                <view wx:if="{{item.expTags.length}}" class="pool-chips">
                  <view wx:for="{{item.expTags}}" wx:for-item="tag" wx:key="*this" class="pool-chip">{{tag}}</view>
                </view>
                <view wx:if="{{item.card.region}}" class="pool-line">{{L.sl_region}}</view>
                <view wx:if="{{item.card.region}}" class="pool-line">{{item.card.region}}</view>
                <view wx:if="{{item.card.address}}" class="pool-line">{{L.sl_address}}</view>
                <view wx:if="{{item.card.address}}" class="pool-line">{{item.card.address}}</view>
                <view wx:if="{{item.card.openDateText}}" class="pool-line">{{L.sl_open_date_colon}}{{item.card.openDateText}}</view>
                <view wx:if="{{item.card.openTimeText}}" class="pool-line">{{L.sl_open_time_colon}}{{item.card.openTimeText}}</view>
                <view wx:if="{{item.card.distance}}" class="pool-line pool-distance">{{item.card.distance}}</view>
                <view wx:if="{{item.card.intro}}" class="pool-line">{{L.sl_intro}}</view>
                <view wx:if="{{item.card.intro}}" class="pool-intro">{{item.card.intro}}</view>
                <view wx:if="{{item.card.transport}}" class="pool-line">{{L.sl_transport}}：{{item.card.transport}}</view>
                <view class="pool-line">{{L.sl_wechat_colon}}{{item.card.wechat || L.sl_none}}</view>
                <view class="pool-line">{{L.sl_phone_colon}}{{item.card.phone || L.sl_none}}</view>
                <!-- 「活动方案」：与预览那一条逐项相同；没有方案的名片整块不渲染 -->
                <view wx:if="{{item.card.hasPlan}}" class="pool-plan">
                  <view class="pool-line">{{L.plan_nav}}</view>
                  <view class="pool-plan-title">{{item.card.planTitle}}</view>
                  <view wx:for="{{item.card.planSteps}}" wx:for-item="step" wx:for-index="stepIndex" wx:key="*this" class="pool-plan-step">{{stepIndex + 1}}. {{step}}</view>
                </view>
                <view wx:if="{{item.card.contact}}" class="pool-line">{{L.rt_contact_prefix}}{{item.card.contact}}</view>
              </view>
              <view class="pool-check">{{draft.destId === item.id ? '✓' : ''}}</view>
            </view>
          </block>
        </block>
        <view wx:elif="{{poolFailed}}" class="pool-empty">{{L.rt_load_failed}}</view>
        <view wx:else class="pool-empty">{{L.rt_pool_empty}}</view>
        <view class="filter-note">{{L.rt_pool_note}} <text wx:if="{{poolRest.length || poolExpanded}}" class="more" bindtap="togglePool">{{poolExpanded ? L.rt_pool_less : poolMoreLabel}}</text></view>

        <view class="plan-label">{{L.rt_drawer_when}}</view>
        <view class="plan-when">
          <!-- 日期用 multiSelector 自己给列：列里只有"今天及以后"的年月日（原生 date picker 会把过去的也画出来） -->
          <view class="plan-input" bindtap="openDateSheet">{{draft.date || L.rt_pick_date}}</view>
          <view class="plan-input" bindtap="openTimeSheet">{{draft.time || L.rt_pick_time}}</view>
        </view>
        <!-- 每天还剩多少名额（GET /api/booking-availability）：每一天一行、带当天剩余名额。
             满员 / 已过去的那天整行灰掉、不做点击区（disabled 的那种行不绑 tap）。
             接口还没部署到线上（404）、断网、403 一律按「名额未知」：不置灰、不拦报名，只多一句提示。 -->
        <view wx:if="{{dayRows.length}}" class="seats">
          <block wx:for="{{dayRows}}" wx:key="date">
            <view wx:if="{{item.disabled}}" class="seat-row is-off">
              <text class="seat-day">{{item.label}}</text><text class="seat-left">{{item.seatsText}}</text>
            </view>
            <view wx:else class="seat-row {{draft.date === item.date ? 'is-on' : ''}}" data-date="{{item.date}}" bindtap="pickDay" role="button">
              <text class="seat-day">{{item.label}}</text><text class="seat-left">{{item.seatsText}}</text>
            </view>
          </block>
        </view>
        <view wx:elif="{{seatsUnknown}}" class="seat-hint">{{L.rt_seats_unknown}}</view>

        <view class="plan-label">{{L.rt_drawer_how}}</view>
        <view class="plan-transports">
          <view class="transport {{draft.transport === 'self' ? 'is-on' : ''}}" data-value="self" bindtap="pickTransport">{{L.rt_transport_self}}</view>
          <view class="transport {{draft.transport === 'share' ? 'is-on' : ''}}" data-value="share" bindtap="pickTransport">{{L.rt_transport_share}}</view>
          <view class="transport {{draft.transport === 'public' ? 'is-on' : ''}}" data-value="public" bindtap="pickTransport">{{L.rt_transport_public}}</view>
        </view>
      </scroll-view>
      <view class="plan-actions">
        <view class="ticket-btn ticket-btn-primary" bindtap="confirmTicket">{{L.rt_confirm}} →</view>
      </view>
    </view>
  </view>
</view>

<!-- 自绘日期面板（2026-10-08）：照 iOS 原生样式，取消/确定在顶部，避免被底部 tabBar 压住 -->
<view wx:if="{{dateSheetOpen}}" class="date-mask" catchtouchmove="noop" bindtap="cancelDateSheet">
  <view class="date-sheet" catchtap="noop">
    <view class="date-head">
      <view class="date-cancel" bindtap="cancelDateSheet">{{L.picker_cancel}}</view>
      <view class="date-ok" bindtap="confirmDateSheet">{{L.picker_ok}}</view>
    </view>
    <picker-view class="date-picker" indicator-class="date-ind" value="{{dateSheetIndex}}" bindchange="onDateSheetChange">
      <picker-view-column><view wx:for="{{dateRange[0]}}" wx:key="*this" class="date-item">{{item}}</view></picker-view-column>
      <picker-view-column><view wx:for="{{dateRange[1]}}" wx:key="*this" class="date-item">{{item}}</view></picker-view-column>
      <picker-view-column><view wx:for="{{dateRange[2]}}" wx:key="*this" class="date-item">{{item}}</view></picker-view-column>
    </picker-view>
  </view>
</view>

<!-- 自绘时间面板（2026-10-08）：与日期面板同款样式（取消 / 确定），时 0-23、分 0-59 每 1 分钟 -->
<view wx:if="{{timeSheetOpen}}" class="date-mask" catchtouchmove="noop" bindtap="cancelTimeSheet">
  <view class="date-sheet" catchtap="noop">
    <view class="date-head">
      <view class="date-cancel" bindtap="cancelTimeSheet">{{L.picker_cancel}}</view>
      <view class="date-ok" bindtap="confirmTimeSheet">{{L.picker_ok}}</view>
    </view>
    <picker-view class="date-picker" indicator-class="date-ind" value="{{timeSheetIndex}}" bindchange="onTimeSheetChange">
      <picker-view-column><view wx:for="{{timeRange[0]}}" wx:key="*this" class="date-item">{{item}}</view></picker-view-column>
      <picker-view-column><view wx:for="{{timeRange[1]}}" wx:key="*this" class="date-item">{{item}}</view></picker-view-column>
    </picker-view>
  </view>
</view>
