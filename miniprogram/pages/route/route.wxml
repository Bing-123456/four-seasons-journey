<view class="route-screen {{fontClass}}">
  <demo-notice id="demo-mode-notice"/>
  <view class="rt-header">
    <view class="rt-title">{{routeTitle}}</view>
    <me-entry/>
  </view>

  <scroll-view class="rt-terms" scroll-x>
    <view wx:for="{{terms}}" wx:key="*this"
      class="rt-term {{item === currentTerm ? 'active' : ''}}"
      data-term="{{item}}" bindtap="selectTerm">{{item}}</view>
  </scroll-view>

  <view class="rt-map-wrap">
    <map class="rt-map" latitude="{{mapCenter.latitude}}" longitude="{{mapCenter.longitude}}" scale="{{mapScale}}"
      markers="{{markers}}" bindmarkertap="onMarkerTap" show-location="{{false}}"></map>
    <view class="rt-map-cap">{{currentTerm}} · 全国果乡（{{fruitTowns.length}} 个）</view>
  </view>

  <view wx:if="{{error}}" class="rt-error">{{error}}</view>

  <view class="rt-list">
    <view wx:for="{{fruitTowns}}" wx:key="id"
      class="rt-card {{item.id === highlightId ? 'highlight' : ''}}"
      data-id="{{item.id}}" bindtap="openTown">
      <view class="rt-card-head">
        <view class="rt-card-name">{{item.name}}</view>
        <view class="rt-fav {{favorited[item.id] ? 'on' : ''}}" data-id="{{item.id}}" catchtap="toggleFavorite">{{favorited[item.id] ? '♥ 已收藏' : '♡ 收藏'}}</view>
      </view>
      <view class="rt-card-tag">【{{item.term}} · {{item.fruit}}】</view>
      <view class="rt-card-foot">
        <view class="rt-card-exps">
          <text wx:for="{{item.experiences}}" wx:for-item="exp" wx:key="*this" class="rt-exp">{{exp}}</text>
        </view>
        <view class="rt-dist">{{item.distanceText}}</view>
      </view>
    </view>
    <view wx:if="{{!loading && fruitTowns.length === 0}}" class="rt-empty">{{L.rt_empty}}</view>
  </view>

  <view wx:if="{{selectedTown}}" class="rt-popup-mask" bindtap="closePopup"></view>
  <view wx:if="{{selectedTown}}" class="rt-popup">
    <view class="rt-popup-head">
      <view class="rt-card-name">{{selectedTown.name}}</view>
      <view class="rt-popup-close" bindtap="closePopup" aria-label="关闭">×</view>
    </view>
    <view class="rt-card-tag">【{{selectedTown.term}} · {{selectedTown.fruit}}】</view>
    <view class="rt-card-foot">
      <view class="rt-card-exps">
        <text wx:for="{{selectedTown.experiences}}" wx:for-item="exp" wx:key="*this" class="rt-exp">{{exp}}</text>
      </view>
      <view class="rt-dist">{{selectedTown.distanceText}}</view>
    </view>
    <view class="rt-popup-open" data-id="{{selectedTown.id}}" bindtap="openTown">{{L.rt_view_detail}} →</view>
  </view>
</view>
