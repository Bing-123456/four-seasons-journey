page{height:100%;overflow:hidden;background:#F5F5F7}.route-screen{height:100vh;box-sizing:border-box;padding-bottom:calc(130rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;overflow:hidden}.route-screen>demo-notice{flex-shrink:0}.route-body{flex:1;min-height:0;display:flex;flex-direction:column;gap:18rpx;padding:20rpx 32rpx 14rpx;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.route-header{display:flex;align-items:center;justify-content:space-between;gap:20rpx;flex-shrink:0}.route-title{font-size:48rpx;line-height:1.2;letter-spacing:-1rpx;font-weight:700;color:#192A23;min-width:0}.route-adjust{width:auto!important;flex-shrink:0;margin:0!important;background:#E8EDE8;color:#234B3C;border-radius:30rpx;font-size:23rpx;font-weight:600;line-height:1.4;padding:14rpx 22rpx}.route-brief{display:flex;align-items:center;justify-content:space-between;gap:16rpx;flex-shrink:0;line-height:1.5}.brief-date{font-size:23rpx;color:#717875;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.brief-time{font-size:25rpx;font-weight:600;letter-spacing:-.4rpx;color:#273D32;white-space:nowrap;font-variant-numeric:tabular-nums}.route-intro{font-size:24rpx;line-height:1.5;color:#777E79;flex-shrink:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.route-map-card{flex:1;min-height:0;display:flex;flex-direction:column;background:#FFFFFF;border-radius:30rpx;overflow:hidden;border:1rpx solid #E9EBE8}.map-stage{flex:1;min-height:0;position:relative;background:#E9EDE6}.route-map{position:absolute;inset:0;width:100%;height:100%;display:block}.map-caption{flex-shrink:0;padding:13rpx 18rpx;color:#7C817E;font-size:20rpx;line-height:1.5;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.map-empty{height:100%;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12rpx;padding:24rpx;font-size:24rpx;color:#708073;text-align:center}.map-empty-mark{font-size:60rpx;color:#95A28F}.current-stop{display:flex;align-items:center;gap:18rpx;flex-shrink:0;background:#FFFFFF;border-radius:24rpx;padding:22rpx;border:1rpx solid #E9EBE8}.current-number{width:54rpx;height:54rpx;line-height:54rpx;text-align:center;font-size:25rpx;font-weight:700;color:#234B3C;background:#EDF2ED;border-radius:16rpx;flex-shrink:0}.current-copy{flex:1;min-width:0}.current-name{font-size:29rpx;line-height:1.4;font-weight:650;color:#22352C;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.current-meta{font-size:21rpx;line-height:1.5;color:#848984;margin-top:6rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.current-nav{width:auto!important;max-width:146rpx;margin:0!important;flex-shrink:0;background:#F3F5F2;border-radius:20rpx;padding:14rpx 18rpx;font-size:22rpx;line-height:1.5;font-weight:600;color:#234B3C}.route-primary{display:flex;align-items:center;justify-content:center;gap:24rpx;flex-shrink:0;width:100%!important;margin:0!important;padding:22rpx 26rpx;background:#234B3C;border-radius:23rpx;color:#FFFFFF;font-size:27rpx;font-weight:650;line-height:1.5}.route-primary text{margin-left:auto}.route-footnote{flex-shrink:0;font-size:20rpx;line-height:1.4;text-align:center;color:#929790;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.route-empty-actions{flex-shrink:0;display:flex;flex-direction:column;gap:15rpx}.empty-title{font-size:29rpx;font-weight:650;line-height:1.5;color:#253B2E}.route-empty-copy{font-size:24rpx;line-height:1.5;color:#778172;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.route-secondary{width:100%!important;margin:0!important;background:transparent;color:#4C6959;font-size:22rpx;line-height:1.5;padding:6rpx 12rpx}.route-error{flex-shrink:0;color:#A64F3B;background:#FBEBE7;padding:10rpx 16rpx;border-radius:14rpx;font-size:21rpx;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
