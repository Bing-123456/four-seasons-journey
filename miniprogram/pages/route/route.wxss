.route-screen {
  min-height: 100vh;
  background: #F5F5F7;
  padding-bottom: 40rpx;
}
.rt-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 12rpx;
}
.rt-title {
  font-size: calc(48rpx * var(--fs-scale, 1));
  font-weight: 700;
  color: #1D1D1F;
}
.rt-journal-btn {
  font-size: calc(26rpx * var(--fs-scale, 1));
  color: #3C9D6E;
  padding: 8rpx 18rpx;
  border: 1rpx solid #3C9D6E;
  border-radius: 999rpx;
}
.rt-terms {
  white-space: nowrap;
  padding: 8rpx 16rpx 16rpx;
}
.rt-term {
  display: inline-block;
  font-size: calc(26rpx * var(--fs-scale, 1));
  color: #5b6b5f;
  padding: 10rpx 22rpx;
  margin: 0 8rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
}
.rt-term.active {
  background: #3C9D6E;
  color: #FFFFFF;
}
.rt-map-wrap {
  margin: 8rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  background: #FFFFFF;
  box-shadow: 0 6rpx 18rpx rgba(35, 75, 60, 0.06);
}
.rt-map {
  width: 100%;
  height: 480rpx;
}
.rt-map-cap {
  font-size: calc(24rpx * var(--fs-scale, 1));
  color: #798479;
  padding: 12rpx 20rpx;
  border-top: 1rpx solid #EEF1EE;
}
.rt-error {
  margin: 16rpx 24rpx 0;
  font-size: calc(24rpx * var(--fs-scale, 1));
  color: #b06a3a;
  background: #fdf3e7;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
}
.rt-list {
  padding: 20rpx 24rpx 0;
}
.rt-card {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(35, 75, 60, 0.05);
}
.rt-card.highlight {
  outline: 2rpx solid #3C9D6E;
}
.rt-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.rt-card-name {
  font-size: calc(32rpx * var(--fs-scale, 1));
  font-weight: 600;
  color: #234B3C;
}
.rt-fav {
  font-size: calc(24rpx * var(--fs-scale, 1));
  color: #b03a4a;
  padding: 6rpx 14rpx;
  border: 1rpx solid #e7c4c4;
  border-radius: 999rpx;
}
.rt-fav.on {
  background: #b03a4a;
  color: #FFFFFF;
  border-color: #b03a4a;
}
.rt-card-tag {
  font-size: calc(24rpx * var(--fs-scale, 1));
  color: #3C9D6E;
  margin-top: 8rpx;
}
.rt-card-desc {
  font-size: calc(26rpx * var(--fs-scale, 1));
  color: #4a554c;
  margin-top: 10rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.rt-card-exps {
  margin-top: 12rpx;
}
.rt-exp {
  display: inline-block;
  font-size: calc(22rpx * var(--fs-scale, 1));
  color: #5b6b5f;
  background: #eef3ee;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  margin: 0 10rpx 0 0;
}
.rt-empty {
  text-align: center;
  color: #9aa39e;
  font-size: calc(26rpx * var(--fs-scale, 1));
  padding: 60rpx 0;
}
.rt-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.rt-card-foot .rt-card-exps {
  margin-top: 0;
}
.rt-dist {
  font-size: calc(22rpx * var(--fs-scale, 1));
  color: #9aa39e;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.rt-popup-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.32);
  z-index: 90;
}
.rt-popup {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 10rpx 40rpx rgba(35, 75, 60, 0.16);
  z-index: 100;
}
.rt-popup-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.rt-popup-close {
  font-size: calc(40rpx * var(--fs-scale, 1));
  color: #9aa39e;
  line-height: 1;
  padding: 0 8rpx;
}
.rt-popup-open {
  margin-top: 16rpx;
  text-align: center;
  color: #3C9D6E;
  font-size: calc(26rpx * var(--fs-scale, 1));
  font-weight: 600;
}
