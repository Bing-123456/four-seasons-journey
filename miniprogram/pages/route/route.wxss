/* 行程页 · 票夹（第 9 轮按 mockups/final-design-3pages.html 第⑤⑥⑦屏重排版式，2026-10-07）
   数值只用设计图写过的：主色 #234B3C / 暖纸 #FFFDF8 / 页底 #F5F5F7 / 米金 #F3E3C8·#8A6A2E /
   正文 #1D1D1F / 次要 #6F7C70 / 红章 #B03A4A；票目的地 21px、票信息行 11.5px；
   票与卡片圆角 14px、待用票行卡 12px、按钮 9–11px、抽屉顶部 18px。文字沿用 --fs-scale。 */
page{background: #F5F5F7}
.route-screen{min-height:100vh;padding:0 34rpx calc(132rpx + env(safe-area-inset-bottom));box-sizing:border-box;display:flex;flex-direction:column}
.route-head{flex-shrink:0;display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:24rpx 0 12rpx}
.route-title{font-size: calc(48rpx * var(--fs-scale, 1));font-weight:750;letter-spacing:-1.5rpx;color: #1D1D1F;line-height:1.25}
.route-head-actions{flex-shrink:0;display:flex;align-items:center;gap:8rpx}
.route-scroll{flex:1;min-height:0;padding-bottom:20rpx}
.route-error{font-size: calc(23rpx * var(--fs-scale, 1));color: #47634B;line-height:1.6;margin-top:20rpx}

/* 板块小标题：12.5px 粗体 + 左侧 3px 竖条（设计稿 .sec-t） */
.seg-label{display:flex;align-items:center;gap:10rpx;font-size: calc(26rpx * var(--fs-scale, 1));font-weight:750;color: #234B3C;line-height:1.4;margin:26rpx 0 12rpx}
.seg-label::before{content:"";width:6rpx;height:24rpx;border-radius:4rpx;background: #234B3C}

/* ① 下一张票：深绿票卡（设计稿 .ticket） */
.ticket-next{border-radius: 28rpx;overflow:hidden;box-shadow: 0 4rpx 20rpx rgba(29,37,32,.06)}
.tn-top{position:relative;background: linear-gradient(150deg,#234B3C,#47634B);color: #FFF9DF;padding:26rpx 30rpx 22rpx}
.tn-k{font-size: calc(19rpx * var(--fs-scale, 1));color: #F3E3C8;letter-spacing:2.8rpx}
.tn-chip{position:absolute;right:26rpx;top:24rpx;font-size: calc(21rpx * var(--fs-scale, 1));font-weight:700;color: #234B3C;background: #F3E3C8;border-radius:999rpx;padding:6rpx 16rpx}
.tn-dest{font-size: calc(38rpx * var(--fs-scale, 1));font-weight:750;color: #FFF9DF;line-height:1.3;margin-top:10rpx;letter-spacing:.5rpx;overflow-wrap:anywhere}
.tn-rows{margin-top:16rpx}
.tn-row{display:flex;align-items:baseline;gap:16rpx;font-size: calc(23rpx * var(--fs-scale, 1));color: #F0ECDE;margin-top:8rpx}
.tn-key{flex-shrink:0;width:104rpx;color: #F3E3C8}
.tn-val{color: #FFF9DF;font-weight:650}
/* 撕票口：把票面与票根分开（设计稿 .perf） */
.tn-perf{height:22rpx;background: linear-gradient(#234B3C,#FFFDF8);position:relative}
.tn-perf::before,.tn-perf::after{content:"";position:absolute;top:2rpx;width:26rpx;height:26rpx;border-radius:50%;background: #F5F5F7}
.tn-perf::before{left:-14rpx}
.tn-perf::after{right:-14rpx}
.tn-bottom{background: #FFFDF8;border: 1rpx solid #E1E5D9;border-top:0;padding:18rpx 28rpx 20rpx}

/* ② 待用的票：紧凑单行 + 距出发 chip（设计稿 .row-ticket） */
.row-ticket{background: #FFFDF8;border: 1rpx solid #E1E5D9;border-radius: 28rpx;padding:18rpx 24rpx;margin-bottom:14rpx;position:relative}
.row-ticket.is-open{padding-bottom:22rpx}
.row-ticket::before{content:"";position:absolute;left:-2rpx;top:50%;width:16rpx;height:32rpx;margin-top:-16rpx;background: #F5F5F7;border-radius:0 16rpx 16rpx 0}
.rt-main{display:flex;align-items:center;gap:16rpx}
.rt-left{flex:1;min-width:0}
.rt-name{font-size: calc(26rpx * var(--fs-scale, 1));font-weight:700;color: #234B3C;line-height:1.4;overflow-wrap:anywhere}
.rt-sub{font-size: calc(21rpx * var(--fs-scale, 1));color: #47634B;line-height:1.5;margin-top:6rpx;overflow-wrap:anywhere}
.rt-chip{flex-shrink:0;font-size: calc(19rpx * var(--fs-scale, 1));color: #47634B;background: #F7F5ED;border-radius:10rpx;padding:4rpx 12rpx}
.rt-arrow{flex-shrink:0;font-size: calc(26rpx * var(--fs-scale, 1));color: #87917B;line-height:1}

/* 展开后长出的三块（设计稿第⑦屏）：到了找谁 / 在哪儿 / 我的一行备注 */
.tk-more{border-top: 1rpx dashed #F0ECDE;margin-top:16rpx;padding-top:16rpx}
.tn-bottom .tk-more{border-top-color: #F0ECDE}
.tk-block{margin-bottom:16rpx}
.tk-block-t{font-size: calc(23rpx * var(--fs-scale, 1));font-weight:700;color: #234B3C;line-height:1.4}
.tk-block-x{font-size: calc(21rpx * var(--fs-scale, 1));color: #47634B;line-height:1.65;margin-top:6rpx;overflow-wrap:anywhere}
.tk-place{display:flex;align-items:center;gap:10rpx;background: #EAF0E0;border-radius: 18rpx;padding:20rpx 22rpx;margin-top:10rpx;font-size: calc(21rpx * var(--fs-scale, 1));color: #47634B;line-height:1.5}
.tk-place-pin{color:#B03A4A;font-size: calc(21rpx * var(--fs-scale, 1))}
.ticket-input{width:100%;box-sizing:border-box;background: #F5F5F7;border-radius: 18rpx;padding:16rpx 18rpx;font-size: calc(23rpx * var(--fs-scale, 1));color: #1D1D1F;line-height:1.5;margin-top:8rpx}
/* 动作按钮：9–11px 圆角 */
.ticket-actions{display:flex;gap:14rpx;margin-top:14rpx}
.ticket-btn{flex:1;margin:0;padding:0;border-radius: 28rpx;background: #F7F5ED;color: #2E4A38;font-size: calc(23rpx * var(--fs-scale, 1));line-height:84rpx;text-align:center;border:1rpx solid rgba(0,0,0,.06)}
.ticket-btn-primary{background: #234B3C;color: #FFF9DF;border-color: #234B3C;font-weight:650}
.ticket-btn-quiet{flex:0 0 96rpx;color: #47634B;background: #F7F5ED}
.ticket-empty{font-size: calc(23rpx * var(--fs-scale, 1));color: #87917B;line-height:1.6;padding:6rpx 0 4rpx}

/* ③ ＋ 排一张票（设计稿 .add） */
.add-ticket{display:flex;align-items:center;justify-content:center;gap:12rpx;margin:22rpx 0 4rpx;padding:26rpx;border-radius: 28rpx;background: #FFFDF8;border: 1rpx dashed #DCE5D0}
.add-sign{font-size: calc(32rpx * var(--fs-scale, 1));color: #2E4A38;line-height:1}
.add-text{font-size: calc(26rpx * var(--fs-scale, 1));font-weight:650;color: #2E4A38;line-height:1.4}

/* ④ 存根：红章「已去过」+ 日期（设计稿 .stub / .seal） */
.stub{display:flex;align-items:center;gap:18rpx;background: #F0ECDE;border: 1rpx solid #DCE5D0;border-radius: 28rpx;padding:18rpx 24rpx;margin-bottom:14rpx;position:relative}
.stub::before{content:"";position:absolute;left:0;right:0;top:-2rpx;height:8rpx;background: repeating-linear-gradient(135deg,#F5F5F7 0 8rpx,transparent 8rpx 16rpx)}
.stub-seal{flex-shrink:0;width:86rpx;height:86rpx;border: 3rpx solid #DCE5D0;border-radius:50%;color: #47634B;display:flex;flex-direction:column;align-items:center;justify-content:center;transform:rotate(-11deg);opacity:.9}
.seal-a{font-size: calc(19rpx * var(--fs-scale, 1));font-weight:700;letter-spacing:1rpx;line-height:1.2}
.seal-b{font-size: calc(19rpx * var(--fs-scale, 1));line-height:1.2;margin-top:2rpx}
.stub-main{flex:1;min-width:0}

/* ⑥ 排票抽屉：18px 圆角、暖纸底，背后是票夹原样 */
/* ★这个 z-index 必须保持"很低"（20）：微信自带日期/时间选择器的弹出层比它高，
   它俩才能盖在黑纱之上 —— 原来写成 500，把选择器顶上的「取消 / 确定」压住了，
   用户点不到确定（2026-10-09 修）。页面上其它内容没有层级，20 足够让抽屉浮在前面。
   顺带：底部 tabbar 是 99，所以抽屉打开时 tabbar 不再被压暗 —— 这是这个改法的已知代价。
   以后不要把它调大（调大就会重新压住「取消 / 确定」）。 */
.plan-mask{position:fixed;inset:0;z-index:20;background:rgba(10,24,18,.45);display:flex;align-items:flex-end}
.plan-sheet{width:100%;box-sizing:border-box;background: #FFFDF8;border-radius:36rpx 36rpx 0 0;padding:26rpx 34rpx calc(20rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;max-height:82vh;box-shadow:0 -10rpx 30rpx rgba(0,0,0,.28)}
.plan-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;flex-shrink:0}
.plan-title{font-size: calc(32rpx * var(--fs-scale, 1));font-weight:750;color: #234B3C;line-height:1.4}
/* 抽屉右上角：保存 + 关闭（保存和底部的「生成这张票」是同一个动作，放在这里随时点得到） */
.plan-head-actions{display:flex;align-items:center;gap:12rpx;flex-shrink:0}
.plan-save{font-size: calc(23rpx * var(--fs-scale, 1));font-weight:650;color: #FFF9DF;background: #234B3C;border-radius:999rpx;padding:10rpx 24rpx;line-height:1.4}
.plan-close{width:52rpx;height:52rpx;line-height:50rpx;text-align:center;border-radius:50%;background: #F7F5ED;color: #2E4A38;font-size: calc(26rpx * var(--fs-scale, 1));flex-shrink:0}
.plan-scroll{flex:1;min-height:0;margin-top:8rpx}
.plan-label{display:block;font-size: calc(21rpx * var(--fs-scale, 1));font-weight:700;color: #234B3C;line-height:1.5;margin:22rpx 0 10rpx}
/* 候选项：32px 缩略插画 + 名称 + 「地区 ｜ 节气·水果」+ 单选圈 */
.pool-row{display:flex;align-items:center;gap:18rpx;padding:16rpx 0;border-top: 1rpx dashed #EBEEE5}
.pool-row:first-child{border-top:0}
.pool-art{width:64rpx;height:64rpx;border-radius: 18rpx;background:#E7E9E2;flex-shrink:0}
.pool-main{flex:1;min-width:0}
.pool-name{font-size: calc(23rpx * var(--fs-scale, 1));font-weight:650;color: #234B3C;line-height:1.4;overflow-wrap:anywhere}
.pool-term{font-size: calc(19rpx * var(--fs-scale, 1));color: #87917B;line-height:1.4;margin-top:4rpx}
.pool-check{flex-shrink:0;width:32rpx;height:32rpx;line-height:30rpx;text-align:center;border-radius:50%;border: 2rpx solid #DCE5D0;color: #FFFDF8;font-size: calc(21rpx * var(--fs-scale, 1));box-sizing:border-box}
.pool-row.is-on .pool-check{background: #234B3C;border-color: #234B3C}
.pool-empty{font-size: calc(23rpx * var(--fs-scale, 1));color: #87917B;line-height:1.6;padding:14rpx 0}
/* 候选池说明 + 看全部园子的后门（设计稿 .filter-note） */
.filter-note{margin-top:14rpx;background: #F7F5ED;border-radius: 18rpx;padding:14rpx 18rpx;font-size: calc(19rpx * var(--fs-scale, 1));color: #47634B;line-height:1.6}
.filter-note .more{color: #234B3C;font-weight:650}
.plan-when{display:flex;gap:14rpx}
.plan-input{flex:1;background: #F5F5F7;border-radius: 28rpx;padding:18rpx;font-size: calc(23rpx * var(--fs-scale, 1));color: #1D1D1F;line-height:1.4;text-align:center}
.plan-transports{display:flex;gap:14rpx}
.transport{flex:1;text-align:center;padding:18rpx 0;border-radius: 28rpx;background: #F7F5ED;border:1rpx solid rgba(0,0,0,.06);font-size: calc(23rpx * var(--fs-scale, 1));color: #47634B;line-height:1.4}
.transport.is-on{background: #234B3C;color: #FFF9DF;border-color: #234B3C;font-weight:650}
.plan-actions{display:flex;gap:12rpx;margin-top:24rpx;flex-shrink:0}

/* 自绘日期面板：照 iOS 原生样式（顶部取消/确定，确定绿色；三列带中间指示带） */
.date-mask{position:fixed;inset:0;z-index:120;background:rgba(10,24,18,.35);display:flex;align-items:flex-end}
.date-sheet{width:100%;box-sizing:border-box;background:#FFFFFF;border-radius:28rpx 28rpx 0 0;padding-bottom:env(safe-area-inset-bottom)}
.date-head{display:flex;align-items:center;justify-content:space-between;padding:24rpx 34rpx;border-bottom:1rpx solid #EFEFEF}
.date-cancel{font-size:calc(30rpx * var(--fs-scale, 1));color:#4A4A4A;padding:8rpx 12rpx}
.date-ok{font-size:calc(30rpx * var(--fs-scale, 1));font-weight:600;color:#07C160;padding:8rpx 12rpx}
.date-picker{width:100%;height:440rpx}
.date-item{display:flex;align-items:center;justify-content:center;font-size:calc(30rpx * var(--fs-scale, 1));color:#1D1D1F;line-height:1.4}
.date-ind{height:74rpx;border-top:1rpx solid #EFEFEF;border-bottom:1rpx solid #EFEFEF}
