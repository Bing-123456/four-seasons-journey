.finder-page{padding:36rpx 32rpx calc(64rpx + env(safe-area-inset-bottom))}
.finder-head{position:relative;padding:28rpx 28rpx 30rpx;background:#ECEEDF;border:1rpx solid #DBE0CC;border-radius:24rpx;margin-bottom:34rpx;overflow:hidden}.finder-face{width:96rpx;height:96rpx;display:flex;align-items:center;justify-content:center;background:#FFFDF4;border-radius:50%;float:right;margin:0 0 14rpx 20rpx}.finder-title{font-size:calc(42rpx * var(--fs-scale, 1));line-height:1.5;color:#294A36;padding-top:4rpx;overflow-wrap:anywhere}.finder-sub{font-size:calc(24rpx * var(--fs-scale, 1));line-height:1.85;margin-top:15rpx;color:#6E7C60;overflow-wrap:anywhere}
.finder-question{margin:0 0 28rpx;padding:0 2rpx 28rpx;border-bottom:1rpx solid #E0DFD0}.finder-q-title{display:flex;align-items:baseline;gap:14rpx;font-size:calc(28rpx * var(--fs-scale, 1));line-height:1.65;font-weight:600;margin-bottom:20rpx;color:#314B37}.finder-q-number{font-family:Georgia,serif;font-size:calc(30rpx * var(--fs-scale, 1));color:#B47B5C;font-weight:400;flex-shrink:0}.finder-q-copy{flex:1;min-width:0;overflow-wrap:anywhere}.finder-multi{font-size:calc(20rpx * var(--fs-scale, 1));color:#849174;flex-shrink:0;font-weight:400}
.finder-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx}.finder-option{display:flex;align-items:center;flex-wrap:wrap;gap:8rpx 10rpx;min-width:0;min-height:84rpx;padding:17rpx 18rpx;background:#FFFDF7;border:1rpx solid #E0E1D3;border-radius:15rpx;font-size:calc(24rpx * var(--fs-scale, 1));line-height:1.6;color:#52664B}.finder-option.chosen{background:#E4EBD7;color:#294B35;border-color:#819969}.finder-check{display:flex;align-items:center;justify-content:center;width:25rpx;height:25rpx;flex-shrink:0;border:1rpx solid #C2CDB4;border-radius:7rpx;color:#FFFDF7;font-size:calc(19rpx * var(--fs-scale, 1))}.chosen .finder-check{background:#31563D;border-color:#31563D}.finder-option-name{flex:1;min-width:0;overflow-wrap:anywhere}.finder-season{width:100%;padding-left:35rpx;font-size:calc(19rpx * var(--fs-scale, 1));color:#879674;line-height:1.3}.chosen .finder-season{color:#65814F}
.finder-actions{display:flex;align-items:center;gap:14rpx;margin-top:4rpx}.finder-generate{flex:1;min-width:0}.finder-reset{font-size:calc(22rpx * var(--fs-scale, 1));line-height:1.5;color:#6B7B5E;background:#EEF3EF;padding:12rpx 20rpx;border-radius:14rpx;min-height:0;margin:0;flex:none}.finder-reset:after{border:0}.finder-note{font-size:calc(23rpx * var(--fs-scale, 1));line-height:1.8;color:#7B8069;margin-top:18rpx;padding:20rpx 22rpx;background:#F0EBDC;border-radius:15rpx;overflow-wrap:anywhere}.finder-result-title{font-family:inherit;font-size:calc(34rpx * var(--fs-scale, 1));line-height:1.5;color:#2E4B36;margin:38rpx 0 22rpx}.place-card{display:flex;gap:22rpx;background:#FFFDF7;border:1rpx solid #E2E2D4;border-radius:22rpx;padding:18rpx;margin-bottom:18rpx}.place-photo{width:170rpx;height:186rpx;border-radius:14rpx;flex-shrink:0;background:#EAF0DF;object-fit:cover}.place-photo-wrap{position:relative;flex-shrink:0}.place-photo-tag{position:absolute;left:10rpx;bottom:10rpx;font-size:calc(18rpx * var(--fs-scale, 1));line-height:1.5;color:#FFF;background:rgba(46,74,56,.75);border-radius:8rpx;padding:2rpx 10rpx}.place-photo-fallback{display:flex;align-items:center;justify-content:center;font-size:calc(60rpx * var(--fs-scale, 1));color:#8C7954;background:#F0E9D8;border:1rpx solid #E4DCC5}.place-copy{flex:1;min-width:0;padding:4rpx 0}.place-name{font-family:inherit;font-size:calc(29rpx * var(--fs-scale, 1));font-weight:600;color:#304D36;line-height:1.55;overflow-wrap:anywhere}.place-intro{font-size:calc(23rpx * var(--fs-scale, 1));color:#718164;line-height:1.85;margin-top:12rpx;overflow-wrap:anywhere}
/* Shared app typography and quiet, readable result states. */
.finder-head{background:#FFF;border-color:#E8E8ED}.finder-option{background:#FFF;border-color:#E5E5EA}.finder-option.chosen{background:#EBF2EC;border-color:#779383}.finder-q-number{font-family:inherit;font-weight:600}.place-card{background:#FFF;border-color:#E8E8ED;align-items:flex-start}.place-photo{height:210rpx}.place-photo-fallback{padding:18rpx;box-sizing:border-box;font-family:inherit;font-size:calc(21rpx * var(--fs-scale, 1));line-height:1.6;text-align:center;background:#F2F2F7;color:#7B7F85;border:0}.finder-virtual{font-size:calc(23rpx * var(--fs-scale, 1));font-weight:600;line-height:1.65;color:#345644;margin-top:-8rpx}.finder-season-note{font-size:calc(21rpx * var(--fs-scale, 1));color:#8A8A8E;line-height:1.7;margin:10rpx 0 22rpx}.place-season{font-size:calc(20rpx * var(--fs-scale, 1));color:#6F7974;line-height:1.65;margin-top:13rpx}.place-months{font-size:calc(19rpx * var(--fs-scale, 1));color:#8A8A8E;line-height:1.6;margin-top:5rpx}.place-retry,.finder-resume{font-size:calc(22rpx * var(--fs-scale, 1));line-height:1.5;color:#315B45;background:#EEF3EF;padding:12rpx 18rpx;border-radius:14rpx;min-height:0;margin:14rpx 0 0}.place-retry:after,.finder-resume:after{border:0}
