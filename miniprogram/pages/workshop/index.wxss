-top:23rpx;margin-top:31rpx;display:flex;justify-content:space-between;font-size:calc(22rpx * var(--fs-scale, 1));color:#7E8E6D;letter-spacing:3rpx}.read-note{margin-top:16rpx}.next-story{border-top:1rpx solid #DFE3D4;margin-top:35rpx;padding-top:28rpx}.next-story .eyebrow{font-size:calc(18rpx * var(--fs-scale, 1));letter-spacing:2rpx}.next-title{font-size:calc(34rpx * var(--fs-scale, 1));margin-top:9rpx}.next-description{font-size:calc(23rpx * var(--fs-scale, 1));color:#8B907F;line-height:1.9;margin:10rpx 0}.next-link{color:#31573F;font-size:calc(24rpx * var(--fs-scale, 1))}.feedback{font-size:calc(24rpx * var(--fs-scale, 1));color:#8C7550;background:#F0EAD9;border-radius:14rpx;padding:18rpx 22rpx;line-height:1.8;margin:20rpx 0}.feedback.success{color:#436346;background:#E8EFDF}.feedback.retry{color:#A5684C;background:#F5EBDD}.error-message{font-size:calc(24rpx * var(--fs-scale, 1));color:#AA5C47;line-height:1.8;background:#F3E6DB;padding:20rpx;border-radius:12rpx;margin:20rpx 0}.chapter-actions{margin-top:26rpx}.bottom-links{display:flex;justify-content:space-between;align-items:center;margin-top:21rpx}.source-link{margin-left:auto}.lesson-footnote{text-align:center;color:#9A9E8E;font-size:calc(20rpx * var(--fs-scale, 1));line-height:1.9;margin-top:32rpx}.all-sources{display:block;text-align:center;font-size:calc(20rpx * var(--fs-scale, 1));color:#8D9785;margin:7rpx auto 0}.sources-mask{position:fixed;inset:0;background:rgba(27,42,30,.44);z-index:50;display:flex;align-items:flex-end}.sources-sheet{width:100%;padding:31rpx 34rpx 28rpx;border-radius:28rpx 28rpx 0 0;background:#F7F5ED;max-height:80vh}.sources-heading{display:flex;justify-content:space-between;align-items:center;font-size:calc(32rpx * var(--fs-scale, 1))}.sources-intro{font-size:calc(23rpx * var(--fs-scale, 1));color:#8A927F;line-height:1.8;margin:16rpx 0}.sources-scroll{max-height:51vh}.source-item{padding:24rpx 0;border-top:1rpx solid #DFE2D4}.source-publisher{color:#87927B;font-size:calc(21rpx * var(--fs-scale, 1))}.source-title{font-size:calc(26rpx * var(--fs-scale, 1));line-height:1.8;margin:8rpx 0 14rpx}.source-copy{display:inline-block;font-size:calc(22rpx * var(--fs-scale, 1));color:#395B3F;background:#E7ECDB;padding:12rpx 22rpx;border-radius:10rpx;line-height:1.5}

/* Explicit sizing avoids the native v2 button preset narrowing grid cells. */
.workshop-page .text-button{width:auto;margin:0}.workshop-page .ingredient-card,.workshop-page .answer-option{width:100%;margin:0}.workshop-page .process-tab{width:auto;margin:0;min-width:0}.workshop-page .all-sources{width:100%;margin:7rpx 0 0}.sources-sheet .text-button,.sources-sheet .source-copy{width:auto;margin:0}.workshop-page button::after,.sources-sheet button::after{border:0}

/* The lesson reads as a small field notebook, with quiet material studies. */
.workshop-page{padding:28rpx 36rpx calc(40rpx + env(safe-area-inset-bottom))}
.masthead{gap:20rpx;align-items:flex-start}
.masthead .eyebrow{font-size:calc(20rpx * var(--fs-scale, 1));line-height:1.8}
.masthead .text-button{flex-shrink:0;max-width:260rpx;text-align:right;line-height:1.6}
.lesson-intro{padding:28rpx 0 26rpx}
.location{font-size:calc(21rpx * var(--fs-scale, 1));color:#9D7F57;line-height:1.7;letter-spacing:2rpx}
.lesson-title{font-size:calc(54rpx * var(--fs-scale, 1));line-height:1.4;letter-spacing:1rpx;margin-top:14rpx;color:#234B3C}
.lesson-subtitle{font-size:calc(24rpx * var(--fs-scale, 1));line-height:1.8;color:#839078;margin-top:12rpx}
.lesson-progress{gap:12rpx;margin:4rpx 0 30rpx}
.progress-segment{min-width:0;font-size:calc(21rpx * var(--fs-scale, 1));line-height:1.7;border-top-width:3rpx}
.progress-segment text{color:#A3845B;font-size:calc(21rpx * var(--fs-scale, 1))}
.chapter-heading{font-size:calc(36rpx * var(--fs-scale, 1));line-height:1.55;letter-spacing:0}
.chapter-description{font-size:calc(25rpx * var(--fs-scale, 1));line-height:1.85;color:#75836B}
.choose-heading{gap:18rpx;align-items:center;margin:26rpx 0 18rpx;line-height:1.7}
.selection-count{flex-shrink:0;color:#A3845B}
.ingredients-grid{gap:16rpx;grid-template-columns:repeat(2,minmax(0,1fr))}
.ingredient-card{border:2rpx solid transparent;border-radius:22rpx;background:#FFFCF5;padding:18rpx 14rpx 24rpx;box-shadow:0 5rpx 18rpx rgba(35,75,60,.025)}
.ingredient-card.selected{background:#EFF2E5;border-color:#8D9E78}
.ingredient-art{height:126rpx;margin:12rpx 0 18rpx;background:radial-gradient(ellipse at center,#F0EBDC 0%,#F0EBDC 55%,transparent 56%)}
.ingredient-name{font-size:calc(29rpx * var(--fs-scale, 1));line-height:1.55}
.ingredient-detail{font-size:calc(21rpx * var(--fs-scale, 1));line-height:1.7;color:#859078}
.ingredient-check{top:14rpx;right:14rpx;font-size:calc(22rpx * var(--fs-scale, 1));z-index:1}
.melon-half{box-shadow:0 8rpx 14rpx rgba(125,101,59,.12)}
.melon-inner{background:#D78065;border-color:#E5DFAD}
.apple-shape{background:#C67F64;box-shadow:inset -12rpx -4rpx #B26954,0 9rpx 12rpx rgba(125,101,59,.1)}
.rice-body{background:#A2B299;box-shadow:inset -10rpx 0 #8EA187,0 8rpx 12rpx rgba(125,101,59,.09)}
.quiet-note{font-size:calc(21rpx * var(--fs-scale, 1));line-height:1.85;color:#8A8C78;margin:18rpx 0 24rpx}
.process-tabs{gap:8rpx;margin:24rpx 0 18rpx;background:#EAEDE1;padding:6rpx;border-radius:16rpx}
.process-tab{flex-direction:column;gap:3rpx;min-height:78rpx;border:0;border-radius:11rpx;background:transparent;font-size:calc(24rpx * var(--fs-scale, 1));line-height:1.45;padding:10rpx 5rpx}
.process-tab-number{font-size:calc(17rpx * var(--fs-scale, 1));line-height:1.2;letter-spacing:1rpx}
.process-card{border:0;border-radius:24rpx;box-shadow:0 6rpx 22rpx rgba(35,75,60,.035)}
.process-illustration{height:250rpx;background:#EEE8D8}
.art-horizon{bottom:37rpx;border-color:#D7CEB8}
.sauce-pot{top:70rpx}
.pot-body{background:#AE8969;box-shadow:inset -23rpx -6rpx #957252,0 9rpx 15rpx rgba(92,70,39,.12)}
.pot-rim{background:#C8A583}
.pot-content{background:#6D5C43;box-shadow:inset 0 4rpx 5rpx rgba(60,40,20,.15)}
.art-sun{width:62rpx;height:62rpx;right:78rpx;background:#D6B074;box-shadow:0 0 0 10rpx #E4CD9F,0 0 0 22rpx rgba(224,209,175,.55)}
.art-label{font-size:calc(18rpx * var(--fs-scale, 1));letter-spacing:1rpx;color:#96876A}
.process-reading{padding:26rpx 28rpx 28rpx}
.process-title{flex-wrap:wrap;gap:8rpx 18rpx;font-size:calc(36rpx * var(--fs-scale, 1));line-height:1.5}
.process-title text{font-size:calc(22rpx * var(--fs-scale, 1));line-height:1.7}
.process-text{font-size:calc(26rpx * var(--fs-scale, 1));line-height:1.9}
.process-note{font-size:calc(22rpx * var(--fs-scale, 1));line-height:1.85;color:#93876D}
.answer-option{border:2rpx solid transparent;background:#FFFCF5;padding:22rpx;font-size:calc(26rpx * var(--fs-scale, 1));line-height:1.8}
.answer-option.selected{border-color:#91A27C;background:#E9EFDE}
.finish-card{padding:32rpx 28rpx;background:#E9EEDC;border-radius:24rpx}
.finish-title{font-size:calc(40rpx * var(--fs-scale, 1));line-height:1.55}
.finish-summary{font-size:calc(25rpx * var(--fs-scale, 1));line-height:1.9}
.finish-location{flex-wrap:wrap;gap:12rpx;line-height:1.7;letter-spacing:1rpx;padding-top:22rpx;margin-top:26rpx}
.next-title{font-size:calc(32rpx * var(--fs-scale, 1));line-height:1.6}
.next-description{font-size:calc(24rpx * var(--fs-scale, 1));line-height:1.85}
.lesson-footnote{font-size:calc(20rpx * var(--fs-scale, 1));color:#919782;margin-top:26rpx}
