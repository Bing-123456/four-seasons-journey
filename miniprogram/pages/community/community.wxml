<demo-notice id="demo-mode-notice"/>
<view class="page community-page {{fontClass}}">
  <!-- 顶部横幅：米黄底 + 现有果园插画 + 标题（评审 10.5：白底太秃，统一小程序米黄基调） -->
  <view class="community-banner">
    <image class="community-banner-art" src="/assets/illustrations/orchard-garden.jpg" mode="aspectFill" aria-hidden="true"/>
    <view class="community-banner-copy">
      <view class="community-banner-title serif">{{L.community_title}}</view>
      <view class="community-banner-sub">{{L.community_banner_sub}}</view>
    </view>
  </view>
  <view wx:if="{{loading}}" class="state-tip">{{L.loading}}</view>
  <view wx:elif="{{error}}" class="state-tip error">{{error}}</view>
  <view wx:elif="{{!posts.length}}" class="state-tip empty-state">
    <view class="empty-glyph serif" aria-hidden="true">🌾</view>
    <view class="empty-text">{{L.community_empty}}</view>
  </view>
  <view wx:else class="feed-list">
    <view wx:for="{{posts}}" wx:key="_id" class="feed-item" data-id="{{item._id}}" bindtap="goDetail" role="button" aria-label="查看这条动态的详情">
      <view class="feed-head">
        <image class="feed-avatar" src="{{item.avatar || '/assets/illustrations/avatar-default.jpg'}}" mode="aspectFill" aria-hidden="true"/>
        <view class="feed-head-copy">
          <view class="feed-name">{{item.nickname}}</view>
          <view wx:if="{{item.timeText}}" class="feed-time">{{item.timeText}}</view>
        </view>
      </view>
      <image wx:if="{{item.image}}" class="feed-image" src="{{item.image}}" mode="aspectFill" aria-hidden="true"/>
      <view wx:if="{{item.text}}" class="feed-text">{{item.text}}</view>
      <view class="feed-actions">
        <view class="feed-action {{item.liked ? 'on' : ''}}" data-id="{{item._id}}" catchtap="toggleLike" role="button" aria-label="{{item.liked ? '已赞' : '点赞'}}">{{item.liked ? '♥' : '♡'}} {{item.likes || 0}}</view>
        <view class="feed-action" data-id="{{item._id}}" catchtap="addComment" role="button" aria-label="评论">评论 {{item.comments.length || 0}}</view>
      </view>
      <!-- 评论区（微信朋友圈样式）：灰底块、昵称+冒号+内容；点昵称即回复该人 -->
      <view wx:if="{{item.comments.length}}" class="feed-comments" catchtap="goDetail" data-id="{{item._id}}">
        <view wx:for="{{item.comments}}" wx:for-item="c" wx:key="index" class="feed-comment" data-id="{{item._id}}" data-reply-to="{{c.nickname}}" catchtap="addComment">
          <text class="fc-name">{{c.nickname}}</text><text wx:if="{{c.replyTo}}" class="fc-reply-text"> 回复 <text class="fc-name">{{c.replyTo}}</text></text><text class="fc-text">：{{c.text}}</text>
        </view>
      </view>
    </view>
  </view>
  <view class="community-fab" bindtap="goPost" role="button" aria-label="{{L.community_post_title}}">＋</view>
</view>
