page { background: #F7F5ED; }
.community-page { padding: 24rpx 32rpx calc(60rpx + env(safe-area-inset-bottom)); min-height: 0; }
/* 顶部横幅：横版插画 + 标题（评审 10.5：白底太秃，换米黄基调 + 现有果园插画） */
.community-banner { position: relative; height: 220rpx; border-radius: 22rpx; overflow: hidden; margin-bottom: 24rpx; box-shadow: 0 4rpx 18rpx rgba(29,37,32,.06); }
.community-banner-art { position: absolute; inset: 0; width: 100%; height: 100%; }
.community-banner-copy { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; padding: 20rpx 26rpx; background: linear-gradient(180deg, rgba(247,245,237,0) 30%, rgba(29,37,32,.62) 100%); }
.community-banner-title { font-size: calc(36rpx * var(--fs-scale, 1)); font-weight: 700; color: #FFFDF8; letter-spacing: 1rpx; }
.community-banner-sub { font-size: calc(22rpx * var(--fs-scale, 1)); color: rgba(255,253,248,.88); margin-top: 6rpx; }
.state-tip { color: #6e6e73; font-size: calc(25rpx * var(--fs-scale, 1)); line-height: 1.7; text-align: center; padding: 80rpx 0; }
.state-tip.error { color: #a43c35; }
.empty-state { padding: 120rpx 40rpx; }
.empty-glyph { font-size: calc(88rpx * var(--fs-scale, 1)); line-height: 1; margin-bottom: 24rpx; }
.empty-text { color: #8B948C; }
.feed-list { display: flex; flex-direction: column; gap: 22rpx; }
.feed-item { background: #FFFFFF; border-radius: 22rpx; padding: 24rpx 26rpx; box-shadow: 0 4rpx 18rpx rgba(29,37,32,.04); }
.feed-head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 18rpx; }
.feed-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: #EAF0E0; flex-shrink: 0; }
.feed-head-copy { min-width: 0; }
.feed-name { font-size: calc(28rpx * var(--fs-scale, 1)); color: #234B3C; font-weight: 600; line-height: 1.4; }
.feed-time { font-size: calc(21rpx * var(--fs-scale, 1)); color: #9AA39A; margin-top: 4rpx; }
.feed-image { width: 100%; height: 360rpx; border-radius: 14rpx; background: #EEEADF; }
.feed-text { font-size: calc(27rpx * var(--fs-scale, 1)); color: #344B36; line-height: 1.7; margin-top: 14rpx; }
.feed-actions { display: flex; gap: 30rpx; margin-top: 16rpx; }
.feed-action { font-size: calc(24rpx * var(--fs-scale, 1)); color: #8B948C; padding: 6rpx 0; }
.feed-action.on { color: #C0392B; }
.feed-comments { margin-top: 14rpx; background: #F5F6F3; border-radius: 12rpx; padding: 14rpx 18rpx; }
.feed-comment { font-size: calc(23rpx * var(--fs-scale, 1)); color: #34403A; line-height: 1.65; padding: 2rpx 0; }
.fc-name { color: #4F6B45; font-weight: 600; }
.fc-reply-text { color: #6E7A6F; }
.fc-text { color: #34403A; }
/* 右下角浮动「+」按钮：墨绿圆底 + 白色加号 */
.community-fab { position: fixed; right: 32rpx; bottom: calc(48rpx + env(safe-area-inset-bottom)); width: 104rpx; height: 104rpx; border-radius: 50%; background: #234B3C; color: #FFFFFF; font-size: calc(56rpx * var(--fs-scale, 1)); line-height: 104rpx; text-align: center; box-shadow: 0 10rpx 24rpx rgba(35,75,60,.3); z-index: 20; }
