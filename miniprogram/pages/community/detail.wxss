page { background: #F5F5F7; }
.detail-page { padding: 24rpx 32rpx calc(220rpx + env(safe-area-inset-bottom)); min-height: 0; box-sizing: border-box; }
.state-tip { color: #6F7C70; font-size: calc(26rpx * var(--fs-scale, 1)); line-height: 1.7; text-align: center; padding: 80rpx 0; }
.state-tip.error { color: #B96D50; }
.detail-body { background: #FFFFFF; border-radius: 28rpx; padding: 24rpx 26rpx; box-shadow: 0 4rpx 20rpx rgba(29,37,32,.06); }
.feed-head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 18rpx; }
.feed-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: #EAF0E0; flex-shrink: 0; }
.feed-head-copy { min-width: 0; }
.feed-name { font-size: calc(28rpx * var(--fs-scale, 1)); color: #234B3C; font-weight: 600; line-height: 1.4; }
.feed-time { font-size: calc(21rpx * var(--fs-scale, 1)); color: #87917B; margin-top: 4rpx; }
.detail-image { width: 100%; height: 56vh; border-radius: 14rpx; background: #F0ECDE; }
.detail-text { font-size: calc(28rpx * var(--fs-scale, 1)); color: #2E4A38; line-height: 1.7; margin-top: 16rpx; }
.detail-actions { display: flex; gap: 30rpx; margin-top: 18rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid #F0ECDE; }
.feed-action { font-size: calc(23rpx * var(--fs-scale, 1)); color: #87917B; padding: 6rpx 0; }
.feed-action.on { color: #B96D50; }
.feed-comments { margin-top: 16rpx; background: #F5F5F7; border-radius: 12rpx; padding: 14rpx 18rpx; }
.feed-comment { font-size: calc(23rpx * var(--fs-scale, 1)); color: #1D1D1F; line-height: 1.65; padding: 2rpx 0; }
.fc-name { color: #47634B; font-weight: 600; }
.fc-reply-text { color: #47634B; }
.fc-text { color: #1D1D1F; }
.detail-no-comment { margin-top: 18rpx; color: #87917B; font-size: calc(23rpx * var(--fs-scale, 1)); text-align: center; }
/* 底部固定评论输入栏（朋友圈式） */
.comment-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #FFFDF8; border-top: 1rpx solid #E1E5D9; padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom)); z-index: 30; }
.replying-tip { display: flex; justify-content: space-between; align-items: center; font-size: calc(21rpx * var(--fs-scale, 1)); color: #47634B; padding: 0 4rpx 10rpx; }
.replying-cancel { color: #B96D50; padding: 0 8rpx; font-size: calc(28rpx * var(--fs-scale, 1)); line-height: 1; }
.comment-bar-row { display: flex; align-items: center; gap: 16rpx; }
.comment-input { flex: 1; background: #F0ECDE; border-radius: 999rpx; padding: 16rpx 26rpx; font-size: calc(26rpx * var(--fs-scale, 1)); color: #1D1D1F; height: auto; line-height: 1.5; min-height: 0; }
.comment-input-ph { color: #87917B; }
.comment-send { flex-shrink: 0; background: #DCE5D0; color: #FFFFFF; border-radius: 999rpx; padding: 14rpx 30rpx; font-size: calc(26rpx * var(--fs-scale, 1)); line-height: 1.4; }
.comment-send.ready { background: #234B3C; }
/* 长按删除提示：浅灰小字，低调不抢视觉 */
.community-hint { font-size: calc(21rpx * var(--fs-scale, 1)); color: #87917B; padding: 4rpx 4rpx 10rpx; line-height: 1.5; }
