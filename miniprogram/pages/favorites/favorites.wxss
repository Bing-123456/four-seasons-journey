.favorites-page{padding:36rpx 32rpx calc(60rpx + env(safe-area-inset-bottom))}.collection-heading{padding:8rpx 4rpx 30rpx;border-bottom:1rpx solid #DEDECE;margin-bottom:30rpx}.collection-heading .page-title{font-size:calc(46rpx * var(--fs-scale, 1));margin:0 0 16rpx;line-height:1.5}.collect-intro{font-size:calc(24rpx * var(--fs-scale, 1));line-height:1.85;color:#78826A}.collection-section{display:flex;align-items:baseline;justify-content:space-between;gap:18rpx;margin:0 4rpx 20rpx;font-size:calc(28rpx * var(--fs-scale, 1));font-weight:600;line-height:1.6}.collection-count{flex-shrink:0;font-family:Georgia,serif;font-size:calc(22rpx * var(--fs-scale, 1));line-height:1.5;color:#9A7958;font-weight:400}.know-list,.place-list{margin-top:14rpx}.know-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:24rpx 22rpx;border:1rpx solid #E3E1D1;border-radius:16rpx;background:#FFFCF5;margin-bottom:14rpx}.know-name{flex:1;min-width:0;line-height:1.75;font-size:calc(26rpx * var(--fs-scale, 1));overflow-wrap:anywhere}.row-remove{flex-shrink:0;color:#A56850;font-size:calc(22rpx * var(--fs-scale, 1));padding:14rpx 8rpx;line-height:1.6;max-width:144rpx;text-align:center;overflow-wrap:anywhere}.empty-collection{margin-top:24rpx;padding:52rpx 32rpx;background:#F0EFE3;border:1rpx solid #E1E1D1;border-radius:24rpx;text-align:center}.empty-paper{width:74rpx;height:84rpx;background:#FFFDF7;border:1rpx solid #CECBB8;border-radius:4rpx;margin:0 auto 28rpx;transform:rotate(-6deg);box-shadow:9rpx 7rpx 0 #E4E3D2;position:relative}.empty-paper::before,.empty-paper::after{content:'';position:absolute;left:14rpx;right:14rpx;height:2rpx;background:#D7D6C3;top:26rpx}.empty-paper::after{top:40rpx;right:24rpx}.empty-tip{font-size:calc(24rpx * var(--fs-scale, 1));color:#7C866C;line-height:1.9;max-width:480rpx;margin:auto}.place-row{display:flex;align-items:center;gap:18rpx;background:#FFFDF7;border:1rpx solid #E3E2D4;border-radius:20rpx;padding:16rpx;margin-bottom:18rpx}.row-thumb{width:112rpx;height:126rpx;border-radius:13rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:#8C7850}.monogram{background:#EEE8D7;font-size:calc(38rpx * var(--fs-scale, 1));border:1rpx solid #E3DBC7}.row-copy{flex:1;min-width:0}.row-name{font-size:calc(27rpx * var(--fs-scale, 1));line-height:1.6;font-weight:600;overflow-wrap:anywhere}.row-copy .muted{font-size:calc(21rpx * var(--fs-scale, 1));color:#879174;line-height:1.7;margin-top:8rpx}
