<view class="page seller {{fontClass}}">
  <demo-notice id="demo-mode-notice"/>
  <view class="head">
    <view class="mark serif" aria-hidden="true">乡</view>
    <view class="title serif">{{L.sl_title}}</view>
  </view>
  <button class="publish-btn" bindtap="publishNew">＋ 发布我的果乡名片</button>

  <view wx:if="{{loading}}" class="state-tip">{{L.loading}}</view>
  <view wx:elif="{{error}}" class="state-tip error">{{error}}</view>
  <block wx:else>
    <view class="section-title">{{L.sl_mine}}</view>
    <view wx:if="{{!myTowns.length}}" class="empty">{{L.sl_empty}}</view>
    <view wx:for="{{myTowns}}" wx:key="id" class="town-card">
      <view class="tc-main">
        <view class="tc-name">{{item.name}}</view>
        <view class="tc-tag">{{item.term}} · {{item.fruit}}</view>
      </view>
      <view class="tc-status {{item.published ? 'on' : 'off'}}">{{item.statusText}}</view>
      <view class="tc-actions">
        <text class="tc-edit" data-id="{{item.id}}" bindtap="editTown">{{L.sl_edit}}</text>
        <text wx:if="{{item.published}}" class="tc-down" data-id="{{item.id}}" bindtap="unpublishTown">{{L.sl_unpublish}}</text>
      </view>
    </view>
  </block>
</view>
