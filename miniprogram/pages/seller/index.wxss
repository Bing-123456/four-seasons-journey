/* 底部分区栏：左「AI预测」右「我的」 */
.section-bar-wrap{position:fixed;left:0;right:0;bottom:0;z-index:50;padding:0 20rpx calc(14rpx + env(safe-area-inset-bottom));background:linear-gradient(to top,#F7F5ED 78%,rgba(247,245,237,0))}
.section-bar{display:flex;background:#FFFDF8;border:1rpx solid #DCE5D0;border-radius:20rpx;overflow:hidden;box-shadow:0 6rpx 24rpx rgba(35,75,60,.10)}
.section-item{flex:1;display:flex;align-items:center;justify-content:center;gap:10rpx;padding:22rpx 0;font-size:27rpx;color:#798479;letter-spacing:2rpx}
.section-item.active{background:#234B3C;color:#F9F8EB}
.section-glyph{font-size:29rpx}
.seller-page{padding-bottom:150rpx}

/* 信号卡片与 AI 解读 */
.signals{display:flex;flex-direction:column;gap:14rpx;margin:18rpx 0}
.signal-card{background:#FFFDF8;border:1rpx solid #E0E5D5;border-radius:16rpx;padding:20rpx 22rpx}
.signal-head{font-size:22rpx;color:#79866e;letter-spacing:2rpx;margin-bottom:10rpx}
.signal-body{font-size:26rpx;color:#2E4A38;line-height:1.6}
.signal-rows{margin-top:12rpx;border-top:1rpx dashed #DCE5D0;padding-top:10rpx}
.signal-row{display:flex;justify-content:space-between;font-size:22rpx;color:#52634e;line-height:1.9}
.insight-card{margin:6rpx 0 18rpx}
.insight-mode{display:inline-block;font-size:20rpx;color:#8a6d3b;background:#f6efdd;border-radius:8rpx;padding:6rpx 12rpx;margin:14rpx 0 10rpx}
.insight-reading{font-size:26rpx;line-height:1.8;color:#37493b}

/* Keep operating signals readable and distinguish the journal from its tools. */
.seller-page { padding-top: 38rpx; padding-bottom: calc(170rpx + env(safe-area-inset-bottom)); }
.seller-eyebrow { color: #8A7450; }
.seller-page > .page-title { font-size: 46rpx; line-height: 1.5; margin: 18rpx 0; }
.intro { font-size: 25rpx; line-height: 1.8; }
.local-note { border-left: 4rpx solid #C9AF83; border-radius: 4rpx 14rpx 14rpx 4rpx; color: #7A6C50; }
.tabs { border: 0; background: #E9EDE1; border-radius: 16rpx; padding: 7rpx; margin: 26rpx 0; box-sizing: border-box; }
.tab-row { gap: 7rpx; min-width: 100%; }
.tab { flex: 1; text-align: center; padding: 16rpx 22rpx; border: 0; font-size: 25rpx; border-radius: 11rpx; color: #6A7A60; }
.tab.selected { background: #FFFDF8; box-shadow: 0 3rpx 10rpx rgba(35,75,60,.05); }
.batch-picker { margin-top: 26rpx; }
.batch-chip { border-radius: 12rpx; background: #FFFDF8; padding: 13rpx 22rpx; }
.batch-chip.active { color: #FFFDF8; background: #234B3C; border-color: #234B3C; }
.risk-card { border: 1rpx solid #D7E1CA; padding: 30rpx; }
.risk-card .hint { color: #637458; margin-top: 14rpx; }
.risk-number { line-height: 1.2; font-size: 88rpx; }
.risk-urgent { border-color: #E6CDBB; }
.risk-urgent .risk-number { color: #A46144; }
.risk-attention { border-color: #DFD9B7; }
.signals > .signal-card { display: block; border: 1rpx solid #E0E5D5; padding: 26rpx 28rpx; border-radius: 22rpx; }
.signal-head { color: #778567; font-size: 21rpx; }
.signal-body { font-size: 28rpx; line-height: 1.75; }
.signal-row { gap: 20rpx; }
.signal-row > text:last-child { text-align: right; flex-shrink: 0; flex-grow: 0; }
.hint { color: #718064; font-size: 23rpx; }
.insight-card .section-title { margin-top: 0; }
.insight-reading { padding: 14rpx 0 22rpx; line-height: 1.9; }
.insight-card .subheading { margin-top: 20rpx; }
.input, .input-box { width: 100%; min-height: 90rpx; background: #FFFDF8; border: 1rpx solid #DCE2D4; border-radius: 15rpx; padding: 20rpx; font-size: 26rpx; margin: 10rpx 0; min-width: 0; }
.input-box { display: flex; align-items: center; }
.two-fields .input-box { font-size: 24rpx; }
.area { line-height: 1.75; }
.section-kicker { color: #947049; font-size: 22rpx; margin-top: 38rpx; padding-bottom: 16rpx; }
.section-bar-wrap { padding: 16rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); }
.section-bar { border-radius: 20rpx; padding: 6rpx; gap: 6rpx; box-shadow: 0 8rpx 28rpx rgba(35,75,60,.08); }
.section-item { border-radius: 15rpx; padding: 20rpx 0; font-size: 26rpx; letter-spacing: 1rpx; }

/* The workbench borrows the field journal's paper and ledger details. */
.seller-page { padding-top: 30rpx; }
.seller-heading { display: flex; align-items: center; gap: 20rpx; margin-bottom: 22rpx; }
.seller-heading .page-title { margin: 0; font-size: 42rpx; line-height: 1.4; }
.seller-heading-mark { flex-shrink: 0; width: 66rpx; height: 76rpx; line-height: 74rpx; color: #A6764D; border: 1rpx solid #BEA886; border-radius: 10rpx; text-align: center; font-size: 38rpx; background: #F1EAD5; }
.local-note { background: #F0ECDC; border-left-color: #BDA77F; margin: 22rpx 0; font-size: 22rpx; }
.batch-picker { padding: 22rpx 24rpx 0; border: 1rpx solid #E0E3D3; border-radius: 20rpx; background: #FFFDF7; }
.batch-options { padding-bottom: 22rpx; }
.batch-chip { border-radius: 11rpx; }
.risk-card { background: #EAF0DF; border-radius: 24rpx; padding: 30rpx; }
.risk-card .card-kicker { color: #80916D; font-size: 20rpx; }
.risk-card .card-title { margin: 16rpx 0 22rpx; font-size: 36rpx; }
.risk-number { font-size: 82rpx; color: #3C6248; }
.risk-urgent { background: #F5E9DC; border-color: #E3CEB8; }
.risk-attention { background: #F1EDD8; border-color: #DFD6B6; }
.risk-insufficient { background: #EFEFE5; border-color: #DFE1D2; }
.signal-head { padding-bottom: 13rpx; border-bottom: 1rpx solid #E7E9DB; margin-bottom: 13rpx; }
.signal-body { font-size: 27rpx; }
.insight-card { background: #F8F7ED; border-color: #DCE3D0; padding: 28rpx; }
.formula { background: #FFFDF7; }
.formula > view:not(.section-title):not(.hint) { padding: 14rpx 0; border-bottom: 1rpx solid #EBECDF; font-size: 24rpx; }
.formula .hint { margin-top: 13rpx; }
.form-panel { padding: 6rpx 0 0; }
.form-panel .section-kicker { background: #EDEEDA; padding: 12rpx 16rpx; border: 0; border-radius: 8rpx; color: #7C7851; }
.ledger-row { padding: 24rpx 2rpx; }
.plan-step > text { width: 42rpx; font-size: 26rpx; color: #A48252; }
.section-bar { border-color: #DDE1CF; background: #FFFDF5; }
.section-item.active { background: #345B42; }

.growth-note{margin:24rpx 0;font-size:28rpx;line-height:1.7;color:#54545a}.published-activity{padding:28rpx 0;border-bottom:1rpx solid #eee;margin-bottom:24rpx}.activity-mask{position:fixed;inset:0;background:rgba(0,0,0,.3);z-index:900;display:flex;align-items:flex-end}.activity-sheet{width:100%;max-height:92vh;background:#fff;border-radius:36rpx 36rpx 0 0;padding:32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));box-sizing:border-box}.activity-scroll{height:58vh}.activity-sheet .section-title{margin-top:0}.activity-sheet .button{margin-top:24rpx}.activity-section .section-title{margin-top:0}

/* 评审 9.28②：切换到游客按钮 —— 居中、白字、深绿底。 */
.visitor-switch{display:block;margin:14rpx auto 4rpx;background:#2E4A38;border:0;border-radius:14rpx;padding:16rpx 0;width:60%;color:#FFFFFF;font-size:24rpx;line-height:1.6;text-align:center}
.visitor-switch::after{border:none}
