.page { padding: 28rpx 28rpx 60rpx; background: #FFFDF8; min-height: 100vh; box-sizing: border-box; }
.head { display: flex; align-items: center; margin-bottom: 24rpx; }
.mark { width: 72rpx; height: 72rpx; border-radius: 18rpx; background: #3C9D6E; color: #fff; font-size: calc(40rpx * var(--fs-scale, 1)); display: flex; align-items: center; justify-content: center; margin-right: 18rpx; }
.title { font-size: calc(44rpx * var(--fs-scale, 1)); font-weight: 700; color: #234B3C; }
.publish-btn { width: 100%; background: #3C9D6E; color: #fff; border-radius: 44rpx; font-size: calc(32rpx * var(--fs-scale, 1)); margin-bottom: 28rpx; }
.section-title { font-size: calc(32rpx * var(--fs-scale, 1)); font-weight: 700; color: #234B3C; margin: 8rpx 0 16rpx; }
.empty { font-size: calc(26rpx * var(--fs-scale, 1)); color: #9aa89e; text-align: center; padding: 40rpx 0; }
.town-card { background: #fff; border-radius: 18rpx; padding: 24rpx; margin-bottom: 16rpx; display: flex; align-items: center; box-shadow: 0 2rpx 10rpx rgba(35,75,60,0.05); }
.tc-main { flex: 1; }
.tc-name { font-size: calc(30rpx * var(--fs-scale, 1)); font-weight: 600; color: #234B3C; }
.tc-tag { font-size: calc(24rpx * var(--fs-scale, 1)); color: #3C9D6E; margin-top: 6rpx; }
.tc-status { font-size: calc(24rpx * var(--fs-scale, 1)); padding: 4rpx 14rpx; border-radius: 20rpx; margin: 0 16rpx; }
.tc-status.on { color: #3C9D6E; background: #EAF1E2; }
.tc-status.off { color: #9aa89e; background: #F0F2EE; }
.tc-actions { display: flex; flex-direction: column; align-items: flex-end; }
.tc-edit { font-size: calc(26rpx * var(--fs-scale, 1)); color: #234B3C; margin-bottom: 10rpx; }
.tc-down { font-size: calc(26rpx * var(--fs-scale, 1)); color: #C0392B; }
.state-tip { text-align: center; color: #9aa89e; font-size: calc(28rpx * var(--fs-scale, 1)); padding: 80rpx 0; }
.state-tip.error { color: #C0392B; }
