<view class="page publish {{fontClass}}">
  <demo-notice id="demo-mode-notice"/>
  <view class="head">
    <view class="head-title">{{L.sl_plan_entry}}</view>
  </view>

  <view wx:if="{{error}}" class="err">{{error}}</view>
  <view class="page-hint">{{L.pub_page_hint}}</view>

  <view class="section-title">{{L.pub_sec_card}}</view>
  <label class="label">{{L.pub_name}}</label>
  <view id="field-name"><input class="input {{errors.name ? 'has-error' : ''}}" value="{{form.name}}" bindinput="inputName" maxlength="60" placeholder="{{L.pub_name_ph}}"/></view>
  <view wx:if="{{errors.name}}" class="field-error">{{errors.name}}</view>
  <view id="field-region">
    <picker mode="region" value="{{regionValue}}" bindchange="onRegionChange">
      <label class="label">{{L.pub_region}}</label>
      <view class="input picker">{{form.province || L.pub_region_ph}} {{form.city}} {{form.county}} ⌄</view>
    </picker>
  </view>
  <view wx:if="{{errors.region}}" class="field-error">{{errors.region}}</view>
  <label class="label">{{L.pub_address}}</label>
  <view id="field-address"><input class="input {{errors.address ? 'has-error' : ''}}" value="{{form.address}}" bindinput="inputAddress" maxlength="80" placeholder="{{L.pub_address_ph}}"/>
      <view wx:if="{{errors.address}}" class="field-error">{{errors.address}}</view></view>
  <label class="label">{{L.pub_fruit}}</label>
  <input class="input {{errors.fruit ? 'has-error' : ''}}" value="{{form.fruit}}" bindinput="inputFruit" maxlength="30" placeholder="{{L.pub_fruit_ph}}"/>
  <view wx:if="{{errors.fruit}}" class="field-error">{{errors.fruit}}</view>
  <label class="label">{{L.pub_date_window}}</label>
      <view id="field-openDate"><picker mode="date" value="{{form.openDate}}" bindchange="onOpenDate"><label class="label">{{L.pub_open_date}}</label><view class="input picker">{{form.openDate || L.pub_region_ph}} ⌄</view></picker>
      <view wx:if="{{errors.openDate}}" class="field-error">{{errors.openDate}}</view></view>
      <picker mode="time" value="{{form.openTime}}" bindchange="onOpenTime"><label class="label">{{L.pub_open_time}}</label><view class="input picker">{{form.openTime || L.pub_region_ph}} ⌄</view></picker>
      <view wx:if="{{errors.openTime}}" class="field-error">{{errors.openTime}}</view>
      <view id="field-closeDate"><picker mode="date" value="{{form.closeDate}}" bindchange="onCloseDate"><label class="label">{{L.pub_close_date}}</label><view class="input picker">{{form.closeDate || L.pub_region_ph}} ⌄</view></picker>
      <view wx:if="{{errors.closeDate}}" class="field-error">{{errors.closeDate}}</view></view>
      <picker mode="time" value="{{form.closeTime}}" bindchange="onCloseTime"><label class="label">{{L.pub_close_time}}</label><view class="input picker">{{form.closeTime || L.pub_region_ph}} ⌄</view></picker>
      <view wx:if="{{errors.closeTime}}" class="field-error">{{errors.closeTime}}</view>
  <label class="label">{{L.pub_experience}}</label>
  <view class="exp-row">
    <text wx:for="{{experiences}}" wx:key="value" class="exp {{expSelected[item.value] ? 'on' : ''}}" data-exp="{{item.value}}" bindtap="toggleExp">{{item.label}}</text>
  </view>
  <label class="label">{{L.pub_desc}}</label>
  <textarea class="input area" value="{{form.description}}" bindinput="inputDesc" maxlength="600" placeholder="{{L.pub_desc_ph}}"/>
      <label class="label">{{L.pub_wechat}}</label>
      <input class="input" value="{{form.wechat}}" bindinput="inputWechat" maxlength="50" placeholder="{{L.pub_wechat_ph}}"/>
      <label class="label">{{L.pub_phone}}</label>
      <input class="input" value="{{form.phone}}" bindinput="inputPhone" maxlength="50" placeholder="{{L.pub_phone_ph}}"/>

  <view class="section-title batch">{{L.pub_sec_batch}}</view>
  <label class="label">{{L.pub_batch_left}}</label>
  <input class="input" value="{{batchLeft}}" bindinput="inputBatchLeft" maxlength="20" placeholder="{{L.pub_batch_left_ph}}"/>
  <label class="label">{{L.pub_batch_people}}</label>
  <input class="input" value="{{batchPeople}}" bindinput="inputBatchPeople" maxlength="20" placeholder="{{L.pub_batch_people_ph}}"/>

  <button class="submit" loading="{{generating}}" disabled="{{generating}}" bindtap="generatePlan">{{L.pub_generate}}</button>
  <button wx:if="{{editing}}" class="save-edit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="saveCard">{{L.pub_save_edit}}</button>
</view>
