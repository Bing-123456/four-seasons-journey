d{width:45rpx;right:35rpx;top:84rpx;transform:rotate(137deg)}.line-plate{left:37rpx;top:191rpx;width:36rpx;transform:rotate(-25deg)}.cover-caption{position:absolute;left:0;right:0;bottom:26rpx;color:#8a826e;text-align:center;font-size:calc(19rpx * var(--fs-scale, 1));letter-spacing:2rpx}.caption-dot{display:inline-block;width:7rpx;height:7rpx;border-radius:50%;background:#a8946d;margin:0 12rpx 3rpx 0}.cover-action{padding:10rpx 26rpx 5rpx}.cover-invitation{display:block;font-size:calc(24rpx * var(--fs-scale, 1));color:#747961;text-align:center;margin:13rpx 0 24rpx}.cover-action .button{padding:22rpx 28rpx;font-weight:500;border-radius:18rpx;font-size:calc(26rpx * var(--fs-scale, 1))}.button-arrow{float:right;color:#d3dec8;font-size:calc(30rpx * var(--fs-scale, 1));line-height:1}.subtle-button{background:transparent;color:#6d7a61;font-size:calc(22rpx * var(--fs-scale, 1));line-height:56rpx;padding:5rpx 0}.diagram-notice{display:block;color:#989582;font-size:calc(18rpx * var(--fs-scale, 1));text-align:center;line-height:1.8;margin:15rpx 0 0}.mill-controls{padding:0 23rpx 12rpx}.camera-tabs{display:flex;align-items:center;gap:6rpx;border-bottom:1rpx solid #d9d6c5;padding-bottom:19rpx}.camera-tab,.reset-control{padding:0 23rpx;margin:0;height:53rpx;line-height:53rpx;font-size:calc(22rpx * var(--fs-scale, 1));color:#68745c;background:transparent;border-radius:12rpx}.camera-tab.active{background:#f8f6ed;color:#354f3b}.reset-control{margin-left:auto;padding:0 10rpx;font-size:calc(20rpx * var(--fs-scale, 1))}.motion-instruction{display:flex;justify-content:space-between;align-items:center;font-size:calc(24rpx * var(--fs-scale, 1));color:#4a6045;margin-top:24rpx}.motion-count{font-size:calc(19rpx * var(--fs-scale, 1));color:#889078}.mill-controls slider{margin:21rpx 9rpx 23rpx}.grind-buttons{display:flex;gap:15rpx}.grind-button{width:50%;padding:0;line-height:67rpx;background:#f8f6ed;color:#3b5741;font-size:calc(24rpx * var(--fs-scale, 1));border-radius:14rpx}.grind-button[disabled]{opacity:.48}.motion-hint{display:block;margin-top:19rpx;font-size:calc(22rpx * var(--fs-scale, 1));color:#7a806b;line-height:1.8;min-height:75rpx}.mode-switch-row{padding:7rpx 25rpx 9rpx;border-top:1rpx solid #ddd9c8;display:flex;justify-content:space-between;align-items:center}.mode-switch-row>text{font-size:calc(18rpx * var(--fs-scale, 1));color:#9b9c88}.text-lesson{padding:16rpx 26rpx 24rpx}.text-step{display:flex;align-items:center;gap:20rpx}.step-counter{font-size:calc(20rpx * var(--fs-scale, 1));color:#ad9770;letter-spacing:1rpx}.text-step-title{font-size:calc(27rpx * var(--fs-scale, 1));font-weight:500;color:#445a3f}.text-step-copy{display:block;font-size:calc(24rpx * var(--fs-scale, 1));line-height:1.85;color:#7a806d;margin:17rpx 0 21rpx}.text-lesson .button-secondary{background:#f8f6ee;font-size:calc(23rpx * var(--fs-scale, 1));padding:19rpx 20rpx}.fallback-message{display:block;font-size:calc(22rpx * var(--fs-scale, 1));color:#907650;background:#f3ecdb;padding:18rpx;border-radius:12rpx;margin:0 0 20rpx}.text-finish{font-size:calc(23rpx * var(--fs-scale, 1));color:#617552}.illustration-working .draw-rod{top:139rpx;left:95rpx}.drawing-motion{position:absolute;left:67rpx;top:76rpx;font-size:calc(57rpx * var(--fs-scale, 1));line-height:1;color:#7f8667;transform:rotate(-24deg)}.knowledge-card{margin-top:30rpx;padding:29rpx 26rpx;background:#fdfbf5;border:1rpx solid #dedfd0;border-radius:24rpx}.knowledge-title{display:block;font-size:calc(29rpx * var(--fs-scale, 1));line-height:1.5;color:#39513d;margin:15rpx 0 24rpx}.answer-option{display:flex;align-items:center;text-align:left;gap:18rpx;margin:12rpx 0 0;padding:19rpx 19rpx;line-height:1.65;background:#f2f1e7;color:#68715c;font-size:calc(24rpx * var(--fs-scale, 1));border:1rpx solid transparent;border-radius:14rpx}.answer-symbol{color:#919880}.answer-option.answer-right{background:#e9eedf;border-color:#a7ba91;color:#3e613d}.answer-option.answer-wrong{background:#f4eadc;border-color:#d6bd94;color:#946c4d