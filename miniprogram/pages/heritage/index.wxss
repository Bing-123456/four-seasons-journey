.exhibit-topline{gap:18rpx;align-items:flex-start;padding:16rpx 16rpx 20rpx}
.exhibit-label{font-size:calc(27rpx * var(--fs-scale, 1));line-height:1.6;letter-spacing:1rpx;flex:1;min-width:0}
