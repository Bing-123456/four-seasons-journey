.experience-card>view{flex:1;min-width:0}
.experience-title{display:block;font-size:calc(28rpx * var(--fs-scale, 1));line-height:1.7}
.experience-note{font-size:calc(22rpx * var(--fs-scale, 1));line-height:1.8}
.experience-arrow{font-size:calc(32rpx * var(--fs-scale, 1));flex-shrink:0}
