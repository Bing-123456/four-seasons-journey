.heritage-page button.camera-tab{width:auto;min-width:0;flex:0 0 auto;margin:0}
.heritage-page button.reset-control{width:auto;min-width:0;flex:0 0 auto;margin:0 0 0 auto}
.heritage-page button.subtle-button{width:auto;min-width:0;margin:0 auto}
.mode-switch-row button.subtle-button{margin:0}
.heritage-page button.answer-option{width:100%;margin:12rpx 0 0}
.heritage-page button.grind-button{width:0;min-width:0;flex:1;margin:0}
.heritage-page button.source-button{width:auto;min-width:0;margin:0}

/* Exhibition typography and compact controls remain readable in both languages. */
.heritage-page{padding-bottom:calc(64rpx + env(safe-area-inset-bottom))}
.exhibit-heading{padding:14rpx 0 28rpx}
.exhibit-heading .eyebrow{color:#9B7B54;font-size:calc(21rpx * var(--fs-scale, 1))}
