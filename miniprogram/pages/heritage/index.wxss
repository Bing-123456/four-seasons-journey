.mill-cover{height:352rpx;background:radial-gradient(ellipse at 50% 35%,#FFFDF6,#EDE8D8 78%);border-radius:18rpx}
.mill-illustration{top:26rpx}
.circle-large{width:410rpx;height:288rpx}
.circle-small{width:312rpx;height:210rpx}
