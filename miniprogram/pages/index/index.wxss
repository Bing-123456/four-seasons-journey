page{height:100%;overflow:hidden;background:#F5F5F7}
.home-screen{height:100vh;overflow:hidden;padding:0 34rpx calc(132rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;box-sizing:border-box}
.home-demo{flex-shrink:0;margin:0 -32rpx}.home-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:22rpx 0 16rpx;flex-shrink:0}.heading-copy{min-width:0}.home-brand{font-size:calc(48rpx * var(--fs-scale, 1));font-weight:750;letter-spacing:-1.5rpx;color:#1D1D1F;line-height:1.25;margin-top:7rpx}
.home-search{display:flex;align-items:center;gap:13rpx;padding:14rpx 20rpx;border-radius:18rpx;background:#E9E9ED;color:#86868B;font-size:calc(25rpx * var(--fs-scale, 1));flex-shrink:0;line-height:1.4}.search-symbol{font-size:calc(38rpx * var(--fs-scale, 1));line-height:34rpx;color:#6E6E73}.search-go{margin-left:auto;font-size:calc(32rpx * var(--fs-scale, 1))}
.feature-region{flex-shrink:0;display:flex;flex-direction:column;padding-top:20rpx;margin:0 -34rpx}
/* 卡片宽度与快捷入口整行对齐，高度使用一屏剩余空间。 */
.feature-swiper{height:410rpx;width:100%}
.feature-card{height:100%;position:relative;margin:0 5px;border-radius:28rpx;overflow:hidden;background:#133C31;transform:scale(1);transition:transform .28s ease-out}
.feature-card.is-current{transform:scale(1)}
.feature-image{position:absolute;width:100%;height:100%;top:0;left:0}
/* 轮播防黑边：底层预烘焙模糊底图铺满卡片（不依赖运行时 CSS filter，真机可靠），
   上层海报轻微放大 1.045 倍自行填满（左右各裁约 2.2%，实测所有贴边文字距边 ≥3%，安全） */
.feature-image-bg{transform:scale(1.08)}
.feature-image-main{z-index:1;transform:scale(1.045)}
.activity-cover-copy{position:absolute;left:0;right:0;bottom:0;padding:64rpx 30rpx 32rpx;background:linear-gradient(transparent,rgba(19,60,49,.92));color:#FFF;font-size:calc(24rpx * var(--fs-scale, 1));line-height:1.7;overflow-wrap:anywhere}.activity-cover-title{font-size:calc(38rpx * var(--fs-scale, 1));font-weight:700;line-height:1.4;margin-bottom:16rpx}
.home-brand{white-space:nowrap}.heading-actions{flex-shrink:0}
.feature-dots{display:flex;justify-content:center;align-items:center;height:38rpx;flex-shrink:0}.feature-dot-hit{height:100%;min-width:30rpx;display:flex;align-items:center;justify-content:center}.feature-dot{width:8rpx;height:8rpx;border-radius:50%;background:#D4D4D8;transition:width .2s ease,background .2s ease}.feature-dot.active{background:#454548;width:20rpx;border-radius:5rpx}

/* 10.2 / P01②：下方两个板块与上方三张照片同宽（用负边距抵消页面左右留白，与 .feature-region
   对齐）、同为横版卡片；背景图按需求移除，改为纯色卡片，文字随之改用深色。 */
.home-shortcuts{display:flex;flex-direction:column;gap:16rpx;flex-shrink:0;margin:16rpx -34rpx 0;padding:0 34rpx}.shortcut-card{position:relative;min-width:0;height:140rpx;border-radius:28rpx;overflow:hidden;background:#EEEADF}.journal-shortcut{background:#E3EBDE}.profile-shortcut{background:#F0EADA}.shortcut-text{position:absolute;left:26rpx;right:22rpx;bottom:24rpx;color:#293E30}.shortcut-text>text{font-size:calc(18rpx * var(--fs-scale, 1));opacity:.75;line-height:1.4}.shortcut-text>view{font-size:calc(26rpx * var(--fs-scale, 1));font-weight:650;line-height:1.35;margin-top:7rpx;display:flex;justify-content:space-between;align-items:center;gap:6rpx}
@media(max-height:600px){.home-heading{padding-top:12rpx;padding-bottom:10rpx}.home-brand{font-size:calc(42rpx * var(--fs-scale, 1))}.shortcut-card{height:120rpx}.feature-region{padding-top:14rpx}}
.welcome-overlay { position: fixed; inset: 0; z-index: 10000; background: #F7F5ED; display: flex; flex-direction: column; align-items: center; justify-content: center; touch-action: none; }
.welcome-center { text-align: center; padding: 35rpx; max-width: 100%; box-sizing: border-box; }
.welcome-title { font-size: calc(44rpx * var(--fs-scale, 1)); color: #234B3C; margin: 24rpx 0 16rpx; overflow-wrap: anywhere; }
.welcome-caption { font-size: calc(25rpx * var(--fs-scale, 1)); color: #6F7C70; }
.welcome-customize { margin: 34rpx auto 0; background: #234B3C; color: #FFF9DF; font-size: calc(26rpx * var(--fs-scale, 1)); padding: 22rpx 28rpx; border-radius: 18rpx; line-height: 1.5; width: 100%; max-width: 520rpx; min-width: 0; }
.welcome-skip { margin: 18rpx auto 0; font-size: calc(25rpx * var(--fs-scale, 1)); color: #6F7C70; text-decoration: underline; text-underline-offset: 6rpx; width: 100%; max-width: 520rpx; text-align: center; }
.welcome-brand { position: absolute; bottom: calc(70rpx + env(safe-area-inset-bottom)); font-size: calc(26rpx * var(--fs-scale, 1)); color: #87917B; }
.role-overlay { position: fixed; inset: 0; background: rgba(14,26,17,.68); z-index: 130; display: flex; align-items: center; justify-content: center; }
.role-card { width: 630rpx; max-height: 86vh; overflow-y: auto; box-sizing: border-box; background: #F7F5ED; border-radius: 30rpx; padding: 36rpx 30rpx 30rpx; text-align: center; }
.role-title { font-size: calc(38rpx * var(--fs-scale, 1)); color: #234B3C; margin: 10rpx 0 30rpx; }
.role-option { display: flex; align-items: center; gap: 22rpx; text-align: left; background: #FFFDF8; border: 1rpx solid #DCE5D0; border-radius: 20rpx; padding: 26rpx; margin-bottom: 18rpx; }
.role-glyph { width: 78rpx; height: 88rpx; line-height: 88rpx; text-align: center; background: #EAF0E0; color: #2E4A38; font-size: calc(38rpx * var(--fs-scale, 1)); border-radius: 36rpx 36rpx 10rpx 10rpx; flex-shrink: 0; }
.role-copy { min-width: 0; }
.role-name { font-size: calc(30rpx * var(--fs-scale, 1)); color: #2E4A38; }
.role-desc { font-size: calc(23rpx * var(--fs-scale, 1)); color: #6F7C70; line-height: 1.7; margin-top: 6rpx; }
.role-note { font-size: calc(22rpx * var(--fs-scale, 1)); color: #788572; margin-top: 16rpx; }

.heading-actions{display:flex;align-items:center;gap:8rpx}.booking-mask{position:fixed;inset:0;z-index:500;background:rgba(0,0,0,.3);display:flex;align-items:flex-end}.booking-sheet{width:100%;box-sizing:border-box;background:#fff;padding:44rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));border-radius:36rpx 36rpx 0 0;max-height:88vh;display:flex;flex-direction:column}.booking-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:24rpx;flex-shrink:0}.booking-head .booking-title{margin-bottom:0}.booking-close{width:56rpx;height:56rpx;line-height:52rpx;padding:0;margin:0;border-radius:50%;background:#2E4A38;color:#FFFFFF;font-size:calc(30rpx * var(--fs-scale, 1));text-align:center;flex-shrink:0}.booking-close::after{border:0}.booking-title{font-size:calc(36rpx * var(--fs-scale, 1));font-weight:700;margin-bottom:24rpx;color:#1d1d1f}/* 10.2 / P01①：原固定 height 会在「暂无预约」这类短内容下留出大片空白，
   改 max-height 后面板按内容收缩，底部不再空一大截；顶部留白加大让内容整体下移。 */
.booking-scroll{flex:1;min-height:0;max-height:none;padding-bottom:calc(120rpx + env(safe-area-inset-bottom))}.booking-label{display:block;font-size:calc(25rpx * var(--fs-scale, 1));font-weight:600;margin:26rpx 0 14rpx}.booking-input{height:78rpx;line-height:78rpx;padding:0 20rpx;border-radius:16rpx;background:#F5F5F7;box-sizing:border-box;font-size:calc(28rpx * var(--fs-scale, 1))}.booking-note{color:#6e6e73;font-size:calc(25rpx * var(--fs-scale, 1));line-height:1.7;margin:10rpx 0}.booking-record{padding:20rpx 0;border-bottom:1rpx solid #eee;font-size:calc(29rpx * var(--fs-scale, 1))}.booking-error{font-size:calc(25rpx * var(--fs-scale, 1));color:#a43c35;margin-top:20rpx}.booking-cancel{font-size:calc(24rpx * var(--fs-scale, 1));line-height:2;background:#f5f5f7;color:#a43c35;margin:12rpx 0;width:fit-content;padding:8rpx 20rpx}.booking-sheet .button{margin-top:24rpx}.booking-sheet .text-button{flex-shrink:0}
