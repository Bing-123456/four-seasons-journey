page{height:100%;overflow:hidden;background:#F5F5F7}
.home-screen{height:100vh;overflow:hidden;padding:0 34rpx calc(132rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;box-sizing:border-box}
.home-demo{flex-shrink:0;margin:0 -32rpx}.home-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:22rpx 0 16rpx;flex-shrink:0}.heading-copy{min-width:0}.home-kicker{color:#86868B;font-size:20rpx;font-weight:500;line-height:1.4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.home-brand{font-size:48rpx;font-weight:750;letter-spacing:-1.5rpx;color:#1D1D1F;line-height:1.25;margin-top:7rpx}
.home-search{display:flex;align-items:center;gap:13rpx;padding:14rpx 20rpx;border-radius:18rpx;background:#E9E9ED;color:#86868B;font-size:25rpx;flex-shrink:0;line-height:1.4}.search-symbol{font-size:38rpx;line-height:34rpx;color:#6E6E73}.search-go{margin-left:auto;font-size:32rpx}
.feature-region{flex:1;min-height:0;display:flex;flex-direction:column;padding-top:20rpx;margin:0 -34rpx}
/* 卡片宽度与快捷入口整行对齐，高度使用一屏剩余空间。 */
.feature-swiper{height:0;min-height:0;flex:1;width:100%}
.feature-card{height:100%;position:relative;margin:0 5px;border-radius:28rpx;overflow:hidden;background:#133C31;transform:scale(1);transition:transform .28s ease-out}
.feature-card.is-current{transform:scale(1)}
.feature-image{position:absolute;width:100%;height:100%;top:0;left:0}
/* 轮播防黑边：底层预烘焙模糊底图铺满卡片（不依赖运行时 CSS filter，真机可靠），
   上层海报轻微放大 1.045 倍自行填满（左右各裁约 2.2%，实测所有贴边文字距边 ≥3%，安全） */
.feature-image-bg{transform:scale(1.08)}
.feature-image-main{z-index:1;transform:scale(1.045)}
.activity-cover-copy{position:absolute;left:0;right:0;bottom:0;padding:64rpx 30rpx 32rpx;background:linear-gradient(transparent,rgba(19,60,49,.92));color:#FFF;font-size:24rpx;line-height:1.7;overflow-wrap:anywhere}.activity-cover-title{font-size:38rpx;font-weight:700;line-height:1.4;margin-bottom:16rpx}
.home-brand{white-space:nowrap}.heading-actions{flex-shrink:0}
.feature-dots{display:flex;justify-content:center;align-items:center;height:38rpx;flex-shrink:0}.feature-dot-hit{height:100%;min-width:30rpx;display:flex;align-items:center;justify-content:center}.feature-dot{width:8rpx;height:8rpx;border-radius:50%;background:#D4D4D8;transition:width .2s ease,background .2s ease}.feature-dot.active{background:#454548;width:20rpx;border-radius:5rpx}

.home-shortcuts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;height:132rpx;flex-shrink:0}.shortcut-card{position:relative;min-width:0;border-radius:23rpx;overflow:hidden;background:#EEEADF}.shortcut-image,.shortcut-shade{position:absolute;inset:0;width:100%;height:100%}.shortcut-shade{background:rgba(18,39,26,.44)}.shortcut-fruit{position:absolute;right:-24rpx;top:-25rpx;width:175rpx;height:175rpx;opacity:.58}.shortcut-text{position:absolute;left:22rpx;right:18rpx;bottom:21rpx;color:#FFF}.shortcut-text>text{font-size:18rpx;opacity:.8;line-height:1.4}.shortcut-text>view{font-size:26rpx;font-weight:650;line-height:1.35;margin-top:7rpx;display:flex;justify-content:space-between;align-items:center;gap:6rpx}.profile-shortcut .shortcut-text{color:#293E30}
@media(max-height:600px){.home-heading{padding-top:12rpx;padding-bottom:10rpx}.home-brand{font-size:42rpx}.home-kicker{display:none}.home-shortcuts{height:108rpx}.feature-region{padding-top:14rpx}}
.welcome-overlay { position: fixed; inset: 0; z-index: 10000; background: #F7F5ED; display: flex; flex-direction: column; align-items: center; justify-content: center; touch-action: none; }
.welcome-center { text-align: center; padding: 35rpx; max-width: 100%; box-sizing: border-box; }
.welcome-title { font-size: 44rpx; color: #234B3C; margin: 24rpx 0 16rpx; overflow-wrap: anywhere; }
.welcome-caption { font-size: 25rpx; color: #6F7C70; }
.welcome-customize { margin: 34rpx auto 0; background: #234B3C; color: #FFF9DF; font-size: 26rpx; padding: 22rpx 28rpx; border-radius: 18rpx; line-height: 1.5; width: 100%; max-width: 520rpx; min-width: 0; }
.welcome-brand { position: absolute; bottom: calc(70rpx + env(safe-area-inset-bottom)); font-size: 26rpx; color: #87917B; }
.role-overlay { position: fixed; inset: 0; background: rgba(14,26,17,.68); z-index: 130; display: flex; align-items: center; justify-content: center; }
.role-card { width: 630rpx; max-height: 86vh; overflow-y: auto; box-sizing: border-box; background: #F7F5ED; border-radius: 30rpx; padding: 36rpx 30rpx 30rpx; text-align: center; }
.role-title { font-size: 38rpx; color: #234B3C; margin: 10rpx 0 30rpx; }
.role-option { display: flex; align-items: center; gap: 22rpx; text-align: left; background: #FFFDF8; border: 1rpx solid #DCE5D0; border-radius: 20rpx; padding: 26rpx; margin-bottom: 18rpx; }
.role-glyph { width: 78rpx; height: 88rpx; line-height: 88rpx; text-align: center; background: #EAF0E0; color: #2E4A38; font-size: 38rpx; border-radius: 36rpx 36rpx 10rpx 10rpx; flex-shrink: 0; }
.role-copy { min-width: 0; }
.role-name { font-size: 30rpx; color: #2E4A38; }
.role-desc { font-size: 23rpx; color: #6F7C70; line-height: 1.7; margin-top: 6rpx; }
.role-note { font-size: 22rpx; color: #788572; margin-top: 16rpx; }

.heading-actions{display:flex;align-items:center;gap:8rpx}.booking-mask{position:fixed;inset:0;z-index:500;background:rgba(0,0,0,.3);display:flex;align-items:flex-end}.booking-sheet{width:100%;box-sizing:border-box;background:#fff;padding:32rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));border-radius:36rpx 36rpx 0 0}.booking-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:24rpx}.booking-head .booking-title{margin-bottom:0}.booking-close{width:56rpx;height:56rpx;line-height:52rpx;padding:0;margin:0;border-radius:50%;background:#2E4A38;color:#FFFFFF;font-size:30rpx;text-align:center;flex-shrink:0}.booking-close::after{border:0}.booking-title{font-size:36rpx;font-weight:700;margin-bottom:24rpx;color:#1d1d1f}.booking-scroll{height:63vh}.booking-label{display:block;font-size:25rpx;font-weight:600;margin:26rpx 0 14rpx}.booking-input{height:78rpx;line-height:78rpx;padding:0 20rpx;border-radius:16rpx;background:#F5F5F7;box-sizing:border-box;font-size:28rpx}.booking-note{color:#6e6e73;font-size:25rpx;line-height:1.7;margin:10rpx 0}.booking-record{padding:20rpx 0;border-bottom:1rpx solid #eee;font-size:29rpx}.booking-error{font-size:25rpx;color:#a43c35;margin-top:20rpx}.booking-cancel{font-size:24rpx;line-height:2;background:#f5f5f7;color:#a43c35;margin:12rpx 0;width:fit-content;padding:8rpx 20rpx}.booking-sheet .button{margin-top:24rpx}
