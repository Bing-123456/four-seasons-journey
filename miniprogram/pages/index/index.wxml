<view wx:if="{{welcomeVisible}}" class="welcome-overlay" catchtouchmove="noop">
  <view class="welcome-center"><companion-view config="{{welcomeCompanion}}" size="420" animated="{{true}}"/><view class="welcome-title serif">{{L.welcome_title}}</view><view class="welcome-caption">{{L.welcome_caption}}</view><button id="welcome-companion" class="welcome-customize" bindtap="openCompanion">{{L.welcome_customize}}</button></view>
  <view class="welcome-brand serif">{{L.home_tagline1}}</view>
</view>
<view wx:if="{{roleSelectVisible}}" class="role-overlay" catchtouchmove="noop">
  <view class="role-card">
    <view class="role-title serif">{{L.role_title}}</view>
    <view class="role-option" id="role-tourist" data-role="tourist" bindtap="chooseRole" role="button">
      <view class="role-glyph serif">{{L.id_glyph_traveler}}</view>
      <view class="role-copy"><view class="role-name serif">{{L.role_tourist}}</view><view class="role-desc">{{L.role_tourist_desc}}</view></view>
    </view>
    <view class="role-option" id="role-farmer" data-role="farmer" bindtap="chooseRole" role="button">
      <view class="role-glyph serif">{{L.id_glyph_farmer}}</view>
      <view class="role-copy"><view class="role-name serif">{{L.role_farmer}}</view><view class="role-desc">{{L.role_farmer_desc}}</view></view>
    </view>
    <view class="role-note">{{L.role_note}}</view>
  </view>
</view>
<view class="home-screen {{fontClass}}">
  <view class="home-demo"><demo-notice id="demo-mode-notice"/></view>
  <view class="home-heading"><view class="heading-copy"><view class="home-kicker">{{termNote.name}} · {{visualCopy.journal}}</view><view class="home-brand">{{L.home_tagline1}}</view></view><view class="heading-actions"><me-entry/></view></view>
  <view id="guoling-search" class="home-search" bindtap="openSearch" role="button" aria-label="{{L.id_search_aria}}"><text class="search-symbol">⌕</text><text>{{L.search_local_web}}</text><text class="search-go">›</text></view>
  <view id="farming-forecast" class="feature-region">
    <swiper class="feature-swiper" current="{{featureIndex}}" bindchange="changeFeature" autoplay="{{false}}" circular="{{forecastPosters.length > 1}}" duration="320" previous-margin="{{featureSideMargin}}px" next-margin="{{featureSideMargin}}px">
      <swiper-item wx:for="{{forecastPosters}}" wx:key="id">
        <view class="feature-card {{featureIndex === index ? 'is-current' : ''}}" data-id="{{item.id}}" bindtap="openBooking" role="button" aria-label="{{item.title}} · {{visualCopy.eventAction}}">
          <image class="feature-image feature-image-bg" src="{{item.imageBg || item.image}}" mode="aspectFill" aria-hidden="true"/>
          <image class="feature-image feature-image-main" src="{{item.image}}" mode="aspectFit" aria-label="{{item.title}}"/>
          <view wx:if="{{item.bookable}}" class="activity-cover-copy"><view class="activity-cover-title">{{item.title}}</view><view>{{item.place}}</view><view>{{item.date}}</view></view>
        </view>
      </swiper-item>
    </swiper>
    <view class="feature-dots"><view wx:for="{{forecastPosters}}" wx:key="id" class="feature-dot-hit" data-index="{{index}}" bindtap="selectFeature" role="button" aria-label="{{item.title}}"><view class="feature-dot {{featureIndex === index ? 'active' : ''}}"/></view></view>
  </view>
  <view class="home-shortcuts">
    <view id="journal-entry" class="shortcut-card journal-shortcut" bindtap="openJournal" role="button"><image class="shortcut-image" src="/assets/illustrations/orchard-garden.jpg" mode="aspectFill"/><view class="shortcut-shade"/><view class="shortcut-text"><text>{{visualCopy.reading}}</text><view>{{visualCopy.readingTitle}} <text>›</text></view></view></view>
    <view wx:if="{{identity.role !== 'farmer'}}" id="profile-bag" class="shortcut-card profile-shortcut" bindtap="openPlaceFinder" role="button" aria-label="{{L.id_bag_aria}}"><image class="shortcut-fruit" src="/assets/illustrations/loquat-still-life.jpg" mode="aspectFill"/><view class="shortcut-text"><text>{{visualCopy.collection}}</text><view>{{L.id_bag_title}} <text>›</text></view></view></view>
    <view wx:else id="farmer-entry" class="shortcut-card profile-shortcut" bindtap="openSeller" role="button"><image class="shortcut-fruit" src="/assets/illustrations/loquat-still-life.jpg" mode="aspectFill"/><view class="shortcut-text"><text>{{L.role_farmer}}</text><view>{{L.farmer_studio}} <text>›</text></view></view></view>
  </view>
</view>

<view wx:if="{{bookingVisible}}" class="booking-mask" catchtouchmove="noop" bindtap="closeBooking"><view class="booking-sheet" catchtap="noop"><view class="booking-head"><view class="booking-title">{{bookingActivity ? bookingActivity.title : bookingCopy.mine}}</view><button class="booking-close" bindtap="closeBooking" disabled="{{bookingBusy}}" aria-label="✕">✕</button></view><scroll-view scroll-y class="booking-scroll"><block wx:if="{{bookingActivity}}"><view class="booking-note">{{bookingActivity.description}}</view><view class="booking-note">{{bookingActivity.place}} · {{bookingActivity.date}}</view><view wx:if="{{!bookingActivity.bookable}}" class="booking-note">{{bookingCopy.sample}}</view><block wx:else><label class="booking-label">{{bookingCopy.date}}</label><picker mode="date" start="{{bookingActivity.startDate}}" end="{{bookingActivity.endDate}}" value="{{bookingDate}}" data-field="bookingDate" bindchange="bookingInput"><view class="booking-input">{{bookingDate}} ⌄</view></picker><label class="booking-label">{{bookingCopy.people}}</label><input class="booking-input" type="number" value="{{bookingPeople}}" maxlength="2" data-field="bookingPeople" bindinput="bookingInput"/><button class="button" bindtap="confirmBooking" disabled="{{bookingBusy}}" loading="{{bookingBusy}}">{{bookingCopy.reserve}}</button></block></block><view wx:if="{{bookingError}}" class="booking-error" role="alert">{{bookingError}}</view><view class="booking-label">{{bookingCopy.mine}}</view><view wx:if="{{!myBookings.length}}" class="booking-note">{{bookingCopy.empty}}</view><view wx:for="{{myBookings}}" wx:key="id" class="booking-record"><view>{{item.activityTitle}}</view><view class="booking-note">{{item.date}} · {{item.people}} {{isEnglish ? 'people' : '人'}} · {{item.status === 'confirmed' ? bookingCopy.confirmed : bookingCopy.cancelled}}</view><view class="booking-note">{{item.location}}</view><button wx:if="{{item.status === 'confirmed'}}" class="booking-cancel" data-id="{{item.id}}" bindtap="cancelBooking" disabled="{{bookingBusy}}">{{bookingCopy.cancel}}</button></view></scroll-view><button class="text-button" bindtap="closeBooking" disabled="{{bookingBusy}}">{{bookingCopy.close}}</button></view></view>
