page{background:#F5F5F7}
.fruit-page{padding:30rpx 32rpx calc(60rpx + env(safe-area-inset-bottom))}
.fruit-heading{padding:10rpx 4rpx 30rpx}
.fruit-season{font-size:23rpx;color:#728B77;font-weight:500}
.fruit-name{font-size:58rpx;font-weight:700;color:#1F3026;line-height:1.3;margin:14rpx 0 18rpx;letter-spacing:-1rpx}
.fruit-intro{font-size:23rpx;line-height:1.7;color:#8C948B}
.fruit-categories{background:#FFFFFF;border-radius:24rpx;padding:0 26rpx;overflow:hidden}
.fruit-cat{border-bottom:1rpx solid #EEF0EB}
.fruit-cat:last-child{border:0}
.fruit-cat-head{display:flex;align-items:center;gap:16rpx;padding:25rpx 0;min-height:126rpx}
.category-number{width:28rpx;flex-shrink:0;color:#B0B9AA;font-size:21rpx;font-weight:600;align-self:flex-start;padding-top:5rpx}
.category-copy{flex:1;min-width:0}
.fruit-cat-label{font-size:28rpx;font-weight:600;color:#2F4838;line-height:1.5}
.category-preview{font-size:23rpx;line-height:1.6;color:#8E978B;margin-top:8rpx;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}
.fruit-cat-tools{display:flex;align-items:center;gap:10rpx;flex-shrink:0}
.fruit-fav{font-size:31rpx;line-height:1;color:#B2BCAE;padding:10rpx 4rpx}
.fruit-fav.is-fav{color:#D0342C}
.fruit-toggle{font-size:30rpx;line-height:1;color:#B0B7AB}
.back-button{margin-top:24rpx}
