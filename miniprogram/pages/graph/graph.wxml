<demo-notice id="demo-mode-notice"/>
<view class="page graph-page {{fontClass}}"><view class="page-title serif">{{L.gr_title}}</view><view class="muted">{{L.gr_intro}}</view><view class="interest-row"><button wx:for="{{interests}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleInterest" class="{{item.selected?'selected':''}}">{{item.selected?'✓ ':'+ '}}{{item.label}}</button></view><view class="graph-tabs"><view wx:for="{{seasons}}" wx:key="id" data-id="{{item.id}}" bindtap="choose" class="{{season===item.id?'active':''}}">{{item.symbol}} · {{item.crop}}</view></view>
<view class="graph-hub"><view class="hub-caption">{{L.gr_crop_season}}</view><view class="serif">{{graph.season.crop}}</view><text>{{graph.season.name}}</text></view><view class="trunk"></view><view class="branch-caption">{{L.gr_farm_life}}</view>
<view class="graph-branches"><view wx:for="{{graph.places}}" wx:key="id" class="graph-node"><view class="node-head" bindtap="focus" data-id="{{item.id}}"><view><text class="node-kind">{{L.gr_story_node}} · {{item.factCount}} {{L.gr_notes_suffix}}</text><view class="node-title">{{item.name}}</view></view><text class="node-open">{{focusedId===item.id?'−':'+'}}</text></view><view wx:if="{{item.match}}" class="match">{{L.gr_interest_link}} {{item.match}} {{L.gr_interest_suffix}}</view><view wx:if="{{focusedId===item.id}}" class="fact-nodes"><view wx:for="{{item.facts}}" wx:for-item="fact" wx:key="id" class="fact-node" data-id="{{item.id}}" bindtap="open">{{fact.title}} ↗</view></view><view class="node-actions"><button data-id="{{item.id}}" bindtap="open">{{L.gr_read_story}}</button><button wx:if="{{item.lesson}}" data-id="{{item.id}}" bindtap="lesson">{{item.lesson.symbol}} · {{L.gr_interactive_class}}</button></view></view></view>
<view class="extension-caption">{{L.gr_extend_real}}</view><view wx:for="{{graph.venues}}" wx:key="id" class="venue-node"><view data-id="{{item.id}}" bindtap="open"><view class="node-kind">{{item.kind}}</view><view class="node-title">{{item.name}} ↗</view></view><button wx:if="{{item.lesson}}" bindtap="lesson" data-id="{{item.id}}">{{L.gr_3d_class}}</button></view><view class="muted graph-note">{{L.gr_note}}</view><button class="button" bindtap="plan">{{L.gr_plan_trip}}</button></view>
