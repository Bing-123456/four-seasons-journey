/* 分步向导：与行程页同一套米白卡片 + 深绿主色 #234B3C；不新增图片资源。
   分包页面不能 @import 主包页面样式，route-heading / error-message 在此就地定义（与行程页一致）。 */
.wizard-page{padding-bottom:230rpx}
.route-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:18rpx;margin:4rpx 0 28rpx}
.route-heading>view:first-child{flex:1;min-width:0}
.route-heading .page-title{font-size: calc(48rpx * var(--fs-scale, 1));line-height:1.45;margin:0;letter-spacing:1rpx}
.route-head-tools{display:flex;align-items:center;gap:14rpx;max-width:48%;flex-shrink:0}
.wizard-page button{white-space:normal}
.wiz-progress{display:flex;align-items:center;gap:10rpx;margin:2rpx 2rpx 26rpx}
.wiz-dot{flex:1;height:8rpx;border-radius:6rpx;background: #E1E5D9}
.wiz-dot.done{background: #DCE5D0}
.wiz-dot.now{background: #234B3C}
.wiz-step-word{flex-shrink:0;font-size: calc(21rpx * var(--fs-scale, 1));color: #87917B;margin-left:8rpx;font-variant-numeric:tabular-nums}
.wiz-question{font-size: calc(38rpx * var(--fs-scale, 1));font-weight:700;line-height:1.5;color: #2E4A38;letter-spacing:1rpx}
.wiz-sub{margin:10rpx 2rpx 28rpx;line-height:1.8}
.wiz-body{display:flex;flex-direction:column;gap:18rpx}
.wiz-card{position:relative;background: #F7F5ED;border: 1rpx solid #DCE5D0;border-radius: 28rpx;padding:26rpx 24rpx}
.wiz-card.is-on{border-color: #234B3C;background: #EAF0E0}
.wiz-card-name{font-size: calc(32rpx * var(--fs-scale, 1));font-weight:700;color: #2E4A38}
.wiz-card-hook{font-size: calc(23rpx * var(--fs-scale, 1));color: #47634B;margin-top:10rpx;line-height:1.7}
.wiz-check{position:absolute;top:22rpx;right:24rpx;color: #234B3C;font-size: calc(26rpx * var(--fs-scale, 1));font-weight:700}
.wiz-option{background: #F7F5ED;border: 1rpx solid #DCE5D0;border-radius: 18rpx;padding:24rpx;font-size: calc(26rpx * var(--fs-scale, 1));color: #2E4A38;line-height:1.6;display:flex;justify-content:space-between;gap:14rpx;align-items:center;overflow-wrap:anywhere}
.wiz-option.is-on{border-color: #234B3C;background: #EAF0E0;color: #234B3C;font-weight:600}
.wiz-value{flex-shrink:0;font-size: calc(21rpx * var(--fs-scale, 1));color: #87917B;font-weight:400}
.wiz-origin{font-size: calc(23rpx * var(--fs-scale, 1));color: #47634B;background: #F0ECDE;border-radius:14rpx;padding:18rpx 20rpx;line-height:1.7;overflow-wrap:anywhere}
.wiz-pair{display:flex;gap:16rpx}
.wiz-pair .button-secondary{flex:1;min-width:0}
.wiz-tags{display:flex;flex-wrap:wrap;gap:16rpx}
.wiz-tag{background: #F7F5ED;border: 1rpx solid #DCE5D0;border-radius:999rpx;padding:18rpx 30rpx;font-size: calc(26rpx * var(--fs-scale, 1));color: #2E4A38;line-height:1.5}
.wiz-tag.is-on{background: #234B3C;border-color: #234B3C;color: #87917B}
.wiz-rows{background: #F0ECDE;border-radius: 28rpx;padding:10rpx 24rpx}
.wiz-row{display:flex;justify-content:space-between;gap:20rpx;padding:16rpx 0;border-bottom: 1rpx solid #DCE5D0;font-size: calc(23rpx * var(--fs-scale, 1));line-height:1.7}
.wiz-row:last-child{border-bottom:0}
.wiz-k{flex-shrink:0;color: #47634B}
.wiz-v{text-align:right;color: #2E4A38;overflow-wrap:anywhere}
.wiz-footnote{font-size: calc(21rpx * var(--fs-scale, 1));color: #87917B;line-height:1.8}
.error-message{font-size: calc(23rpx * var(--fs-scale, 1));line-height:1.8;padding:20rpx 24rpx;color: #B96D50;background: #F0ECDE;border: 1rpx solid #F3E3C8;border-radius: 18rpx;overflow-wrap:anywhere}
.wiz-footer{position:fixed;left:0;right:0;bottom:0;display:flex;gap:16rpx;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));background:rgba(245,245,247,.97);border-top: 1rpx solid #E1E5D9}
.wiz-footer .button,.wiz-footer .button-secondary{flex:1;min-width:0}
