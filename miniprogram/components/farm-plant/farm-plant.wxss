:host{display:block;width:300rpx;height:280rpx}.growth-scene{position:relative;width:100%;height:100%;--stem:#587E45;--leaf:#70A567}.soil-shadow{position:absolute;bottom:13rpx;left:64rpx;width:180rpx;height:22rpx;border-radius:50%;background:rgba(55,81,49,.15)}.plant-stem{position:absolute;left:148rpx;bottom:24rpx;width:7rpx;height:68rpx;background:var(--stem);border-radius:8rpx;transform-origin:bottom;transition:height .7s}.plant-leaf{position:absolute;width:42rpx;height:23rpx;background:linear-gradient(145deg,#A7C594,var(--leaf));box-shadow:inset 0 -2rpx 0 rgba(28,77,37,.1);transition:bottom .7s}.leaf-left{border-radius:3rpx 80% 3rpx 80%;transform:rotate(20deg);left:111rpx}.leaf-right{border-radius:80% 3rpx 80% 3rpx;transform:rotate(-20deg);left:151rpx}.leaf-1,.leaf-2{bottom:65rpx}.leaf-3,.leaf-4{bottom:105rpx;width:44rpx;height:26rpx}.leaf-5,.leaf-6{bottom:141rpx;width:48rpx;height:30rpx}.leaf-5{left:106rpx}.leaf-7{bottom:87rpx;left:66rpx}.leaf-8{bottom:93rpx;left:190rpx}.phase-1 .plant-stem{height:109rpx}.phase-2 .plant-stem{height:148rpx}.phase-3 .plant-stem,.phase-4 .plant-stem,.phase-5 .plant-stem{height:182rpx}.plant-branch{position:absolute;bottom:47rpx;left:148rpx;width:5rpx;height:77rpx;background:var(--stem);border-radius:9rpx;transform-origin:bottom}.branch-left{transform:rotate(-48deg)}.branch-right{transform:rotate(48deg)}.plant-flower{position:absolute;width:30rpx;height:30rpx;background:#F2D78E;border-radius:50% 25% 50% 25%;box-shadow:0 0 0 4rpx rgba(255,244,199,.7);transform:rotate(45deg)}.flower-center{position:absolute;inset:10rpx;background:#BA9044;border-radius:50%}.flower-left{bottom:119rpx;left:82rpx}.flower-right{bottom:177rpx;left:139rpx}.ripe-fruit{position:absolute;left:101rpx;bottom:8rpx;filter:drop-shadow(0 5rpx 6rpx rgba(45,70,34,.13))}.form-tree{--stem:#8F7958;--leaf:#689159}.form-tree.phase-3 .plant-stem,.form-tree.phase-4 .plant-stem,.form-tree.phase-5 .plant-stem{width:10rpx}.form-bush .plant-stem{max-height:136rpx}.form-bush .leaf-5,.form-bush .leaf-6{bottom:116rpx}.form-bush .flower-right{bottom:146rpx}.form-vine.phase-3 .plant-stem,.form-vine.phase-4 .plant-stem,.form-vine.phase-5 .plant-stem{transform:rotate(5deg)}.phase-0 .plant-leaf{width:29rpx;height:18rpx}.phase-0 .leaf-left{left:124rpx}.phase-0 .leaf-1,.phase-0 .leaf-2{bottom:66rpx}.phase-5 .flower-left{display:none}
