:host{display:inline-block;vertical-align:middle}.companion{position:relative;display:block}.drawing{width:100%;height:100%;display:block}.companion-greeting{animation:greet-sway 1.3s ease-in-out 1;transform-origin:50% 80%}.wave-layer{position:absolute;inset:0;pointer-events:none}.wave-arm{position:absolute;left:74%;top:49%;width:8%;height:4%;border-bottom:2px solid #234B3C;transform:rotate(-32deg);transform-origin:0 100%;animation:greet-wave 1.2s ease-in-out 1}.wave-hand{position:absolute;right:-1px;bottom:0;height:140%;border-right:2px solid #234B3C;border-radius:3px}.fallback-fruit{position:absolute;left:22%;top:23%;width:56%;height:56%;border-radius:48%;border:2px solid #234B3C;background:#C7D8A5;box-shadow:inset 12px 0 #91AD7D,inset -12px 0 #91AD7D;text-align:center;color:#234B3C}.fallback-eyes{font-size:34rpx;line-height:1;margin-top:24%;letter-spacing:12rpx;padding-left:12rpx}.fallback-smile{font-size:25rpx;line-height:1}@keyframes greet-sway{0%,100%{transform:rotate(0)}35%{transform:rotate(-3deg)}70%{transform:rotate(2deg)}}@keyframes greet-wave{0%,100%{transform:rotate(-32deg)}25%,65%{transform:rotate(-65deg)}45%,85%{transform:rotate(-15deg)}}

.photo-avatar{width:100%;height:100%;border-radius:50%;background:#EAF2E0}
