.demo-notice{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:14rpx 32rpx 0;padding:13rpx 18rpx;border:1rpx solid #DDDDBE;border-radius:12rpx;background:#F0EFDB;color:#6B7351;font-size:calc(21rpx * var(--fs-scale, 1));line-height:1.5;box-sizing:border-box}.notice-copy{display:flex;align-items:center;gap:12rpx}.notice-dot{width:7rpx;height:7rpx;border-radius:50%;background:#A6A375;flex-shrink:0}.notice-arrow{font-size:calc(24rpx * var(--fs-scale, 1));color:#8C956C;flex-shrink:0}
