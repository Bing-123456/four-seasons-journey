/* Shared field-journal palette and type rhythm. */
page {
  --green: #234B3C;
  --cream: #F5F5F7;
  --red: #B96D50;
  --muted: #6F7C70;
  background: #F5F5F7;
  color: #1D1D1F;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: calc(28rpx * var(--fs-scale, 1));
  line-height: 1.65;
}
view, text, button, input, textarea { box-sizing: border-box; }
button { font: inherit; margin: 0; border-radius: 18rpx; }
button::after { border: none; }
button[disabled] { opacity: .5; }
input, textarea { font: inherit; color: #1D1D1F; }
image { display: block; }
.page { padding: 32rpx 36rpx 80rpx; }
.tab-page { padding-bottom: calc(174rpx + env(safe-area-inset-bottom)); }
.row { display: flex; align-items: center; gap: 16rpx; }
.eyebrow { font-size: calc(19rpx * var(--fs-scale, 1)); letter-spacing: 3rpx; color: #77836F; font-weight: 600; line-height: 1.6; }
.page-title { font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: calc(48rpx * var(--fs-scale, 1)); line-height: 1.25; font-weight: 700; margin: 16rpx 0 20rpx; letter-spacing: -1rpx; }
.serif { font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.muted { color: #6F7C70; font-size: calc(24rpx * var(--fs-scale, 1)); }
.card { background: #FFFFFF; border: 0; border-radius: 28rpx; padding: 30rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,.025); }
.button { width: 100%; background: #234B3C; color: #FFFDF8; text-align: center; font-weight: 600; font-size: calc(27rpx * var(--fs-scale, 1)); line-height: 1.5; padding: 24rpx 28rpx; display: block; border-radius: 18rpx; letter-spacing: 1rpx; }
.button-secondary { width: 100%; background: #E9EEE3; color: #234B3C; text-align: center; font-size: calc(26rpx * var(--fs-scale, 1)); padding: 22rpx 26rpx; line-height: 1.5; display: block; border-radius: 18rpx; }
button.button:not([size="mini"]), button.button-secondary:not([size="mini"]) { width: 100%; margin-left: 0; margin-right: 0; }
.pill { display: inline-flex; align-items: center; border-radius: 8rpx; padding: 6rpx 14rpx; font-size: calc(21rpx * var(--fs-scale, 1)); background: #EBEEE5; color: #47634B; margin-right: 10rpx; }
.section-title { font-size: calc(32rpx * var(--fs-scale, 1)); font-weight: 600; margin: 36rpx 0 22rpx; letter-spacing: 1rpx; line-height: 1.5; }
.demo-note { font-size: calc(22rpx * var(--fs-scale, 1)); color: #826B4B; background: #F0ECDE; padding: 20rpx 24rpx; border-radius: 14rpx; line-height: 1.8; margin: 22rpx 0; }
.field-label { font-size: calc(26rpx * var(--fs-scale, 1)); font-weight: 600; display: block; margin: 24rpx 0 12rpx; }
.empty { padding: 70rpx 32rpx; text-align: center; color: #6F7C70; line-height: 1.9; }
.empty .button { margin-top: 28rpx; }
.divider { height: 1rpx; background: #E1E5D9; margin: 28rpx 0; }
.small { font-size: calc(22rpx * var(--fs-scale, 1)); }
.link { color: #234B3C; text-decoration: underline; text-underline-offset: 5rpx; }
.loading-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #A8BA88; display: inline-block; margin-right: 12rpx; }
.subheading { font-size: calc(28rpx * var(--fs-scale, 1)); font-weight: 600; }
.safe-bottom { height: env(safe-area-inset-bottom); }
/* 字体大小三档（「我的-字体大小」设置，评审 P05① / 10.2①）：页面根节点挂 fs-normal / fs-large /
   fs-xlarge（app.js getFontClass()）。根节点写入 --fs-scale，页面内所有 font-size 统一写成
   calc(Nrpx * var(--fs-scale, 1))，因此整页「任何」元素都会同步放大，不再依赖类名白名单。
   新增样式沿用 calc(Nrpx * var(--fs-scale, 1)) 写法即可自动跟随。 */
.fs-normal { --fs-scale: 1; }
.fs-large { --fs-scale: 1.15; }
.fs-xlarge { --fs-scale: 1.32; }
