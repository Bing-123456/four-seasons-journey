.route-page{padding:30rpx 32rpx calc(214rpx + env(safe-area-inset-bottom))}.route-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:18rpx;margin:4rpx 0 28rpx}.route-heading>view:first-child{flex:1;min-width:0}.route-heading .page-title{font-size:calc(44rpx * var(--fs-scale, 1));line-height:1.45;margin:0;letter-spacing:1rpx}.route-head-tools{display:flex;align-items:center;gap:14rpx;max-width:48%;flex-shrink:0}.route-page button{white-space:normal}.journey-summary{padding:24rpx;background:#F0EEE0;border:1rpx solid #DFDFCD;border-radius:22rpx}.summary-top,.summary-main,.summary-bottom{display:flex;justify-content:space-between;align-items:center;gap:14rpx;flex-wrap:wrap}.journey-date{font-size:calc(24rpx * var(--fs-scale, 1));color:#5F7152}.scenario-label{font-size:calc(21rpx * var(--fs-scale, 1));color:#9F7955;padding:5rpx 10rpx;border:1rpx solid #DCCDB2;border-radius:7rpx;max-width:100%}.summary-main{margin:22rpx 0 18rpx;align-items:baseline;gap:16rpx 22rpx}.journey-time{font-family:Georgia,serif;font-size:calc(47rpx * var(--fs-scale, 1));font-variant-numeric:tabular-nums;line-height:1.3;letter-spacing:-1rpx;color:#294B38;white-space:nowrap}.journey-time text{font-size:calc(29rpx * var(--fs-scale, 1));color:#A3A487;padding:0 13rpx}.journey-cost{font-size:calc(24rpx * var(--fs-scale, 1));line-height:1.6;color:#728065;max-width:100%;overflow-wrap:anywhere}.cost-suffix{font-size:calc(20rpx * var(--fs-scale, 1));color:#8A907B;margin-left:8rpx}.summary-bottom{padding-top:17rpx;border-top:1rpx solid #DADBC9;font-size:calc(21rpx * var(--fs-scale, 1));color:#788369;line-height:1.8}.summary-bottom>text{flex:1;min-width:210rpx}.text-button{width:auto;margin:0;padding:12rpx 0 12rpx 10rpx;font-size:calc(22rpx * var(--fs-scale, 1));line-height:1.55;background:transparent;color:#6A8059;border-radius:0;max-width:45%;flex-shrink:0}.demo-caption{display:flex;align-items:flex-start;gap:10rpx;font-size:calc(21rpx * var(--fs-scale, 1));line-height:1.8;color: