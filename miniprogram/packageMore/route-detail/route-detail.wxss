.preview-intro{margin:2rpx 4rpx 28rpx}.empty-title{font-size:calc(32rpx * var(--fs-scale, 1));line-height:1.6;color:#3E573B;margin-bottom:14rpx}.preview-intro .muted{font-size:calc(24rpx * var(--fs-scale, 1));line-height:1.85}.preview-label{max-width:40%;font-size:calc(20rpx * var(--fs-scale, 1));line-height:1.5;color:#8B9274;text-align:right}.preview-map{height:374rpx}.preview-place-row{display:flex;flex-wrap:wrap;gap:14rpx;margin:22rpx 0 30rpx}.preview-place{flex:1 1 250rpx;display:flex;align-items:center;justify-content:space-between;gap:14rpx;background:#FBF9EF;border:1rpx solid #E0E1CE;border-radius:16rpx;padding:22rpx;font-size:calc(25rpx * var(--fs-scale, 1));color:#5A7450;line-height:1.7;overflow-wrap:anywhere}.preview-place text{color:#B08B63;flex-shrink:0}.preview-hint{font-size:calc(22rpx * var(--fs-scale, 1));line-height:1.8;color:#8E947C;margin:17rpx 8rpx 0;text-align:center}.no-solution{padding:36rpx 26rpx;background:#EFEDDE;border:1rpx solid #E0DDC8;border-radius:22rpx;margin-top:12rpx}.no-solution .muted{line-height:1.9;font-size:calc(25rpx * var(--fs-scale, 1))}.no-solution .button,.no-solution .button-secondary{margin-top:24rpx}.error-message{font-size:calc(24rpx * var(--fs-scale, 1));line-height:1.8;padding:20rpx 24rpx;margin-top:22rpx;color:#A1654B;background:#F4E7DD;border:1rpx solid #E7D0C0;border-radius:16rpx;overflow-wrap:anywhere}.route-add{position:fixed;right:30rpx;bottom:calc(148rpx + env(safe-area-inset-bottom));width:86rpx!important;height:86rpx;line-height:80rpx;font-size:calc(44rpx * var(--fs-scale, 1));border-radius:50%;background:#234B3C;color:#FFF9E8;box-shadow:0 7rpx 18rpx rgba(35,75,60,.14);padding:0!important;margin:0!important;z-index:8}

