.journal-page { background: #F5F5F7; }
.news-head { display:none; }
.news-block { margin: 25rpx 0 32rpx; }
.news-head .section-title { font-family:inherit; margin: 0 0 20rpx; font-size: calc(32rpx * var(--fs-scale, 1)); }
.news-card { background: #FFFDF8; border: 1rpx solid #E1E5D9; border-radius: 28rpx; padding: 28rpx; margin-bottom: 20rpx; overflow: hidden; }
.news-card-top { display: flex; justify-content: space-between; align-items: baseline; gap: 20rpx; margin-bottom: 16rpx; }
.news-tag { font-size: calc(21rpx * var(--fs-scale, 1)); letter-spacing: 1rpx; color: #826B4B; }
.news-issue { font-family: Georgia, serif; font-size: calc(23rpx * var(--fs-scale, 1)); color: #B96D50; }
.news-title { font-size: calc(28rpx * var(--fs-scale, 1)); font-weight: 600; color: #2E4A38; line-height: 1.6; margin-bottom: 15rpx; }
.news-text { font-size: calc(23rpx * var(--fs-scale, 1)); color: #47634B; line-height: 1.9; }
.news-clamp { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.news-clamp.is-open { display: block; -webkit-line-clamp: unset; }
.news-more { font-size: calc(23rpx * var(--fs-scale, 1)); color: #47634B; margin-top: 18rpx; padding: 5rpx 0; }
.news-story-visual { position: relative; margin: 4rpx 0 22rpx; border-radius: 14rpx; overflow: hidden; background: #F0ECDE; }
.news-story-art { display: block; width: 100%; height: auto; }
.news-art-credit { position: absolute; right: 10rpx; bottom: 10rpx; padding: 4rpx 9rpx; border-radius: 6rpx; background: rgba(255,253,246,.85); color: #65735B; font-size: calc(19rpx * var(--fs-scale, 1)); }
.news-en { display: inline-block; margin-top: 12rpx; color: #47634B; font-size: calc(21rpx * var(--fs-scale, 1)); background: #EBEEE5; border-radius: 8rpx; padding: 7rpx 15rpx; }
.news-en.on { color: #87917B; background: #47634B; }
.news-src { margin-top: 14rpx; font-size: calc(21rpx * var(--fs-scale, 1)); color: #87917B; line-height: 1.6; }

.news-title { font-family:inherit; }
.news-card { background:#FFF; border:0; border-radius: 28rpx; }
