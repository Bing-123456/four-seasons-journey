.profile-page{padding:36rpx 32rpx calc(64rpx + env(safe-area-inset-bottom))}
.profile-heading{padding:4rpx 4rpx 30rpx;border-bottom: 1rpx solid #DCE5D0;margin-bottom:30rpx}
.profile-heading .page-title{font-size: calc(48rpx * var(--fs-scale, 1));line-height:1.5;letter-spacing:1rpx;margin:0 0 18rpx}.title-accent{color: #B96D50}.intro{font-size: calc(23rpx * var(--fs-scale, 1));line-height:1.9;max-width:610rpx}
.form-section{margin-bottom:34rpx}.origin-section{padding:26rpx;background: #F0ECDE;border: 1rpx solid #DCE5D0;border-radius: 28rpx}.origin-card{display:flex;align-items:flex-start;gap:18rpx}.origin-copy{flex:1;min-width:0}.origin-card .field-label{margin:0 0 10rpx;font-size: calc(21rpx * var(--fs-scale, 1));color: #47634B;letter-spacing:2rpx}.origin-name{font-size: calc(28rpx * var(--fs-scale, 1));font-weight:600;line-height:1.5;overflow-wrap:anywhere}.origin-address{font-size: calc(21rpx * var(--fs-scale, 1));color: #47634B;line-height:1.8;margin-top:10rpx;overflow-wrap:anywhere}.profile-page .origin-button{flex-shrink:0;width:auto!important;margin:0!important;padding:14rpx 18rpx;font-size: calc(23rpx * var(--fs-scale, 1));line-height:1.5;border-radius:12rpx;background: #FFFDF8;border: 1rpx solid #DCE5D0;max-width:170rpx}
.origin-actions{display:flex;gap:12rpx;margin-top:24rpx}.origin-actions button{flex:1;min-width:0;margin:0;padding:20rpx 12rpx;font-size: calc(23rpx * var(--fs-scale, 1));line-height:1.5;background: #FFFDF8;color: #2E4A38;border: 1rpx solid #DCE5D0;border-radius:14rpx;white-space:normal}.location-settings{display:flex;align-items:center;gap:14rpx;margin-top:18rpx;font-size: calc(21rpx * var(--fs-scale, 1));color: #826B4B}.location-settings text{flex:1;min-width:0}.location-settings button{margin:0;padding:12rpx 20rpx;line-height:1.5;font-size: calc(23rpx * var(--fs-scale, 1));background: #234B3C;color: #FFFDF8;flex-shrink:0}
.origin-shortcuts{border-top: 1rpx solid #DCE5D0;padding-top:22rpx;margin-top:24rpx}.origin-shortcut-label{font-size: calc(21rpx * var(--fs-scale, 1));line-height:1.7;color: #47634B;margin-bottom:14rpx}.origin-chip-row{display:flex;flex-wrap:wrap;gap:12rpx}.origin-chip{display:flex;align-items:center;gap:14rpx;margin:0!important;width:auto;max-width:100%;padding:14rpx 18rpx;font-size: calc(21rpx * var(--fs-scale, 1));line-height:1.6;text-align:left;color: #47634B;background: #F7F5ED;border: 1rpx solid #DCE5D0;border-radius:12rpx;white-space:normal}.origin-chip text{margin-left:auto;flex-shrink:0;color: #B96D50}.origin-chip.selected{background: #E1E5D9;border-color: #DCE5D0;color: #2E4A38}.origin-status{font-size: calc(21rpx * var(--fs-scale, 1));line-height:1.8;margin-top:18rpx;color:#637551;overflow-wrap:anywhere}
.preferences-section{padding:0 4rpx}.section-label{margin-top:0}.field-label{font-size: calc(26rpx * var(--fs-scale, 1));line-height:1.6}.spaced{margin-top:30rpx}.season-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx}.season-option{display:flex;align-items:flex-start;min-width:0;gap:12rpx;padding:22rpx 17rpx;border:1rpx solid #DFE2D3;border-radius: 18rpx;background:#FFFDF7}.season-option.selected{background:#E7ECDB;border-color:#93A67F}.season-number{font-family:inherit;font-size: calc(38rpx * var(--fs-scale, 1));color:#8A785B;line-height:1.25;flex-shrink:0}.season-copy{min-width:0;flex:1}.season-name{font-size: calc(26rpx * var(--fs-scale, 1));font-weight:600;line-height:1.5;overflow-wrap:anywhere}.season-sub{font-size: calc(21rpx * var(--fs-scale, 1));color:#7A826C;line-height:1.6;margin-top:8rpx;overflow-wrap:anywhere}.check{font-size: calc(21rpx * var(--fs-scale, 1));color: #47634B;flex-shrink:0}
.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6rpx 20rpx;margin-top:14rpx}.form-field{min-width:0}.form-field .field-label{min-height:40rpx}.input-box{box-sizing:border-box;width:100%;height:92rpx;line-height:46rpx;padding:22rpx 20rpx;background: #FFFDF8;border: 1rpx solid #DCE5D0;border-radius:15rpx;font-size: calc(28rpx * var(--fs-scale, 1));color: #2E4A38;font-variant-numeric:tabular-nums}input.input-box{padding:0 20rpx;line-height:92rpx}.picker-arrow{float:right;color: #87917B}.option-row{display:flex;flex-wrap:wrap;gap:12rpx}.option-pill{font-size: calc(23rpx * var(--fs-scale, 1));line-height:1.65;padding:18rpx 24rpx;max-width:100%;border: 1rpx solid #DCE5D0;border-radius:14rpx;background: #FFFDF8;color: #47634B;overflow-wrap:anywhere}.option-pill.active{background: #234B3C;border-color: #234B3C;color: #87917B}
.letter-card{padding:28rpx;background: #FFFDF8;border: 1rpx solid #DCE5D0;border-radius: 28rpx;box-shadow:none}.letter-top{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size: calc(26rpx * var(--fs-scale, 1));color: #47634B;font-weight:600}.letter-mark{font-size: calc(32rpx * var(--fs-scale, 1));color: #B96D50}.wish-input{width:100%;height:200rpx;margin:22rpx 0;font-size: calc(26rpx * var(--fs-scale, 1));line-height:1.9;color: #2E4A38;box-sizing:border-box;padding:0 0 14rpx;border-bottom: 1rpx solid #E1E5D9}.textarea-placeholder{color: #87917B}.example-row{display:flex;flex-wrap:wrap;gap:12rpx}.example{font-size: calc(21rpx * var(--fs-scale, 1));line-height:1.6;color: #826B4B;padding:12rpx 14rpx;background: #F0ECDE;border-radius:10rpx;max-width:100%;overflow-wrap:anywhere}.profile-page .parse-button{margin-top:24rpx;padding:20rpx;font-size: calc(26rpx * var(--fs-scale, 1));background: #E9EEE3}.service-status{font-size: calc(21rpx * var(--fs-scale, 1));line-height:1.85;color:#75816B;padding-top:18rpx;overflow-wrap:anywhere}.planning-note{font-size: calc(21rpx * var(--fs-scale, 1));line-height:1.85;background: #F0ECDE;border-radius: 18rpx;padding:24rpx;color: #826B4B;margin-top:28rpx}.create-button{margin-top:26rpx}.footnote{font-size: calc(21rpx * var(--fs-scale, 1));color: #47634B;line-height:1.85;text-align:left;margin:22rpx 8rpx 0}.error-message{margin-top:18rpx;padding:22rpx 24rpx;border: 1rpx solid #F3E3C8;border-radius:14rpx;color: #826B4B;background: #F0ECDE;font-size: calc(23rpx * var(--fs-scale, 1));line-height:1.75;overflow-wrap:anywhere}
.sheet-overlay{position:fixed;inset:0;background:rgba(24,38,27,.45);z-index:120;display:flex;align-items:flex-end}.sheet-panel{width:100%;max-height:85vh;overflow-y:auto;box-sizing:border-box;background: #FFFDF8;border-radius: 30rpx 30rpx 0 0;padding:40rpx 32rpx calc(32rpx + env(safe-area-inset-bottom))}.sheet-title{font-size: calc(32rpx * var(--fs-scale, 1));line-height:1.6;margin-bottom:18rpx}.sheet-text{font-size: calc(26rpx * var(--fs-scale, 1));color: #47634B;line-height:1.9;margin-bottom:28rpx}.sheet-actions{display:flex;flex-direction:column;gap:14rpx}.sheet-actions button{width:100%;padding:22rpx;line-height:1.6;border-radius: 18rpx;font-size: calc(26rpx * var(--fs-scale, 1));white-space:normal}.sheet-allow{background: #234B3C;color: #FFFDF8}.sheet-deny{background: #F0ECDE;color: #47634B}
