.finder-page{padding:36rpx 32rpx calc(64rpx + env(safe-area-inset-bottom))}
.finder-head{position:relative;padding:28rpx 28rpx 30rpx;background: #EAF0E0;border: 1rpx solid #DCE5D0;border-radius: 28rpx;margin-bottom:34rpx;overflow:hidden}.finder-face{width:96rpx;height:96rpx;display:flex;align-items:center;justify-content:center;background: #FFFDF8;border-radius:50%;float:right;margin:0 0 14rpx 20rpx}.finder-title{font-size: calc(38rpx * var(--fs-scale, 1));line-height:1.5;color: #2E4A38;padding-top:4rpx;overflow-wrap:anywhere}.finder-sub{font-size: calc(23rpx * var(--fs-scale, 1));line-height:1.85;margin-top:15rpx;color: #47634B;overflow-wrap:anywhere}
.finder-question{margin:0 0 28rpx;padding:0 2rpx 28rpx;border-bottom: 1rpx solid #DCE5D0}.finder-q-title{display:flex;align-items:baseline;gap:14rpx;font-size: calc(28rpx * var(--fs-scale, 1));line-height:1.65;font-weight:600;margin-bottom:20rpx;color: #2E4A38}.finder-q-number{font-family:Georgia,serif;font-size: calc(28rpx * var(--fs-scale, 1));color: #B96D50;font-weight:400;flex-shrink:0}.finder-q-copy{flex:1;min-width:0;overflow-wrap:anywhere}.finder-multi{font-size: calc(21rpx * var(--fs-scale, 1));color: #47634B;flex-shrink:0;font-weight:400}
.finder-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx}.finder-option{display:flex;align-items:center;flex-wrap:wrap;gap:8rpx 10rpx;min-width:0;min-height:84rpx;padding:17rpx 18rpx;background: #FFFDF8;border: 1rpx solid #E1E5D9;border-radius:15rpx;font-size: calc(23rpx * var(--fs-scale, 1));line-height:1.6;color: #47634B}.finder-option.chosen{background: #E1E5D9;color: #2E4A38;border-color: #47634B}.finder-check{display:flex;align-items:center;justify-content:center;width:25rpx;height:25rpx;flex-shrink:0;border: 1rpx solid #DCE5D0;border-radius:7rpx;color: #87917B;font-size: calc(19rpx * var(--fs-scale, 1))}.chosen .finder-check{background: #2E4A38;border-color: #2E4A38}.finder-option-name{flex:1;min-width:0;overflow-wrap:anywhere}.finder-season{width:100%;padding-left:35rpx;font-size: calc(19rpx * var(--fs-scale, 1));color:#879674;line-height:1.3}.chosen .finder-season{color:#65814F}
.finder-actions{display:flex;align-items:center;gap:14rpx;margin-top:4rpx}.finder-generate{flex:1;min-width:0}.finder-reset{font-size: calc(21rpx * var(--fs-scale, 1));line-height:1.5;color: #47634B;background: #F5F5F7;padding:12rpx 20rpx;border-radius:14rpx;min-height:0;margin:0;flex:none}.finder-reset:after{border:0}.finder-note{font-size: calc(23rpx * var(--fs-scale, 1));line-height:1.8;color: #6F7C70;margin-top:18rpx;padding:20rpx 22rpx;background: #F0ECDE;border-radius:15rpx;overflow-wrap:anywhere}.finder-result-title{font-family:inherit;font-size: calc(32rpx * var(--fs-scale, 1));line-height:1.5;color: #2E4A38;margin:38rpx 0 22rpx}.place-card{display:flex;gap:22rpx;background: #FFFDF8;border: 1rpx solid #E1E5D9;border-radius: 28rpx;padding:18rpx;margin-bottom:18rpx}.place-photo{width:170rpx;height:186rpx;border-radius:14rpx;flex-shrink:0;background: #EAF0E0;object-fit:cover}.place-photo-wrap{position:relative;flex-shrink:0}.place-photo-tag{position:absolute;left:10rpx;bottom:10rpx;font-size: calc(19rpx * var(--fs-scale, 1));line-height:1.5;color:#FFF;background:rgba(46,74,56,.75);border-radius:8rpx;padding:2rpx 10rpx}.place-photo-fallback{display:flex;align-items:center;justify-content:center;font-size: calc(52rpx * var(--fs-scale, 1));color: #826B4B;background: #F0ECDE;border: 1rpx solid #DCE5D0}.place-copy{flex:1;min-width:0;padding:4rpx 0}.place-name{font-family:inherit;font-size: calc(28rpx * var(--fs-scale, 1));font-weight:600;color: #2E4A38;line-height:1.55;overflow-wrap:anywhere}.place-intro{font-size: calc(23rpx * var(--fs-scale, 1));color: #47634B;line-height:1.85;margin-top:12rpx;overflow-wrap:anywhere}
/* Shared app typography and quiet, readable result states. */
.finder-head{background:#FFF;border-color: #EBEEE5}.finder-option{background:#FFF;border-color: #E1E5D9}.finder-option.chosen{background: #EBEEE5;border-color: #47634B}.finder-q-number{font-family:inherit;font-weight:600}.place-card{background:#FFF;border-color: #EBEEE5;align-items:flex-start}.place-photo{height:210rpx}.place-photo-fallback{padding:18rpx;box-sizing:border-box;font-family:inherit;font-size: calc(21rpx * var(--fs-scale, 1));line-height:1.6;text-align:center;background: #F5F5F7;color: #6F7C70;border:0}.finder-virtual{font-size: calc(23rpx * var(--fs-scale, 1));font-weight:600;line-height:1.65;color: #2E4A38;margin-top:-8rpx}.finder-season-note{font-size: calc(21rpx * var(--fs-scale, 1));color:#8A8A8E;line-height:1.7;margin:10rpx 0 22rpx}.place-season{font-size: calc(21rpx * var(--fs-scale, 1));color:#6F7974;line-height:1.65;margin-top:13rpx}.place-months{font-size: calc(19rpx * var(--fs-scale, 1));color: #87917B;line-height:1.6;margin-top:5rpx}.place-retry,.finder-resume{font-size: calc(21rpx * var(--fs-scale, 1));line-height:1.5;color: #47634B;background: #F5F5F7;padding:12rpx 18rpx;border-radius:14rpx;min-height:0;margin:14rpx 0 0}.place-retry:after,.finder-resume:after{border:0}
