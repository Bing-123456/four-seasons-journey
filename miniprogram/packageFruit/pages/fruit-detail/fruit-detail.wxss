page{background: #F5F5F7}
.fruit-page{display:flex;flex-direction:column;min-height:100vh;box-sizing:border-box;padding:30rpx 32rpx calc(60rpx + env(safe-area-inset-bottom))}
.fruit-heading{flex-shrink:0;padding:10rpx 4rpx 30rpx}
.fruit-season{font-size: calc(23rpx * var(--fs-scale, 1));color:#728B77;font-weight:500}
.fruit-name{font-size: calc(52rpx * var(--fs-scale, 1));font-weight:700;color: #133C31;line-height:1.3;margin:14rpx 0 18rpx;letter-spacing:-1rpx}
.fruit-intro{font-size: calc(23rpx * var(--fs-scale, 1));line-height:1.7;color: #87917B}
/* 竹简（卷轴简）：上下两根轴 + 每片竹简；点开的那片变宽、旁边露出纸色正文。
   全部用 CSS 画（渐变 + 细线），不新增图片；wxml / js 未改动，交互与收藏逻辑不变。 */
.fruit-categories{flex:1;min-height:0;display:flex;align-items:stretch;gap:4rpx;background:transparent;padding:16rpx 0;overflow:visible;position:relative}
.fruit-categories::before,.fruit-categories::after{content:'';position:absolute;left:0;right:0;height:15rpx;border-radius:8rpx;background:linear-gradient(180deg,#7A5A32,#5E421F);box-shadow:0 2rpx 6rpx rgba(94,66,31,.25)}
.fruit-categories::before{top:0}
.fruit-categories::after{bottom:0}
.fruit-cat{flex:1 1 0;min-width:0;display:flex;align-items:stretch;border-radius:10rpx;background:transparent;overflow:hidden;transition:flex-grow .45s cubic-bezier(.22,.61,.36,1)}
.fruit-cat.is-open{flex-grow:3.4}
.fruit-cat-rail{position:relative;width:100%;min-width:0;display:flex;flex-direction:column;align-items:center;gap:10rpx;padding:22rpx 0 18rpx;border-radius:10rpx;background:linear-gradient(180deg,#F0E0BF 0%,#E2CBA1 100%);box-shadow:inset 0 0 0 1rpx rgba(140,104,58,.26)}
.fruit-cat-rail::before{content:'';position:absolute;left:6rpx;right:6rpx;top:46rpx;height:1rpx;background:rgba(140,104,58,.16)}
.fruit-cat-rail::after{content:'';position:absolute;left:6rpx;right:6rpx;bottom:46rpx;height:1rpx;background:rgba(140,104,58,.16)}
.fruit-cat.is-open .fruit-cat-rail{width:88rpx;flex-shrink:0;background:linear-gradient(180deg,#FBF1DC 0%,#EEDCBB 100%)}
.category-number{color:#8A7455;font-size: calc(19rpx * var(--fs-scale, 1));font-weight:600;margin-bottom:2rpx}
.fruit-cat-label{flex:1;min-width:0;font-size: calc(32rpx * var(--fs-scale, 1));font-weight:600;color:#3A3226;line-height:1.4;text-align:center;writing-mode:vertical-rl;letter-spacing:2rpx;align-self:center}
.fruit-cat.is-open .fruit-cat-label::after{content:'';display:block;width:12rpx;height:12rpx;border-radius:50%;background:#B96D50;margin:12rpx auto 0}
.fruit-fav{font-size: calc(28rpx * var(--fs-scale, 1));line-height:1;color:#7A7062;padding:6rpx 2rpx}
.fruit-fav.is-fav{color:#B96D50}
.fruit-cat-body{flex:0 1 0;width:0;min-width:0;padding:0;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;opacity:0;transition:opacity .32s ease .16s;background:#FFFDF8;border-radius:0 10rpx 10rpx 0;box-shadow:inset 0 0 0 1rpx rgba(140,104,58,.12)}
.fruit-cat.is-open .fruit-cat-body{flex:1 1 auto;width:auto;padding:24rpx 22rpx;opacity:1}
.fruit-cat-preview{font-size: calc(23rpx * var(--fs-scale, 1));line-height:1.75;color:#3F4A3F;display:-webkit-box;-webkit-line-clamp:9;-webkit-box-orient:vertical;overflow:hidden}
.fruit-cat-more{margin-top:18rpx;font-size: calc(23rpx * var(--fs-scale, 1));font-weight:600;color:#47634B}
.back-button{margin-top:24rpx}
