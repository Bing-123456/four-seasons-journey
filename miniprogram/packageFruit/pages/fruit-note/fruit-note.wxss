.note-page{padding-bottom:calc(64rpx + env(safe-area-inset-bottom))}
.note-head{padding:22rpx 0 26rpx;border-bottom: 1rpx solid #DCE5D0}
.note-kicker{font-size: calc(21rpx * var(--fs-scale, 1));color: #826B4B;letter-spacing:2rpx;line-height:1.7}
.note-name{font-size: calc(52rpx * var(--fs-scale, 1));line-height:1.4;color: #234B3C;margin-top:14rpx}
.note-body{padding:28rpx 0 6rpx}
.note-lead{font-size: calc(28rpx * var(--fs-scale, 1));color: #2E4A38;line-height:1.9;font-weight:600}
.note-detail{font-size: calc(26rpx * var(--fs-scale, 1));color: #47634B;line-height:2;margin-top:24rpx;white-space:pre-wrap}
.note-learn-link{display:block;margin-top:22rpx;background: #234B3C;color: #87917B;font-size: calc(26rpx * var(--fs-scale, 1));line-height:1.6;padding:21rpx 24rpx;border-radius: 18rpx;text-align:center}
.read-card{background: #FFFDF8;border-radius: 28rpx;padding:26rpx;margin-top:28rpx;box-shadow: 0 4rpx 20rpx rgba(29,37,32,.06)}
.read-head{display:flex;gap:18rpx;align-items:center;margin-bottom:18rpx}
.read-face{width:64rpx;height:64rpx;border-radius:50%;background: #EAF0E0;overflow:hidden;flex-shrink:0}
.read-copy{flex:1;min-width:0}
.read-title{font-size: calc(28rpx * var(--fs-scale, 1));color: #2E4A38;line-height:1.5}
.read-hint{font-size: calc(21rpx * var(--fs-scale, 1));line-height:1.7;margin-top:4rpx;color: #47634B}
.dialect-row{display:flex;flex-wrap:wrap;gap:10rpx;margin:20rpx 0}
.dialect-chip{font-size: calc(23rpx * var(--fs-scale, 1));line-height:1.5;color: #47634B;background: #EBEEE5;border-radius:10rpx;padding:12rpx 18rpx}
.dialect-chip.on{background: #234B3C;color: #87917B}
.read-card .read-button{width:100%;margin:0;padding:20rpx 24rpx;font-size: calc(26rpx * var(--fs-scale, 1))}
.note-foot-row{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;margin-top:28rpx;padding-top:24rpx;border-top: 1rpx solid #E1E5D9}
.note-fav{flex-shrink:0;font-size: calc(23rpx * var(--fs-scale, 1));color: #47634B;background: #EAF0E0;border-radius:12rpx;line-height:1.5;padding:14rpx 20rpx}
.note-fav.is-fav{color: #B96D50;background: #F0ECDE}
.note-verify{font-size: calc(21rpx * var(--fs-scale, 1));max-width:340rpx;text-align:right;line-height:1.8;color: #87917B}
.empty{padding:60rpx 30rpx}

.note-sources { margin-top: 32rpx; padding-top: 22rpx; border-top: 1rpx solid #E1E5D9; font-size: calc(21rpx * var(--fs-scale, 1)); line-height: 1.7; }
.note-source { color: #47634B; margin-top: 10rpx; }

.note-editorial { font-size: calc(21rpx * var(--fs-scale, 1)); line-height: 1.7; margin-top: 24rpx; }
