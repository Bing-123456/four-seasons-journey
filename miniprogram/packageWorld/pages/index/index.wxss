.world-page{padding:32rpx 36rpx calc(70rpx + env(safe-area-inset-bottom));background:#F7F5ED;min-height:100vh;box-sizing:border-box}
.world-kicker{font-size:21rpx;letter-spacing:3rpx;color:#987B56;margin-top:12rpx}
.world-page .page-title{font-size:46rpx;color:#234B3C;line-height:1.45;margin:18rpx 0 20rpx;letter-spacing:1rpx}
.world-page .intro{font-size:25rpx;color:#64735B;line-height:1.85}
.world-page .scope-note{font-size:21rpx;color:#8E846E;line-height:1.8;margin:18rpx 0 30rpx;padding-left:17rpx;border-left:3rpx solid #BAA47C}
.site-card{background:#FFFDF8;border-radius:24rpx;overflow:hidden;margin-bottom:28rpx;box-shadow:0 6rpx 24rpx rgba(35,75,60,.035)}
.site-photo-wrap{position:relative;height:320rpx;background:#E7E9DC}
.site-photo{width:100%;height:100%}
.site-continent{position:absolute;left:22rpx;top:22rpx;background:rgba(35,75,60,.88);color:#FFFCF3;font-size:20rpx;line-height:1.5;padding:9rpx 15rpx;border-radius:8rpx;letter-spacing:1rpx}
.site-body{padding:26rpx 28rpx 28rpx}
.site-country{font-size:20rpx;color:#9C805B;letter-spacing:2rpx;line-height:1.8}
.site-name{font-size:35rpx;line-height:1.5;color:#2E4A38;margin:8rpx 0 6rpx}
.site-name-en{font-family:Georgia,serif;font-size:22rpx;color:#87917B;font-style:italic;line-height:1.7}
.site-theme{font-size:22rpx;color:#778566;margin-top:14rpx;line-height:1.8}
.site-toggle{font-size:23rpx;color:#4F6B45;margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid #E6E9DC;line-height:1.6}
.site-description{font-size:25rpx;color:#4A5C44;line-height:1.9;margin:24rpx 0 18rpx}
.subheading{font-size:23rpx;color:#53644C;margin:26rpx 0 14rpx;letter-spacing:2rpx;line-height:1.6}
.site-fact{display:flex;gap:14rpx;font-size:24rpx;color:#647359;line-height:1.9;margin-bottom:14rpx}
.fact-dot{color:#AC875A;flex-shrink:0}
.site-source{font-size:22rpx;color:#63795D;line-height:1.8;padding:14rpx 0;border-bottom:1rpx solid #E6E9DE}
.site-source text{display:block;color:#A08A66;font-size:20rpx;margin-top:5rpx}
.site-credit{font-size:20rpx;color:#909682;margin-top:20rpx;line-height:1.8}
.world-end{display:flex;align-items:center;gap:18rpx;margin:36rpx 0 28rpx;color:#939D87;font-size:23rpx;line-height:1.8;text-align:center}
.world-end text{max-width:78%}
.world-end view{height:1rpx;background:#DDE2D1;flex:1}
.world-page .button{width:100%;margin:0;font-size:26rpx;border-radius:16rpx;line-height:1.6;padding:22rpx 24rpx}
