# Copy to .env at project root. Never put API keys in miniprogram files.
# Default is offline. Enable cloud mode only after setting your own key.
MODEL_PROVIDER=disabled
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
OPENAI_API_KEY=
MODEL_TIMEOUT_MS=30000

HOST=127.0.0.1
PORT=8787
MAX_BODY_BYTES=16384
MAX_CONCURRENT=2
REQUESTS_PER_MINUTE=30

# Required (24+ characters) when HOST exposes this service to other devices.
# Send as Authorization: Bearer <API_TOKEN>. This is separate from the model key.
API_TOKEN=

# —— 照片生成（可选，水果伙伴拍照定制）——
# 阿里云百炼 https://bailian.console.aliyun.com/ 开通后创建 API-KEY
# wanx2.1-imageedit 新用户免费 500 张
IMAGE_PROVIDER=dashscope
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# 识果独立于文字 AI 开关；默认复用 DASHSCOPE_API_KEY。
# VISION_API_KEY=
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_MODEL_NAME=qwen-vl-plus
# VISION_TIMEOUT_MS=30000

# Optional persistent paths; the existing VPS release script sets these under shared/.
# BOOKING_DATA_FILE=/opt/guayouji/shared/bookings.json
# ARTIFACT_DIR=/opt/guayouji/shared/artifacts
# Speech reuses DASHSCOPE_API_KEY by default; optional independent speech key.
# SPEECH_API_KEY=
# SPEECH_SOCKET_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference

# 语音输入（/api/asr，qwen3-asr-flash）：果灵搜索的麦克风提问。
# 与朗读共用同一个 DashScope key；留空则接口返回 503 asr_disabled，小程序提示改用键盘。
# ASR_API_KEY=
# ASR_MODEL_NAME=qwen3-asr-flash
# ASR_TIMEOUT_MS=30000
